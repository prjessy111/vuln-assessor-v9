<%- include('../_header', { title: t('notifications.title'), activeMenu: 'notifications' }) %>

<div class="page-header">
  <h1><%= t('notifications.title') %></h1>
  <p class="muted small">
    <%- t('notifications.desc') %>
  </p>
  <div class="header-actions">
    <button class="btn primary" onclick="testNotify()"><%= t('notifications.testBtn') %></button>
  </div>
</div>

<!-- KPI -->
<div class="kpi-grid kpi-5col">
  <div class="kpi-card">
    <div class="kpi-label"><%= t('notifications.kpi.total') %></div>
    <div class="kpi-num"><%= kpi.total %></div>
    <div class="kpi-sub"><%= t('notifications.kpi.keep500') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label"><%= t('notifications.kpi.last24h') %></div>
    <div class="kpi-num"><%= kpi.last24h %></div>
    <div class="kpi-sub"><%= t('notifications.kpi.sendAttempt') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label"><%= t('notifications.kpi.last7d') %></div>
    <div class="kpi-num"><%= kpi.last7d %></div>
    <div class="kpi-sub"><%= t('notifications.kpi.sendAttempt') %></div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label"><%= t('notifications.kpi.sendFail') %></div>
    <div class="kpi-num" style="color:#c0392b;"><%= kpi.failures %></div>
    <div class="kpi-sub"><%= t('notifications.kpi.partialFail') %></div>
  </div>
  <div class="kpi-card" style="border-top-color:#c0392b;">
    <div class="kpi-label">Error</div>
    <div class="kpi-num" style="color:#c0392b;"><%= kpi.by_severity.error || 0 %></div>
    <div class="kpi-sub"><%= t('notifications.kpi.urgent') %></div>
  </div>
</div>

<!-- 채널 설정 -->
<div class="section-box">
  <h3><%= t('notifications.ch.title') %></h3>
  <table class="data-table" style="max-width:700px;">
    <tr>
      <th style="width:200px;"><%= t('notifications.ch.active') %></th>
      <td>
        <code><%= channel || 'console' %></code>
        <span class="muted small"> — <code>NOTIFIER_CHANNELS</code> <%= t('notifications.ch.changeHint') %></span>
      </td>
    </tr>
    <tr>
      <th><%= t('notifications.ch.email') %></th>
      <td>
        <% if (config.smtp_configured) { %>
          <span style="color:#27ae60;">● <%= t('notifications.ch.configured') %></span>
        <% } else { %>
          <span class="muted"><%= t('notifications.ch.notConfigured') %> — <code>SMTP_HOST</code>, <code>SMTP_TO</code> <%= t('notifications.ch.required') %> (+ <code>npm i nodemailer</code>)</span>
        <% } %>
      </td>
    </tr>
    <tr>
      <th>Slack Webhook</th>
      <td>
        <% if (config.slack_configured) { %>
          <span style="color:#27ae60;">● <%= t('notifications.ch.configured') %></span>
        <% } else { %>
          <span class="muted"><%= t('notifications.ch.notConfigured') %> — <code>SLACK_WEBHOOK_URL</code> <%= t('notifications.ch.envRequired') %></span>
        <% } %>
      </td>
    </tr>
  </table>
</div>

<!-- 알림 이력 -->
<div class="section-box">
  <h3><%= t('notifications.hist.title', { n: notifications.length }) %></h3>
  <% if (!notifications.length) { %>
    <p class="muted"><%= t('notifications.hist.empty') %></p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('notifications.hist.sentAt') %></th>
          <th><%= t('notifications.hist.severity') %></th>
          <th><%= t('notifications.hist.event') %></th>
          <th><%= t('notifications.hist.subject') %></th>
          <th><%= t('notifications.hist.channelResult') %></th>
        </tr>
      </thead>
      <tbody>
        <% notifications.forEach(n => { %>
          <tr>
            <td class="mono small"><%= n.sent_at %></td>
            <td>
              <% var color = n.severity === 'error' ? '#c0392b'
                           : n.severity === 'warning'  ? '#e67e22'
                           : n.severity === 'success'  ? '#27ae60'
                           : '#2c5fb8'; %>
              <% var icon = n.severity === 'error' ? '🚨'
                          : n.severity === 'warning'  ? '⚠'
                          : n.severity === 'success'  ? '✓'
                          : 'ℹ'; %>
              <span style="color:<%= color %>;font-weight:600;"><%= icon %> <%= n.severity %></span>
            </td>
            <td><code class="small"><%= n.event %></code></td>
            <td>
              <strong><%= n.title %></strong>
              <% if (n.body) { %>
                <div class="muted small" style="max-width:500px;">
                  <%= n.body.split('\n')[0].substring(0, 120) %><% if (n.body.length > 120) { %>...<% } %>
                </div>
              <% } %>
            </td>
            <td class="small">
              <% (n.results || []).forEach(r => { %>
                <div>
                  <code><%= r.channel %></code>
                  <% if (r.ok) { %>
                    <span style="color:#27ae60;">✓</span>
                  <% } else { %>
                    <span style="color:#c0392b;">✗</span>
                    <% if (r.error) { %>
                      <span class="muted"><%= (r.error || '').substring(0, 60) %></span>
                    <% } %>
                  <% } %>
                </div>
              <% }) %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
var I18N = <%- JSON.stringify({
  promptSeverity: t('notifications.js.promptSeverity'),
  promptTitle: t('notifications.js.promptTitle'),
  defaultTitle: t('notifications.js.defaultTitle'),
  testBody: t('notifications.js.testBody'),
  sendResult: t('notifications.js.sendResult'),
  failPrefix: t('notifications.js.failPrefix'),
  error: t('notifications.js.error')
}) %>;
function testNotify() {
  const severity = prompt(I18N.promptSeverity, 'info');
  if (!severity) return;
  const title = prompt(I18N.promptTitle, I18N.defaultTitle);
  if (!title) return;
  fetch('/notifications/test', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ severity, title, body: I18N.testBody }),
  })
    .then(r => r.json())
    .then(j => {
      if (j.status === 'success') {
        const summary = (j.results || []).map(r => r.channel + ' ' + (r.ok ? '✓' : '✗')).join(', ');
        alert(I18N.sendResult + summary);
        location.reload();
      } else {
        alert(I18N.failPrefix + (j.error || I18N.error));
      }
    });
}
</script>

<%- include('../_footer') %>
