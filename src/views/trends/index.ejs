<%- include('../_header', { title: t('trends.pageTitle'), activeMenu: 'trends' }) %>

<style>
  .tr-bars { display:flex; align-items:flex-end; gap:10px; height:180px; padding:10px 4px; border:1px solid #e1e5ea; border-radius:8px; overflow-x:auto; background:#fff; }
  .tr-col { display:flex; flex-direction:column; align-items:center; min-width:54px; }
  .tr-stack { display:flex; flex-direction:column-reverse; width:30px; height:150px; justify-content:flex-start; }
  .tr-seg { width:100%; }
  .tr-seg.vuln { background:#e74c3c; } .tr-seg.safe { background:#27ae60; } .tr-seg.na { background:#bdc3c7; }
  .tr-x { font-size:10px; color:#666; margin-top:4px; text-align:center; white-space:nowrap; }
  .tr-rate { font-size:11px; font-weight:700; color:#0b5fff; }
  .tr-legend span { font-size:12px; margin-right:14px; }
  .dot { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:4px; vertical-align:middle; }
  table.tr { width:100%; border-collapse:collapse; font-size:13px; }
  table.tr th, table.tr td { border:1px solid #e1e5ea; padding:6px 9px; text-align:left; }
  table.tr th { background:#f1f5fb; }
  .added { color:#c0392b; font-weight:700; } .resolved { color:#27ae60; font-weight:700; }
</style>

<div class="page-header">
  <h1><%= t('trends.heading') %></h1>
  <p class="muted small"><%= t('trends.desc') %></p>
</div>

<div class="section-box">
  <form method="get" style="margin-bottom:10px;">
    <label><%= t('trends.host') %></label>
    <select name="host" onchange="this.form.submit()">
      <option value=""><%= t('trends.all') %></option>
      <% (hosts || []).forEach(h => { %>
        <option value="<%= h %>" <%= host === h ? 'selected' : '' %>><%= h %></option>
      <% }) %>
    </select>
  </form>

  <h3><%= t('trends.s1.title') %></h3>
  <div class="tr-legend" style="margin:6px 0;">
    <span><i class="dot" style="background:#e74c3c;"></i><%= t('trends.s1.vuln') %></span>
    <span><i class="dot" style="background:#27ae60;"></i><%= t('trends.s1.safe') %></span>
    <span><i class="dot" style="background:#bdc3c7;"></i><%= t('trends.s1.na') %></span>
    <span><i class="dot" style="background:#0b5fff;"></i><%= t('trends.s1.agreement') %></span>
  </div>
  <% if (!series || !series.length) { %>
    <p class="muted"><%= t('trends.s1.empty') %></p>
  <% } else {
       var maxTotal = Math.max.apply(null, series.map(function(s){return s.total||1;})); %>
    <div class="tr-bars">
      <% series.slice(-20).forEach(function(s){
           var h = function(n){ return Math.round((n / maxTotal) * 150); }; %>
        <div class="tr-col" title="<%= t('trends.s1.barTip', { id: s.assessment_id, host: s.hostname, source: s.source, vuln: s.vuln, safe: s.safe, na: s.na }) %>">
          <div class="tr-rate"><%= s.agreement_rate != null ? s.agreement_rate + '%' : '-' %></div>
          <div class="tr-stack">
            <div class="tr-seg vuln" style="height:<%= h(s.vuln) %>px;"></div>
            <div class="tr-seg safe" style="height:<%= h(s.safe) %>px;"></div>
            <div class="tr-seg na"   style="height:<%= h(s.na) %>px;"></div>
          </div>
          <div class="tr-x"><%= (s.date || '').slice(5) %><br><%= s.hostname %></div>
        </div>
      <% }) %>
    </div>
    <p class="muted small"><%= t('trends.s1.footnote', { n: Math.min(series.length, 20) }) %></p>
  <% } %>
</div>

<div class="section-box">
  <h3><%= t('trends.s2.title') %></h3>
  <% if (!diff) { %>
    <p class="muted"><%= t('trends.s2.empty') %></p>
  <% } else { %>
    <p class="small">
      <b><%= diff.hostname %></b> · <%= diff.source %> &nbsp;|&nbsp;
      <%= t('trends.s2.prev') %> <code>#<%= diff.prev_id %></code> (<%= diff.prev_date %>) → <%= t('trends.s2.cur') %> <code>#<%= diff.cur_id %></code> (<%= diff.cur_date %>)
    </p>
    <div style="display:flex; gap:16px; flex-wrap:wrap;">
      <div style="flex:1 1 320px;">
        <h4 class="added"><%= t('trends.s2.added', { n: diff.added.length }) %></h4>
        <% if (!diff.added.length) { %><p class="muted small"><%= t('trends.s2.none') %></p><% } else { %>
          <table class="tr"><tr><th><%= t('trends.s2.chkItem') %></th><th><%= t('trends.s2.prev') %></th></tr>
          <% diff.added.forEach(function(a){ %><tr><td class="mono"><%= a.chk_id %></td><td><%= td(a.was) %></td></tr><% }) %>
          </table>
        <% } %>
      </div>
      <div style="flex:1 1 320px;">
        <h4 class="resolved"><%= t('trends.s2.resolved', { n: diff.resolved.length }) %></h4>
        <% if (!diff.resolved.length) { %><p class="muted small"><%= t('trends.s2.none') %></p><% } else { %>
          <table class="tr"><tr><th><%= t('trends.s2.chkItem') %></th><th><%= t('trends.s2.cur') %></th></tr>
          <% diff.resolved.forEach(function(r){ %><tr><td class="mono"><%= r.chk_id %></td><td><%= td(r.now) %></td></tr><% }) %>
          </table>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<%- include('../_footer') %>
