  <ol style="line-height:2.1;margin:6px 0;">
    <li><b><%= t('help.quick.s1t') %></b> — <%= t('help.quick.s1') %></li>
    <li><b><%= t('help.quick.s2t') %></b> — <%= t('help.quick.s2') %></li>
    <li><b><%= t('help.quick.s3t') %></b> — <%= t('help.quick.s3') %></li>
