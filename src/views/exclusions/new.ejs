<%- include('../_header', { title: t('exclusions.new.title'), activeMenu: 'exclusions' }) %>

<div class="page-header">
  <h1><%= t('exclusions.new.title') %></h1>
  <p class="muted small">
    <%- t('exclusions.new.descHtml') %>
  </p>
  <div class="header-actions">
    <a href="/exclusions" class="btn"><%= t('exclusions.new.back') %></a>
  </div>
</div>

<form id="exclusionForm" class="form-container">
  <div class="form-section">
    <h3><%= t('exclusions.new.target.heading') %></h3>
    <div class="form-row inline">
      <label><%= t('exclusions.new.target.itemLabel') %> *</label>
      <select name="rule_id" required>
        <option value=""><%= t('exclusions.new.target.itemSelect') %></option>
        <% (checkItems || []).forEach(ci => { %>
          <option value="<%= ci.srv %>" <%= prefill && prefill.rule_id === ci.srv ? 'selected' : '' %>>
            <%= ci.srv %> · <%= ci.title %>
          </option>
        <% }) %>
      </select>
    </div>
    <div class="form-row inline"><label><%= t('exclusions.new.target.hostLabel') %></label>
      <input type="text" name="hostname" placeholder="<%= t('exclusions.new.target.hostPh') %>"></div>
    <div class="form-row inline"><label><%= t('exclusions.new.target.acctLabel') %></label>
      <input type="text" name="username" placeholder="<%= t('exclusions.new.target.acctPh') %>"
             value="<%= (prefill && prefill.username) || '' %>"></div>
    <div class="form-row">
      <label><%= t('exclusions.new.target.csvLabel') %></label>
      <textarea name="targets_csv" rows="4" placeholder="<%= t('exclusions.new.target.csvPh') %>"></textarea>
      <span class="muted small"><%= t('exclusions.new.target.csvHelp') %></span>
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('exclusions.new.reason.heading') %></h3>
    <div class="form-row inline">
      <label><%= t('exclusions.new.reason.typeLabel') %> *</label>
      <select name="reason_type" required>
        <option value=""><%= t('exclusions.new.reason.select') %></option>
        <option value="구조적 미해당"><%= t('exclusions.new.reason.structural') %></option>
        <option value="OS 미지원"><%= t('exclusions.new.reason.osUnsupported') %></option>
        <option value="정책상 미사용"><%= t('exclusions.new.reason.policyUnused') %></option>
        <option value="중복 점검"><%= t('exclusions.new.reason.duplicate') %></option>
        <option value="False Positive"><%= t('exclusions.new.reason.falsePositive') %></option>
        <option value="기타"><%= t('exclusions.new.reason.etc') %></option>
      </select>
    </div>
    <div class="form-row">
      <label><%= t('exclusions.new.reason.detailLabel') %> *</label>
      <textarea name="reason" required rows="5"
                placeholder="<%= t('exclusions.new.reason.detailPh') %>"></textarea>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn primary"><%= t('exclusions.new.submit') %></button>
    <a href="/exclusions" class="btn"><%= t('common.btn.cancel') %></a>
  </div>
</form>

<script>
var I18N = <%- JSON.stringify({
  alertNeedItem: t('exclusions.new.js.alertNeedItem'),
  alertCsv: t('exclusions.new.js.alertCsv'),
  savedAlert: t('exclusions.new.js.savedAlert'),
  countSuffix: t('exclusions.new.js.countSuffix'),
  fail: t('exclusions.new.js.fail'),
  error: t('exclusions.new.js.error')
}) %>;

document.getElementById('exclusionForm').onsubmit = async (e) => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));
  if (!data.rule_id) { alert(I18N.alertNeedItem); return; }

  // CSV 일괄: "호스트명,계정명" 한 줄에 하나 → targets 배열
  if (data.targets_csv && data.targets_csv.trim()) {
    data.targets = data.targets_csv.trim().split(/\r?\n/).map(function(line){
      var p = line.split(',');
      return { hostname: (p[0]||'').trim(), username: (p[1]||'').trim() };
    }).filter(function(t2){ return t2.hostname || t2.username; });
    if (!data.targets.length) { alert(I18N.alertCsv); return; }
  }
  delete data.targets_csv;

  const res = await fetch('/exclusions/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.savedAlert + (j.count > 1 ? I18N.countSuffix.replace('{n}', j.count) : ''));
    location.href = '/exclusions';
  } else {
    alert(I18N.fail + (j.error || I18N.error));
  }
};
</script>

<%- include('../_footer') %>
