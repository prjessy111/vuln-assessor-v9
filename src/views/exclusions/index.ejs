<%- include('../_header', { title: t('exclusions.index.title'), activeMenu: 'exclusions' }) %>

<div class="page-header">
  <h1><%= t('exclusions.index.title') %></h1>
  <p class="muted small">
    <%- t('exclusions.index.descHtml') %>
  </p>
  <div class="header-actions">
    <a href="/exclusions/new" class="btn primary"><%= t('exclusions.index.btnNew') %></a>
  </div>
</div>

<!-- KPI -->
<div class="kpi-grid kpi-4col">
  <div class="kpi-card">
    <div class="kpi-label"><%= t('exclusions.index.kpi.total') %></div>
    <div class="kpi-num"><%= kpi.total %></div>
    <div class="kpi-sub"><%= t('exclusions.index.kpi.totalSub') %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('exclusions.index.kpi.active') %></div>
    <div class="kpi-num" style="color:#27ae60;"><%= kpi.active %></div>
    <div class="kpi-sub"><%= t('exclusions.index.kpi.activeSub') %></div>
  </div>
  <div class="kpi-card kpi-avg">
    <div class="kpi-label"><%= t('exclusions.index.kpi.server') %></div>
    <div class="kpi-num"><%= (kpi.by_target_type && kpi.by_target_type.server) || 0 %></div>
    <div class="kpi-sub"><%= t('exclusions.index.kpi.serverSub') %></div>
  </div>
  <div class="kpi-card kpi-avg">
    <div class="kpi-label"><%= t('exclusions.index.kpi.rule') %></div>
    <div class="kpi-num"><%= (kpi.by_target_type && kpi.by_target_type.rule) || 0 %></div>
    <div class="kpi-sub"><%= t('exclusions.index.kpi.ruleSub') %></div>
  </div>
</div>

<!-- 필터 -->
<div class="section-box">
  <div class="filter-bar">
    <input type="text" id="searchInput" placeholder="<%= t('exclusions.index.searchPh') %>" class="filter-input">
    <select id="typeFilter" class="filter-select">
      <option value=""><%= t('exclusions.index.filter.allTypes') %></option>
      <option value="server"><%= t('exclusions.index.filter.server') %></option>
      <option value="rule"><%= t('exclusions.index.filter.rule') %></option>
      <option value="combo"><%= t('exclusions.index.filter.combo') %></option>
    </select>
    <select id="enabledFilter" class="filter-select">
      <option value=""><%= t('exclusions.index.filter.allStatus') %></option>
      <option value="1"><%= t('exclusions.index.filter.enabled') %></option>
      <option value="0"><%= t('exclusions.index.filter.disabled') %></option>
    </select>
  </div>
</div>

<!-- 제외 목록 -->
<div class="section-box">
  <h3><%= t('exclusions.index.listTitle', { n: exclusions.length }) %></h3>
  <% if (!exclusions.length) { %>
    <p class="muted"><%= t('exclusions.index.empty') %> <a href="/exclusions/new"><%= t('exclusions.index.emptyLink') %></a>.</p>
  <% } else { %>
    <table class="data-table" id="exclusionsTable">
      <thead>
        <tr>
          <th><%= t('exclusions.index.th.enabled') %></th>
          <th><%= t('exclusions.index.th.id') %></th>
          <th><%= t('exclusions.index.th.type') %></th>
          <th><%= t('exclusions.index.th.rule') %></th>
          <th><%= t('exclusions.index.th.server') %></th>
          <th><%= t('exclusions.index.th.reason') %></th>
          <th><%= t('exclusions.index.th.registeredBy') %></th>
          <th><%= t('exclusions.index.th.registeredAt') %></th>
          <th><%= t('exclusions.index.th.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% exclusions.forEach(e => { %>
          <tr data-type="<%= e.target_type || '' %>"
              data-enabled="<%= e.enabled ? '1' : '0' %>"
              data-search="<%= ((e.rule_id || '') + ' ' + (e.hostname || '') + ' ' + (e.reason || '') + ' ' + (e.registered_by || '')).toLowerCase() %>">
            <td>
              <% if (e.enabled) { %>
                <span style="color:#27ae60;font-weight:600;">●</span>
              <% } else { %>
                <span style="color:#bbb;">○</span>
              <% } %>
            </td>
            <td>#<%= e.exclusion_id %></td>
            <td>
              <% var tt = e.target_type || 'unknown'; %>
              <% var label = { server: t('exclusions.index.type.server'), rule: t('exclusions.index.type.rule'), combo: t('exclusions.index.type.combo') }[tt] || tt; %>
              <span class="status-badge"><%= label %></span>
            </td>
            <td><strong><%= e.rule_id || '-' %></strong></td>
            <td class="small">
              <% if (e.hostname) { %>
                <%= e.hostname %>
              <% } else if (e.server_id) { %>
                #<%= e.server_id %>
              <% } else { %>
                <span class="muted"><%= t('exclusions.index.allServers') %></span>
              <% } %>
            </td>
            <td class="small" style="max-width:320px;">
              <%= (e.reason || '').substring(0, 150) %><% if ((e.reason || '').length > 150) { %>...<% } %>
            </td>
            <td class="small"><%= e.registered_by || '-' %></td>
            <td class="small"><%= (e.registered_at || '').slice(0, 10) %></td>
            <td>
              <button class="btn-sm" onclick="toggleExclusion(<%= e.exclusion_id %>)">
                <%= e.enabled ? t('exclusions.index.btnDisable') : t('exclusions.index.btnEnable') %>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<style>
  .status-badge {
    display:inline-block; padding:2px 8px; border-radius:3px;
    background:#e8f0fe; color:#2c5fb8; font-size:0.85rem; font-weight:600;
  }
</style>

<script>
var I18N = <%- JSON.stringify({
  confirmToggle: t('exclusions.index.js.confirmToggle'),
  fail: t('exclusions.index.js.fail'),
  error: t('exclusions.index.js.error')
}) %>;

function toggleExclusion(id) {
  if (!confirm(I18N.confirmToggle)) return;
  fetch('/exclusions/' + id + '/toggle', { method: 'POST' })
    .then(r => r.json())
    .then(j => {
      if (j.status === 'success') location.reload();
      else alert(I18N.fail + (j.error || I18N.error));
    });
}

function applyFilters() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const t = document.getElementById('typeFilter').value;
  const en = document.getElementById('enabledFilter').value;
  document.querySelectorAll('#exclusionsTable tbody tr').forEach(tr => {
    const matchQ = !q || (tr.dataset.search || '').toLowerCase().includes(q);
    const matchT = !t || tr.dataset.type === t;
    const matchE = en === '' || tr.dataset.enabled === en;
    tr.style.display = (matchQ && matchT && matchE) ? '' : 'none';
  });
}
['searchInput', 'typeFilter', 'enabledFilter'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener(id === 'searchInput' ? 'input' : 'change', applyFilters);
});
</script>

<%- include('../_footer') %>
