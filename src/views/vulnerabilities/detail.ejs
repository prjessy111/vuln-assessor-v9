<%- include('../_header', { title: t('vuln.detail.title'), activeMenu: 'vuln' }) %>

<div class="page-header">
  <h1>
    <a href="/vulnerabilities" class="back-link"><%= t('vuln.detail.back') %></a>
    <%= vuln.management_no %> - <%= vuln.title %>
  </h1>
  <div class="header-actions">
    <a href="/remediation/<%= vuln.result_id %>" class="btn primary"><%= t('vuln.detail.startRemediation') %></a>
  </div>
</div>

<div class="detail-grid">
  <!-- 기본 정보 -->
  <div class="detail-section">
    <h3><%= t('vuln.detail.basicInfo') %></h3>
    <table class="kv-table">
      <tr><th><%= t('vuln.detail.mgmtNo') %></th><td class="mono"><%= vuln.management_no %></td></tr>
      <tr><th><%= t('vuln.detail.ruleId') %></th><td class="mono"><%= vuln.rule_id %></td></tr>
      <tr><th><%= t('vuln.detail.server') %></th><td><%= vuln.hostname %> (<%= vuln.asset_no %>)</td></tr>
      <tr><th><%= t('vuln.detail.service') %></th><td><%= vuln.service_name %></td></tr>
      <tr><th><%= t('vuln.detail.category') %></th><td><%= vuln.category %></td></tr>
      <tr><th><%= t('vuln.detail.severity') %></th><td><span class="sev sev-<%= vuln.severity %>"><%= td(vuln.severity) %></span></td></tr>
      <tr><th><%= t('vuln.detail.discovered') %></th><td class="mono"><%= vuln.discovered_at %></td></tr>
      <tr><th><%= t('vuln.detail.isNew') %></th><td>
        <% if (vuln.is_new) { %><span class="newflag newflag-new"><%= td('신규') %></span><% }
           else { %><span class="newflag newflag-old"><%= t('vuln.detail.existingDaysAgo', { n: vuln.days_old }) %></span><% } %>
      </td></tr>
    </table>
  </div>

  <!-- 진단 결과 -->
  <div class="detail-section">
    <h3><%= t('vuln.detail.diagResult') %></h3>
    <div class="vuln-result-block">
      <div class="vr-status">
        <span class="badge b-vuln"><%= td('취약') %></span>
        <span class="muted"><%= t('vuln.detail.evalLabel') %> <%= vuln.eval_method === 'simple' ? 'SQL' : 'AI' %></span>
      </div>
      <div class="vr-reason">
        <strong><%= t('vuln.detail.reasonLabel') %></strong> <%= vuln.reason %>
      </div>
      <div class="vr-evidence">
        <strong><%= t('vuln.detail.evidenceLabel') %></strong> <code><%= vuln.evidence %></code>
      </div>
    </div>

    <% if (vuln.subs && vuln.subs.length) { %>
      <h4><%= t('vuln.detail.subsHeading', { n: vuln.subs.length }) %></h4>
      <table class="data-table mini">
        <thead><tr><th><%= t('vuln.detail.subTh.key') %></th><th><%= t('vuln.detail.subTh.label') %></th><th><%= t('vuln.detail.subTh.status') %></th><th><%= t('vuln.detail.subTh.reason') %></th></tr></thead>
        <tbody>
          <% vuln.subs.forEach(s => { %>
            <tr>
              <td class="mono small"><%= s.sub_key %></td>
              <td><%= s.sub_label %></td>
              <td><span class="badge b-<%= s.status === '취약' ? 'vuln' : 'safe' %>"><%= td(s.status) %></span></td>
              <td class="small"><%= s.reason %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<!-- 룰 정보 -->
<div class="section-box">
  <h3><%= t('vuln.detail.ruleDef') %></h3>
  <div class="rule-info-grid">
    <div>
      <h4><%= t('vuln.detail.description') %></h4>
      <p><%= vuln.description %></p>
    </div>
    <div>
      <h4><%= t('vuln.detail.checkMethod') %></h4>
      <pre class="mono small"><%= vuln.check_method %></pre>
    </div>
    <div>
      <h4><%= t('vuln.detail.checkCriteria') %></h4>
      <pre class="mono small"><%= vuln.check_criteria %></pre>
    </div>
    <div>
      <h4><%= t('vuln.detail.recommend') %></h4>
      <pre class="mono small"><%= vuln.recommend %></pre>
    </div>
  </div>
</div>

<!-- CVE 정보 (핵심) -->
<div class="section-box">
  <h3><%= t('vuln.detail.cve.heading') %></h3>
  <p class="muted small"><%= t('vuln.detail.cve.desc') %></p>

  <% vuln.cves.forEach(c => { %>
    <div class="cve-card cvss-<%= c.severity_class %>">
      <div class="cve-header">
        <span class="cve-id-large">
          <a href="https://nvd.nist.gov/vuln/detail/<%= c.id %>" target="_blank"><%= c.id %></a>
        </span>
        <span class="cvss-badge cvss-<%= c.severity_class %>">
          CVSS <%= c.cvss %> · <%= c.severity_label %>
        </span>
        <span class="cve-source">
          <% if (c.source === 'rule') { %><%= t('vuln.detail.cve.srcRule') %>
          <% } else if (c.source === 'nvd') { %><%= t('vuln.detail.cve.srcNvd') %>
          <% } else if (c.source === 'ai') { %><%= t('vuln.detail.cve.srcAi', { n: c.confidence }) %>
          <% } %>
        </span>
      </div>

      <div class="cve-title"><strong><%= c.title %></strong></div>
      <div class="cve-desc"><%= c.description %></div>

      <div class="cve-meta-grid">
        <div>
          <strong><%= t('vuln.detail.cve.affectedPackage') %></strong>
          <code><%= c.affected_package %></code>
        </div>
        <div>
          <strong><%= t('vuln.detail.cve.detectedVersion') %></strong>
          <code><%= c.detected_version %></code>
          <% if (c.is_affected) { %>
            <span class="b-vuln"><%= t('vuln.detail.cve.affected') %></span>
          <% } else { %>
            <span class="b-safe"><%= t('vuln.detail.cve.patched') %></span>
          <% } %>
        </div>
        <div>
          <strong><%= t('vuln.detail.cve.publishedDate') %></strong> <%= c.published_date %>
        </div>
        <div>
          <strong><%= t('vuln.detail.cve.patchInfo') %></strong>
          <% if (c.patch_available) { %>
            <a href="<%= c.patch_url %>" target="_blank"><%= t('vuln.detail.cve.patchProvided') %></a> (<%= c.patch_version %>)
          <% } else { %>
            <span class="muted"><%= t('vuln.detail.cve.patchNone') %></span>
          <% } %>
        </div>
      </div>

      <% if (c.attack_vector) { %>
        <div class="cve-attack">
          <strong><%= t('vuln.detail.cve.attackVector') %></strong>
          <span class="av-badge av-<%= c.attack_vector.toLowerCase() %>"><%= c.attack_vector %></span>
          <span class="muted small"><%= t('vuln.detail.cve.attackMeta', { priv: c.privileges_required, ui: c.user_interaction }) %></span>
        </div>
      <% } %>

      <% if (c.exploits && c.exploits.length) { %>
        <div class="cve-exploit">
          <strong><%= t('vuln.detail.cve.exploits') %></strong>
          <% c.exploits.forEach(e => { %>
            <a href="<%= e.url %>" target="_blank" class="exploit-link"><%= e.source %></a>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% }); %>

  <% if (!vuln.cves.length) { %>
    <div class="empty-cves">
      <%= t('vuln.detail.cve.emptyCves') %>
      <button class="btn-sm"><%= t('vuln.detail.cve.findWithAi') %></button>
    </div>
  <% } %>
</div>

<%- include('../_footer') %>
