<%- include('../_header', { title: t('remediation.list.title'), activeMenu: 'remediation' }) %>

<div class="page-header">
  <h1><%= t('remediation.list.title') %></h1>
  <p class="muted small">
    <%= t('remediation.list.introLine1') %>
    <%- t('remediation.list.introLine2', { link: '<a href="/vulnerabilities">' + t('common.nav.vuln') + '</a>' }) %>
  </p>
  <div style="margin-top:6px;">
    <a href="/remediation/audit" class="btn-sm primary"><%= t('remediation.list.auditLink') %></a>
    <span class="muted small"><%= t('remediation.list.auditLinkDesc') %></span>
  </div>
</div>

<!-- KPI -->
<div class="kpi-grid kpi-5col">
  <div class="kpi-card kpi-total">
    <div class="kpi-label"><%= t('remediation.list.kpi.total') %></div>
    <div class="kpi-num"><%= stats.total %></div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label"><%= td('미조치') %></div>
    <div class="kpi-num"><%= stats.미조치 %></div>
    <div class="kpi-sub"><%= t('remediation.list.kpi.unresolvedSub') %></div>
  </div>
  <div class="kpi-card kpi-running">
    <div class="kpi-label"><%= td('진행중') %></div>
    <div class="kpi-num"><%= stats.진행중 %></div>
    <div class="kpi-sub"><%= t('remediation.list.kpi.inProgressSub') %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= td('조치완료') %></div>
    <div class="kpi-num"><%= stats.조치완료 %></div>
    <div class="kpi-sub"><%= t('remediation.list.kpi.completionRate', { n: stats.completion_rate }) %></div>
  </div>
  <div class="kpi-card" style="border-top-color:#c0392b;">
    <div class="kpi-label"><%= t('remediation.list.kpi.overdue') %></div>
    <div class="kpi-num" style="color:#c0392b;"><%= stats.overdue %></div>
    <div class="kpi-sub"><%= t('remediation.list.kpi.overdueSub') %></div>
  </div>
</div>

<!-- 필터 -->
<div class="section-box">
  <div class="filter-row">
    <select id="filterServer">
      <option value=""><%= t('remediation.list.filter.allServers') %></option>
      <% servers.forEach(s => { %>
        <option value="<%= s.hostname %>"><%= s.hostname %></option>
      <% }); %>
    </select>
    <select id="filterSeverity">
      <option value=""><%= t('remediation.list.filter.allSeverity') %></option>
      <option value="상"><%= td('상') %></option>
      <option value="중"><%= td('중') %></option>
      <option value="하"><%= td('하') %></option>
    </select>
    <select id="filterStatus">
      <option value=""><%= t('remediation.list.filter.allStatus') %></option>
      <option value="미조치"><%= td('미조치') %></option>
      <option value="진행중"><%= td('진행중') %></option>
      <option value="조치완료"><%= td('조치완료') %></option>
      <option value="예외"><%= td('예외') %></option>
    </select>
    <select id="filterOverdue">
      <option value=""><%= t('remediation.list.filter.allDue') %></option>
      <option value="overdue"><%= t('remediation.list.filter.overdue30') %></option>
      <option value="normal"><%= t('remediation.list.filter.normal30') %></option>
    </select>
    <input type="search" id="filterText" placeholder="<%= t('remediation.list.filter.searchPlaceholder') %>">
    <label class="muted small"><%= t('remediation.list.filter.discoveredDate') %></label>
    <input type="date" id="filterFrom" title="<%= t('remediation.list.filter.fromTitle') %>">
    <span>~</span>
    <input type="date" id="filterTo" title="<%= t('remediation.list.filter.toTitle') %>">
    <button class="btn-sm" onclick="applyFilter()"><%= t('remediation.list.filter.apply') %></button>
    <button class="btn-sm" onclick="resetFilter()"><%= t('remediation.list.filter.reset') %></button>
  </div>
</div>

<!-- 조치 워크플로 (칸반 스타일) -->
<div class="kanban-board">
  <% ['미조치', '진행중', '조치완료', '예외'].forEach(status => {
    const items = byStatus[status] || [];
    const colorClass = status === '미조치' ? 'col-fail'
                     : status === '진행중' ? 'col-running'
                     : status === '조치완료' ? 'col-success'
                     : 'col-exception';
  %>
    <div class="kanban-col <%= colorClass %>" data-status="<%= status %>">
      <div class="kanban-header">
        <h3><%= td(status) %></h3>
        <span class="kanban-count"><%= items.length %></span>
      </div>
      <div class="kanban-body" id="col-<%= status %>">
        <% items.forEach(v => { %>
          <div class="kanban-card sev-<%= v.severity %>"
               data-result-id="<%= v.result_id %>"
               data-hostname="<%= v.hostname %>"
               data-severity="<%= v.severity %>"
               data-status="<%= status %>"
               data-overdue="<%= (v.days_old > 30 && status === '미조치') ? 'overdue' : 'normal' %>"
               data-discovered="<%= (v.discovered_at || '').slice(0,10) %>"
               data-search="<%= (v.title + ' ' + v.rule_id + ' ' + (v.assignee || '') + ' ' + v.hostname + ' ' + (v.service_name || '')).toLowerCase() %>"
               onclick="openModal(<%= JSON.stringify(v).replace(/"/g, '&quot;') %>)">
            <div class="card-header">
              <span class="rule-id-badge"><%= v.rule_id %></span>
              <span class="severity-badge sev-<%= v.severity %>"><%= td(v.severity) %></span>
              <% if (v.is_new) { %><span class="badge-new"><%= td('신규') %></span><% } %>
              <% if (v.days_old > 30 && status === '미조치') { %>
                <span class="badge-overdue" title="<%= t('remediation.list.card.overdueTitle') %>">⚠</span>
              <% } %>
            </div>
            <div class="card-title"><%= v.title %></div>
            <div class="card-meta">
              <div class="meta-line">
                <span class="meta-icon">🖥</span>
                <strong><%= v.hostname %></strong>
                <% if (v.service_name) { %>
                  <span class="muted">(<%= v.service_name %>)</span>
                <% } %>
              </div>
              <% if (v.assignee) { %>
                <div class="meta-line">
                  <span class="meta-icon">👤</span>
                  <%= v.assignee %>
                </div>
              <% } %>
              <% if (v.fixed_at) { %>
                <div class="meta-line muted small">
                  <%= t('remediation.list.card.done') %> <%= v.fixed_at %>
                </div>
              <% } else { %>
                <div class="meta-line muted small">
                  <%= t('remediation.list.card.found', { date: (v.discovered_at || '').slice(0, 10), n: v.days_old }) %>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
        <% if (items.length === 0) { %>
          <div class="kanban-empty"><%= t('remediation.list.kanbanEmpty') %></div>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>


<!-- ═══════════════════════════════════════════════════ -->
<!-- 조치 상세/편집 모달                                    -->
<!-- ═══════════════════════════════════════════════════ -->
<div id="remModal" class="modal" style="display:none;">
  <div class="modal-backdrop" onclick="closeModal()"></div>
  <div class="modal-content" style="max-width: 720px;">
    <div class="modal-header">
      <h3><%= t('remediation.list.modal.heading') %> <span id="modalRuleId"></span></h3>
      <button class="modal-close" onclick="closeModal()">×</button>
    </div>
    <div class="modal-body">
      <!-- 취약점 요약 -->
      <table class="info-table">
        <tr>
          <th><%= t('remediation.list.modal.host') %></th><td id="modalHostname"></td>
          <th><%= t('remediation.list.modal.assetNo') %></th><td id="modalAssetNo"></td>
        </tr>
        <tr>
          <th><%= t('remediation.list.modal.severity') %></th><td id="modalSeverity"></td>
          <th><%= t('remediation.list.modal.discovered') %></th><td id="modalDiscovered"></td>
        </tr>
      </table>

      <div class="vuln-detail-box">
        <div class="detail-label"><%= t('remediation.list.modal.vuln') %></div>
        <div class="detail-text" id="modalTitle"></div>
      </div>

      <div class="vuln-detail-box">
        <div class="detail-label"><%= t('remediation.list.modal.reason') %></div>
        <div class="detail-text" id="modalReason"></div>
      </div>

      <div class="vuln-detail-box" id="evidenceBox">
        <div class="detail-label"><%= t('remediation.list.modal.evidence') %></div>
        <pre class="code-block-small" id="modalEvidence"></pre>
      </div>

      <!-- 조치 입력 -->
      <h4 style="margin-top:20px;"><%= t('remediation.list.modal.remedSection') %></h4>
      <form id="remForm">
        <input type="hidden" id="formResultId">
        <div class="form-row inline">
          <label><%= t('remediation.list.modal.fixStatus') %></label>
          <select id="formFixStatus" name="fix_status">
            <option value="미조치"><%= td('미조치') %></option>
            <option value="진행중"><%= td('진행중') %></option>
            <option value="조치완료"><%= td('조치완료') %></option>
            <option value="예외"><%= t('remediation.list.modal.exceptionRequest') %></option>
          </select>
        </div>
        <div class="form-row inline">
          <label><%= t('remediation.list.modal.assignee') %></label>
          <input type="text" id="formAssignee" name="assignee" placeholder="<%= t('remediation.list.modal.assigneePh') %>">
        </div>
        <div class="form-row inline">
          <label><%= t('remediation.list.modal.fixMethod') %></label>
          <textarea id="formFixMethod" name="fix_method" rows="3"
                    placeholder="<%= t('remediation.list.modal.fixMethodPh') %>"></textarea>
        </div>
        <div class="form-row inline">
          <label><%= t('remediation.list.modal.misnotice') %></label>
          <textarea id="formMisnotice" name="misnotice_reason" rows="2"
                    placeholder="<%= t('remediation.list.modal.misnoticePh') %>"></textarea>
        </div>
        <div class="form-row inline">
          <label><%= t('remediation.list.modal.note') %></label>
          <input type="text" id="formNote" name="note" placeholder="<%= t('remediation.list.modal.notePh') %>">
        </div>
      </form>

      <!-- 조치 증적(Evidence) -->
      <h4 style="margin-top:20px;"><%= t('remediation.list.modal.evidenceSection') %></h4>
      <div id="evidenceList" class="muted small" style="margin-bottom:8px;"><%= t('remediation.list.modal.noEvidence') %></div>
      <div class="form-row inline">
        <label><%= t('remediation.list.modal.attachEvidence') %></label>
        <input type="file" id="evidenceFiles" multiple accept=".png,.jpg,.jpeg,.gif,.bmp,.pdf,.txt,.log,.doc,.docx,.xls,.xlsx,.zip,.csv">
        <button type="button" class="btn-sm primary" onclick="uploadEvidence()"><%= t('remediation.list.modal.upload') %></button>
      </div>
      <p class="muted small"><%= t('remediation.list.modal.evidenceNote') %></p>

      <!-- 조치 이력(audit trail) -->
      <h4 style="margin-top:16px;"><%= t('remediation.list.modal.historySection') %></h4>
      <div id="historyLog" class="muted small"><%= t('remediation.list.modal.noHistory') %></div>
    </div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModal()"><%= t('common.btn.cancel') %></button>
      <button class="btn primary" onclick="saveRemediation()"><%= t('common.btn.save') %></button>
    </div>
  </div>
</div>


<script>
var REM_I18N = <%- JSON.stringify({
  noReason: t('remediation.list.js.noReason'),
  daysElapsed: t('remediation.list.js.daysElapsed'),
  noEvidence: t('remediation.list.js.noEvidence'),
  noHistory: t('remediation.list.js.noHistory'),
  selectFiles: t('remediation.list.js.selectFiles'),
  uploaded: t('remediation.list.js.uploaded'),
  saved: t('remediation.list.js.saved'),
  fail: t('remediation.list.js.fail'),
  error: t('remediation.list.js.error'),
  sev: { '상': td('상'), '중': td('중'), '하': td('하') }
}) %>;

let currentVuln = null;

function openModal(v) {
  currentVuln = v;
  document.getElementById('modalRuleId').textContent = v.rule_id;
  document.getElementById('modalHostname').textContent = v.hostname || '-';
  document.getElementById('modalAssetNo').textContent = v.asset_no || '-';
  document.getElementById('modalSeverity').innerHTML =
    '<span class="severity-badge sev-' + v.severity + '">' + (REM_I18N.sev[v.severity] || v.severity) + '</span>';
  document.getElementById('modalDiscovered').textContent =
    (v.discovered_at || '').slice(0, 19) + ' (' + REM_I18N.daysElapsed.replace('{n}', v.days_old) + ')';
  document.getElementById('modalTitle').textContent = v.title || '';
  document.getElementById('modalReason').textContent = v.reason || REM_I18N.noReason;

  const evBox = document.getElementById('evidenceBox');
  if (v.evidence) {
    evBox.style.display = 'block';
    document.getElementById('modalEvidence').textContent = v.evidence;
  } else {
    evBox.style.display = 'none';
  }

  document.getElementById('formResultId').value = v.result_id;
  document.getElementById('formFixStatus').value = v.fix_status || '미조치';
  document.getElementById('formAssignee').value = v.assignee || '';
  document.getElementById('formFixMethod').value = '';
  document.getElementById('formMisnotice').value = '';
  document.getElementById('formNote').value = '';

  renderEvidence(v);
  renderHistory(v);
  document.getElementById('evidenceFiles').value = '';

  document.getElementById('remModal').style.display = 'flex';
}

function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
}

function renderEvidence(v) {
  const box = document.getElementById('evidenceList');
  const files = v.evidence_files || [];
  if (!files.length) { box.innerHTML = esc(REM_I18N.noEvidence); return; }
  box.innerHTML = files.map(f =>
    '<div>📎 <a href="/remediation/' + encodeURIComponent(v.result_id) + '/evidence/' + encodeURIComponent(f.filename) + '" target="_blank">' +
    esc(f.original_name) + '</a> <span class="muted">(' + Math.round((f.size || 0) / 1024) + 'KB · ' + esc(f.uploaded_by) + ' · ' + esc(f.uploaded_at) + ')</span></div>'
  ).join('');
}

function renderHistory(v) {
  const box = document.getElementById('historyLog');
  const hist = v.remediation_history || [];
  if (!hist.length) { box.innerHTML = esc(REM_I18N.noHistory); return; }
  box.innerHTML = hist.slice().reverse().map(h =>
    '<div>• <b>' + esc(h.at) + '</b> ' + esc(h.by || '') +
    (h.from || h.to ? ' [' + esc(h.from || '') + '→' + esc(h.to || '') + ']' : '') +
    (h.fix_method ? ' — ' + esc(h.fix_method) : '') +
    (h.note ? ' (' + esc(h.note) + ')' : '') + '</div>'
  ).join('');
}

async function uploadEvidence() {
  if (!currentVuln) return;
  const input = document.getElementById('evidenceFiles');
  if (!input.files || !input.files.length) { alert(REM_I18N.selectFiles); return; }
  const fd = new FormData();
  for (const f of input.files) fd.append('evidence', f);
  const res = await fetch('/remediation/' + encodeURIComponent(currentVuln.result_id) + '/evidence', { method: 'POST', body: fd });
  const j = await res.json();
  if (j.status === 'success') {
    alert(REM_I18N.uploaded.replace('{n}', j.files.length));
    location.reload();
  } else {
    alert(REM_I18N.fail.replace('{msg}', j.error || REM_I18N.error));
  }
}

function closeModal() {
  document.getElementById('remModal').style.display = 'none';
}

async function saveRemediation() {
  if (!currentVuln) return;

  const data = {
    fix_status: document.getElementById('formFixStatus').value,
    assignee: document.getElementById('formAssignee').value,
    fix_method: document.getElementById('formFixMethod').value,
    misnotice_reason: document.getElementById('formMisnotice').value,
    note: document.getElementById('formNote').value,
  };

  const res = await fetch('/remediation/' + currentVuln.result_id + '/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  const j = await res.json();

  if (j.status === 'success') {
    alert(REM_I18N.saved);
    location.reload();
  } else {
    alert(REM_I18N.fail.replace('{msg}', j.error || REM_I18N.error));
  }
}

function applyFilter() {
  const server = document.getElementById('filterServer').value;
  const sev = document.getElementById('filterSeverity').value;
  const status = document.getElementById('filterStatus').value;
  const overdue = document.getElementById('filterOverdue').value;
  const text = document.getElementById('filterText').value.toLowerCase();
  const from = document.getElementById('filterFrom').value;
  const to = document.getElementById('filterTo').value;

  document.querySelectorAll('.kanban-card').forEach(card => {
    let show = true;
    if (server && card.dataset.hostname !== server) show = false;
    if (sev && card.dataset.severity !== sev) show = false;
    if (status && card.dataset.status !== status) show = false;
    if (overdue && card.dataset.overdue !== overdue) show = false;
    if (text && !card.dataset.search.includes(text)) show = false;
    const d = card.dataset.discovered || '';
    if (from && (!d || d < from)) show = false;
    if (to && (!d || d > to)) show = false;
    card.style.display = show ? '' : 'none';
  });
}

function resetFilter() {
  ['filterServer','filterSeverity','filterStatus','filterOverdue','filterText','filterFrom','filterTo']
    .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  document.querySelectorAll('.kanban-card').forEach(c => c.style.display = '');
}

['filterServer','filterSeverity','filterStatus','filterOverdue','filterText','filterFrom','filterTo'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener((id === 'filterText') ? 'input' : 'change', applyFilter);
});
</script>

<%- include('../_footer') %>
