<%- include('../_header', { title: t('adhoc.title'), activeMenu: 'adhoc' }) %>

<div class="page-header">
  <h1><%= t('adhoc.title') %></h1>
  <p class="muted small"><%= t('adhoc.desc') %></p>
</div>

<form method="POST" action="/adhoc/judge" enctype="multipart/form-data">
  <div class="section-box">
    <h3><%= t('adhoc.instructionLabel') %></h3>
    <p class="muted small"><%= t('adhoc.instructionHint') %></p>
    <div id="adhocPresetBar" style="margin-bottom:8px;display:flex;flex-wrap:wrap;gap:4px;align-items:center;">
      <span class="muted small"><%= t('adhoc.presetLabel') %>:</span>
      <button type="button" class="btn-sm" data-preset="ad"><%= t('adhoc.presetAd') %></button>
      <button type="button" class="btn-sm" data-preset="linux"><%= t('adhoc.presetLinux') %></button>
      <button type="button" class="btn-sm" data-preset="win"><%= t('adhoc.presetWin') %></button>
      <button type="button" class="btn-sm" data-preset="svc"><%= t('adhoc.presetSvc') %></button>
      <button type="button" class="btn-sm" data-preset="was"><%= t('adhoc.presetWas') %></button>
      <button type="button" class="btn-sm" data-preset="strict" data-append="1"><%= t('adhoc.presetStrict') %></button>
    </div>
    <script>
    // 프리셋 문구 — onclick 속성에 넣으면 따옴표가 HTML 을 깨므로 script 블록에서 안전하게 주입
    var ADHOC_PRESETS = <%- JSON.stringify({
      ad: t('adhoc.presetAdText'),
      linux: t('adhoc.presetLinuxText'),
      win: t('adhoc.presetWinText'),
      svc: t('adhoc.presetSvcText'),
      was: t('adhoc.presetWasText'),
      strict: t('adhoc.presetStrictText'),
    }).replace(/</g, '\\u003c') %>;
    // 적용: 지침 채우기(깜빡임+포커스) + 판정 백엔드를 로컬 LLM 으로 자동 전환(지침은 LLM 판정에서만 해석됨)
    document.querySelectorAll('#adhocPresetBar [data-preset]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = ADHOC_PRESETS[btn.getAttribute('data-preset')] || '';
        var el = document.querySelector('[name=instruction]');
        var append = btn.hasAttribute('data-append');
        el.value = (append && el.value) ? (el.value.replace(/\s+$/, '') + '\n' + text) : text;
        el.style.transition = 'background .25s';
        el.style.background = '#fff9d6';
        setTimeout(function () { el.style.background = ''; }, 1000);
        el.focus();
        var local = document.querySelector('input[name=backend][value=local]');
        if (local && !local.checked) {
          local.checked = true;
          var lbl = local.closest('label');
          if (lbl) {
            lbl.style.transition = 'background .25s';
            lbl.style.background = '#fff9d6';
            setTimeout(function () { lbl.style.background = ''; }, 1200);
          }
        }
      });
    });
    </script>
    <textarea name="instruction" rows="4" style="width:100%;box-sizing:border-box;font-family:inherit;font-size:13px;padding:8px;"
      placeholder="<%= t('adhoc.instructionPh') %>"><%= input && input.instruction ? input.instruction : '' %></textarea>
  </div>

  <div class="section-box">
    <h3><%= t('adhoc.rawLabel') %></h3>
    <p class="muted small"><%= t('adhoc.rawHint') %></p>
    <div style="margin-bottom:8px;padding:8px;background:#f6f8fa;border-radius:6px;">
      <label class="muted small" style="font-weight:600;"><%= t('adhoc.fileLabel') %></label><br>
      <input type="file" name="resultfile" accept=".txt,.json,.xml,.csv,.log,.out,.inf,.conf">
      <div class="muted small"><%= t('adhoc.fileHint') %></div>
      <% if (input && input.uploadedName) { %><div class="muted small" style="color:#2980b9;">📎 <%= input.uploadedName %></div><% } %>
    </div>
    <p class="muted small"><%= t('adhoc.orPaste') %></p>
    <textarea name="raw" rows="10" style="width:100%;box-sizing:border-box;font-family:monospace;font-size:12px;padding:8px;"
      placeholder="<%= t('adhoc.rawPh') %>"><%= input && input.raw ? input.raw : '' %></textarea>
  </div>

  <div class="section-box">
    <h3><%= t('adhoc.backendLabel') %></h3>
    <label style="display:block;margin-bottom:8px;">
      <input type="radio" name="backend" value="mock" <%= (!input || input.backend !== 'local') ? 'checked' : '' %>>
      <strong><%= t('adhoc.backendMock') %></strong> — <span class="muted small"><%= t('adhoc.backendMockHint') %></span>
    </label>
    <label style="display:block;">
      <input type="radio" name="backend" value="local" <%= (input && input.backend === 'local') ? 'checked' : '' %>>
      <strong><%= t('adhoc.backendLocal') %></strong> — <span class="muted small"><%= t('adhoc.backendLocalHint') %></span>
    </label>
    <div style="margin-top:14px; display:flex; gap:8px; flex-wrap:wrap;">
      <button type="submit" class="btn primary"><%= t('adhoc.judgeBtn') %></button>
      <button type="submit" class="btn" formaction="/adhoc/report" title="판정 결과를 기존 리포트(HTML/XLSX/인쇄PDF)로 생성"><%= t('adhoc.reportBtn') %></button>
    </div>
    <!-- 판정 진행바: 폼 제출(동기 POST) 동안 소프트 진행 표시 — 응답이 오면 페이지가 교체되며 사라짐 -->
    <div id="adhocProgress" style="display:none;margin-top:12px;">
      <div style="background:#e8ecef;border-radius:6px;overflow:hidden;height:14px;">
        <div id="adhocProgressFill" style="height:100%;width:4%;background:linear-gradient(90deg,#2980b9,#5dade2);transition:width .9s;"></div>
      </div>
      <div id="adhocProgressMsg" class="muted small" style="margin-top:5px;"></div>
    </div>
  </div>
</form>
<script>
(function () {
  var form = document.querySelector('form[action="/adhoc/judge"]');
  if (!form) return;
  var MSG = <%- JSON.stringify(t('adhoc.progressMsg')) %>;
  var ELAPSED = <%- JSON.stringify(t('adhoc.progressElapsed')) %>;
  var timer = null;
  form.addEventListener('submit', function () {
    var box = document.getElementById('adhocProgress');
    var fill = document.getElementById('adhocProgressFill');
    var msg = document.getElementById('adhocProgressMsg');
    var buttons = form.querySelectorAll('button[type=submit]');
    box.style.display = 'block';
    buttons.forEach(function (b) { b.disabled = true; });
    var pct = 4, t0 = Date.now();
    if (timer) clearInterval(timer);
    timer = setInterval(function () {
      pct = Math.min(95, pct + Math.max(0.5, (95 - pct) * 0.06));
      fill.style.width = pct + '%';
      msg.textContent = MSG + ' — ' + ELAPSED + ' ' + Math.round((Date.now() - t0) / 1000) + 's';
    }, 900);
  });
  // 뒤로가기(bfcache) 복원 시 진행바/버튼 원복
  window.addEventListener('pageshow', function (e) {
    if (!e.persisted) return;
    if (timer) clearInterval(timer);
    document.getElementById('adhocProgress').style.display = 'none';
    form.querySelectorAll('button[type=submit]').forEach(function (b) { b.disabled = false; });
  });
})();
</script>

<% if (typeof result !== 'undefined' && result) { %>
  <div class="section-box" style="border-left:4px solid <%= result.error ? '#c0392b' : '#2980b9' %>;">
    <h3><%= t('adhoc.resultTitle') %>
      <span class="muted small">— <%= t('adhoc.backendUsed') %>: <%= result.backend %><%= result.model ? ' (' + result.model + ')' : '' %></span>
    </h3>

    <% if (result.note) { %>
      <div class="first-run-notice" style="margin-bottom:12px;"><%= result.note %></div>
    <% } %>

    <% if (result.findings && result.findings.length) { %>
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t('adhoc.thItem') %></th>
            <th><%= t('adhoc.thVerdict') %></th>
            <th><%= t('adhoc.thReason') %></th>
            <th><%= t('adhoc.thEvidence') %></th>
          </tr>
        </thead>
        <tbody>
          <% result.findings.forEach(f => { %>
            <tr>
              <td><%= f.item %></td>
              <td>
                <% var v = f.verdict; %>
                <span class="status-cell <%= v === '취약' ? 'st-vuln' : (v === '양호' ? 'st-safe' : 'st-na') %>"><%= td(v) %></span>
              </td>
              <td class="small"><%= f.reason %></td>
              <td class="small mono" style="max-width:280px;overflow-wrap:break-word;"><%= f.evidence || '-' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% if (result.summary) { %><p class="muted small" style="margin-top:10px;"><%= t('adhoc.summaryLabel') %>: <%= result.summary %></p><% } %>
    <% } else if (!result.error) { %>
      <p class="empty"><%= t('adhoc.noFindings') %></p>
    <% } %>
  </div>
<% } %>

<%- include('../_footer') %>
