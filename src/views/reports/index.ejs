<%- include('../_header', { title: t('reports.index.title'), activeMenu: 'reports' }) %>

<div class="page-header">
  <h1><%= t('reports.index.title') %></h1>
  <p class="muted small">
    <%- t('reports.index.introHtml') %>
  </p>
</div>

<% if (!diagnoses.length) { %>
  <div class="section-box">
    <p class="muted"><%- t('reports.index.emptyHtml') %></p>
  </div>
<% } else { %>
  <div class="kpi-grid kpi-3col">
    <div class="kpi-card">
      <div class="kpi-label"><%= t('reports.index.kpiRecent') %></div>
      <div class="kpi-num"><%= diagnoses.length %></div>
      <div class="kpi-sub"><%= t('reports.index.kpiRecentSub') %></div>
    </div>
    <div class="kpi-card kpi-fail">
      <div class="kpi-label"><%= t('reports.index.kpiVulnSum') %></div>
      <div class="kpi-num" style="color:#c0392b;">
        <%= diagnoses.reduce((s, d) => s + (d.vuln_count || 0), 0) %>
      </div>
      <div class="kpi-sub"><%= t('reports.index.kpiSum', { n: diagnoses.length }) %></div>
    </div>
    <div class="kpi-card kpi-success">
      <div class="kpi-label"><%= t('reports.index.kpiSafeSum') %></div>
      <div class="kpi-num" style="color:#27ae60;">
        <%= diagnoses.reduce((s, d) => s + (d.safe_count || 0), 0) %>
      </div>
      <div class="kpi-sub"><%= t('reports.index.kpiSum', { n: diagnoses.length }) %></div>
    </div>
  </div>

  <div class="section-box">
    <h3><%= t('reports.index.listTitle', { n: diagnoses.length }) %></h3>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('reports.index.th.id') %></th>
          <th><%= t('reports.index.th.server') %></th>
          <th><%= t('reports.index.th.time') %></th>
          <th><%= t('reports.index.th.type') %></th>
          <th><%= t('reports.index.th.summary') %></th>
          <th><%= t('reports.index.th.report') %></th>
        </tr>
      </thead>
      <tbody>
        <% diagnoses.forEach(d => { %>
          <tr>
            <td class="mono"><strong>#<%= d.assessment_id %></strong></td>
            <td>
              <%= d.hostname || d.server_name || '-' %>
              <% if (d.asset_no) { %>
                <div class="muted small"><%= d.asset_no %></div>
              <% } %>
            </td>
            <td class="mono small"><%= d.executed_at %></td>
            <td>
              <% if (d.source_type === 'script') { %>
                <span style="color:#6c5ce7;font-weight:700;">📄 Script</span>
              <% } else { %>
                <span style="color:#27ae60;font-weight:700;">🗄️ SecuMS raw</span>
              <% } %>
              <div class="muted small">
                <% if (d.diagnose_type === 'llm') { %>
                  <span style="color:#0984e3;"><%= t('reports.index.llmVerdict') %></span>
                <% } else if (d.diagnose_type === 'ai') { %>
                  <span style="color:#999;"><%= t('reports.index.mockVerdict') %></span>
                <% } else { %><%= t('reports.common.ruleset') %><% } %>
              </div>
            </td>
            <td>
              <span style="color:#c0392b;font-weight:600;"><%= t('reports.index.vulnN', { n: d.vuln_count || 0 }) %></span>
              <span class="muted">/</span>
              <span style="color:#27ae60;"><%= t('reports.index.safeN', { n: d.safe_count || 0 }) %></span>
              <% if (d.na_count) { %>
                <span class="muted">/ N/A <%= d.na_count %></span>
              <% } %>
            </td>
            <td>
              <a href="/reports/<%= d.assessment_id %>/fsi" class="btn-sm primary"><%= t('reports.index.btnR1') %></a>
              <a href="/reports/<%= d.assessment_id %>/samsung" class="btn-sm"><%= t('reports.index.btnR2') %></a>
              <a href="/reports/<%= d.assessment_id %>/fsi/vuln" class="btn-sm" style="background:#c0392b;color:#fff;"><%= t('reports.index.btnV1') %></a>
              <a href="/reports/<%= d.assessment_id %>/samsung/vuln" class="btn-sm" style="background:#c0392b;color:#fff;"><%= t('reports.index.btnV2') %></a>
              <a href="/reports/<%= d.assessment_id %>/policy3" class="btn-sm" style="background:#0984e3;color:#fff;"><%= t('reports.index.btnR3') %></a>
              <a href="/reports/<%= d.assessment_id %>/remediation" class="btn-sm" style="background:#27ae60;color:#fff;"><%= t('reports.index.btnRemed') %></a>
              <a href="/reports/<%= d.assessment_id %>/threeway" class="btn-sm" style="background:#34495e;color:#fff;"><%= t('reports.index.btnThreeway') %></a>
              <% if (d.diagnose_type === 'ai' || d.diagnose_type === 'llm') { %>
                <a href="/diagnosis/<%= d.assessment_id %>/ai" class="btn-sm" style="background:#6c5ce7;color:#fff;"><%= d.diagnose_type === 'llm' ? t('reports.index.llmResult') : t('reports.index.aiResult') %></a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../_footer') %>
