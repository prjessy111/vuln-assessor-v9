<%- include('../_header', { title: t('reports.report3.title'), activeMenu: 'reports' }) %>
<% const s = report3.summary; %>
<style>
  .r3-cards { display:flex; flex-wrap:wrap; gap:12px; margin:16px 0; }
  .r3-card { flex:1 1 120px; background:#fff; border:1px solid #e1e5ea; border-radius:8px; padding:12px 14px; text-align:center; }
  .r3-card .num { font-size:1.8rem; font-weight:700; }
  .r3-card.agree .num { color:#27ae60; }
  .r3-card.bad .num { color:#c0392b; }
  .r3-card.review .num { color:#b9770e; }
  .r3-card.wait .num { color:#888; }
  .r3-card.rate .num { color:#2d3436; }
  .r3-banner { padding:12px 14px; border-radius:8px; margin:14px 0; }
  .r3-banner.warn { background:#fff8e1; border-left:4px solid #f1c40f; }
  .r3-group { margin-top:22px; }
  .r3-group h3 { margin:0 0 8px; }
  .badge-agree { color:#27ae60; font-weight:700; }
  .badge-bad { color:#c0392b; font-weight:700; }
  .badge-review { color:#b9770e; font-weight:700; }
  .badge-wait { color:#888; }
  table.r3 { width:100%; border-collapse:collapse; }
  table.r3 th, table.r3 td { border:1px solid #e1e5ea; padding:6px 8px; font-size:0.85rem; vertical-align:top; }
  table.r3 th { background:#f5f6fa; }
</style>

<div class="report-header">
  <h1><%= t('reports.report3.h1', { id: session.assessment_id }) %></h1>
  <div class="report-actions">
    <a href="/reports/<%= session.assessment_id %>/fsi" class="btn"><%= t('reports.common.toReport1') %></a>
    <a href="/reports/<%= session.assessment_id %>/report3/xlsx" class="btn primary"><%= t('reports.common.xlsx') %></a>
    <button type="button" onclick="printReport()" class="btn"><%= t('reports.common.pdf') %></button>
    <button type="button" onclick="downloadReportHtml()" class="btn"><%= t('reports.common.html') %></button>
    <a href="/history?server_id=<%= session.server_id %>" class="btn"><%= t('reports.common.toHistory') %></a>
  </div>
</div>

<table class="meta-table">
  <tr><th><%= t('reports.common.hostname') %></th><td><%= session.hostname %></td>
      <th><%= t('reports.common.assetNo') %></th><td><%= session.asset_no || t('reports.common.notRegistered') %></td></tr>
  <tr><th><%= t('reports.common.analysisEnv') %></th><td><%= session.os_type %> <%= session.os_version ? `(${session.os_version})` : '' %></td>
      <th><%= t('reports.common.assessedAt') %></th><td><%= session.executed_at %></td></tr>
</table>

<div class="r3-cards">
  <div class="r3-card"><div><%= t('reports.common.totalItems') %></div><div class="num"><%= s.total %></div></div>
  <div class="r3-card"><div><%= t('reports.report3.comparable') %></div><div class="num"><%= s.comparable %></div></div>
  <div class="r3-card agree"><div><%= t('reports.common.agree') %></div><div class="num"><%= s.agree %></div></div>
  <div class="r3-card bad"><div><%= t('reports.report3.failVerify') %></div><div class="num"><%= s.disagree_real %></div></div>
  <div class="r3-card review"><div><%= t('reports.report3.needsReview') %></div><div class="num"><%= s.needs_review %></div></div>
  <div class="r3-card wait"><div><%= t('reports.report3.secumsWait') %></div><div class="num"><%= s.waiting %></div></div>
  <div class="r3-card rate"><div><%= t('reports.common.agreeRate') %></div><div class="num"><%= s.baselinePresent ? s.agreementRate + '%' : 'N/A' %></div></div>
</div>

<% if (!s.baselinePresent) { %>
  <div class="r3-banner warn">
    <%- t('reports.report3.bannerHtml', { n: s.waiting, host: session.hostname }) %>
  </div>
<% } %>

<% report3.groups.forEach(function(g) { %>
  <div class="r3-group">
    <h3>
      <% if (g.code === 'agree') { %><span class="badge-agree">✔ <%= g.label %></span>
      <% } else if (g.code === 'disagree_real') { %><span class="badge-bad">✘ <%= g.label %></span>
      <% } else if (g.code === 'needs_review') { %><span class="badge-review">⚠ <%= g.label %></span>
      <% } else if (g.code === 'secums_wait') { %><span class="badge-wait">· <%= g.label %></span>
      <% } else { %><%= g.label %><% } %>
      <span class="muted">(<%= t('common.unit.count', { n: g.rows.length }) %>)</span>
    </h3>
    <table class="r3">
      <thead>
        <tr><th><%= t('reports.report3.th.itemId') %></th><th><%= t('reports.report3.th.title') %></th><th><%= t('reports.report3.th.category') %></th><th><%= t('reports.report3.th.aiVerdict') %></th><th><%= t('reports.report3.th.severity') %></th><th><%= t('reports.report3.th.secumsVerdict') %></th><th><%= t('reports.report3.th.reason') %></th></tr>
      </thead>
      <tbody>
        <% g.rows.forEach(function(r) { %>
          <tr>
            <td><%= r.rule_id %></td>
            <td><%= r.title %></td>
            <td><%= r.category %></td>
            <td><%= td(r.status) %></td>
            <td><%= r.severity ? td(r.severity) : '' %></td>
            <td><%= r.secums_verdict ? td(r.secums_verdict) : '-' %></td>
            <td><%= r.reason || '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% }); %>

<%- include('../_footer') %>
