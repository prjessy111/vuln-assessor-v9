<%- include('../_header', { title: t('reports.threeway.title'), activeMenu: 'reports' }) %>
<style>
  .tw-cards { display:flex; flex-wrap:wrap; gap:12px; margin:16px 0; }
  .tw-card { flex:1 1 110px; background:#fff; border:1px solid #e1e5ea; border-radius:8px; padding:12px 14px; text-align:center; }
  .tw-card .num { font-size:1.8rem; font-weight:700; }
  .tw-card.agree .num { color:#27ae60; }
  .tw-card.bad .num { color:#c0392b; }
  .tw-card.wait .num { color:#888; }
  .tw-card.rate .num { color:#2d3436; }
  .tw-legend { font-size:0.82rem; color:#555; margin:6px 0 12px; }
  .tw-legend b { color:#2d3436; }
  .tw-toolbar { margin:10px 0; display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
  .tw-toolbar label { font-size:0.9rem; cursor:pointer; user-select:none; }
  table.tw { width:100%; border-collapse:collapse; }
  table.tw th, table.tw td { border:1px solid #e1e5ea; padding:6px 8px; font-size:0.85rem; vertical-align:middle; }
  table.tw th { background:#f5f6fa; position:sticky; top:0; }
  table.tw td.code { font-family:monospace; color:#666; font-size:0.78rem; white-space:nowrap; }
  tr.mismatch { background:#fdecea; }
  tr.nodata { color:#999; }
  .v { font-weight:700; padding:2px 9px; border-radius:5px; display:inline-block; min-width:58px; text-align:center; font-size:0.82rem; }
  .v.취약 { background:#fdecea; color:#c0392b; border:1px solid #f5b7b1; }
  .v.양호 { background:#eafaf1; color:#1e8449; border:1px solid #abebc6; }
  .v.정보제공 { background:#eaf2fd; color:#2563eb; border:1px solid #aacbf5; }
  .v.판정불가 { background:#fff4e5; color:#b9770e; border:1px solid #f5d7a3; }
  .v.미점검 { background:#f0f0f0; color:#888; border:1px solid #ddd; }
  .v.기타 { background:#f0f0f0; color:#888; }
  .v.none { color:#ccc; }
  .m-agree { color:#27ae60; font-weight:700; }
  .m-mismatch { color:#c0392b; font-weight:700; }
  .m-nodata { color:#aaa; }
</style>

<div class="report-header">
  <h1><%= t('reports.threeway.h1', { host: hostname }) %></h1>
  <div class="report-actions">
    <a href="/reports" class="btn"><%= t('reports.threeway.reportList') %></a>
  </div>
</div>

<!-- 탐지 정확도 (③ SecuMS 자체판정 정답지 대비) — 모수 중 몇 개 일치 -->
<div style="display:flex;gap:14px;flex-wrap:wrap;margin:14px 0;">
  <div style="flex:1 1 300px;background:#eafaf1;border:2px solid #27ae60;border-radius:10px;padding:16px 18px;">
    <div style="font-size:0.92rem;color:#555;"><%= t('reports.threeway.acc1') %></div>
    <div style="font-size:2.4rem;font-weight:800;color:#27ae60;line-height:1.1;"><%= summary.accuracy.secums.rate %>%</div>
    <div style="font-size:0.95rem;color:#2d3436;"><%- t('reports.threeway.accDetailHtml', { d: summary.accuracy.secums.denom, c: summary.accuracy.secums.correct }) %></div>
  </div>
  <div style="flex:1 1 300px;background:#eef4fd;border:2px solid #0984e3;border-radius:10px;padding:16px 18px;">
    <div style="font-size:0.92rem;color:#555;"><%= t('reports.threeway.acc2') %></div>
    <div style="font-size:2.4rem;font-weight:800;color:#0984e3;line-height:1.1;"><%= summary.accuracy.script.rate %>%</div>
    <div style="font-size:0.95rem;color:#2d3436;"><%- t('reports.threeway.accDetailHtml', { d: summary.accuracy.script.denom, c: summary.accuracy.script.correct }) %></div>
  </div>
</div>
<div class="tw-legend" style="margin-top:-6px;">
  <%- t('reports.threeway.accNoteHtml') %>
</div>

<table class="meta-table">
  <tr><th><%= t('reports.common.hostname') %></th><td><%= hostname %></td>
      <th>OS</th><td><%= summary.os %></td></tr>
  <tr><th>① SecuMS raw AI</th><td><%= secums_id ? ('#' + secums_id) : t('reports.threeway.noRecord') %></td>
      <th>② Script AI</th><td><%= script_id ? ('#' + script_id) : t('reports.threeway.noRecord') %></td></tr>
</table>

<div class="tw-legend">
  <%- t('reports.threeway.bridgeHtml') %>
</div>

<div style="background:#f5f6fa;border:1px solid #e1e5ea;border-radius:8px;padding:12px 14px;margin:12px 0;">
  <div style="font-weight:600;margin-bottom:6px;"><%= t('reports.threeway.answerTitle') %></div>
  <% if (typeof secums_answer !== 'undefined' && secums_answer) { %>
    <div style="color:#27ae60;"><%= t('reports.threeway.answerUploaded', { n: secums_answer.count, at: secums_answer.updated_at }) %></div>
  <% } else { %>
    <div style="color:#b9770e;"><%= t('reports.threeway.answerMissing') %></div>
  <% } %>
  <form id="answerForm" style="margin-top:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <input type="file" name="detail_report" accept=".xlsx" required>
    <button type="submit" class="btn" style="background:#0984e3;border-color:#0984e3;color:#fff;"><%= t('reports.threeway.uploadBtn') %></button>
    <span class="muted" style="font-size:0.82rem;"><%= t('reports.threeway.uploadHint') %></span>
  </form>
</div>

<div class="tw-cards">
  <div class="tw-card"><div><%= t('reports.common.total') %></div><div class="num"><%= summary.total %></div></div>
  <div class="tw-card"><div><%= t('reports.threeway.comparable') %></div><div class="num"><%= summary.comparable %></div></div>
  <div class="tw-card agree"><div><%= t('reports.common.agree') %></div><div class="num"><%= summary.agree %></div></div>
  <div class="tw-card bad"><div><%= t('reports.threeway.mismatch') %></div><div class="num"><%= summary.mismatch %></div></div>
  <div class="tw-card wait"><div><%= t('reports.threeway.noData') %></div><div class="num"><%= summary.no_data %></div></div>
  <div class="tw-card rate"><div><%= t('reports.common.agreeRate') %></div><div class="num"><%= summary.agreement_rate %>%</div></div>
</div>

<div class="tw-toolbar">
  <label><input type="checkbox" id="onlyMismatch" onchange="applyFilter()"> <%= t('reports.threeway.onlyMismatch') %></label>
  <label><input type="checkbox" id="hideNoData" onchange="applyFilter()"> <%= t('reports.threeway.hideNoData') %></label>
</div>

<div class="tw-legend" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#f8f9fb;border:1px solid #e1e5ea;border-radius:8px;padding:8px 12px;margin:8px 0;">
  <b><%= t('reports.threeway.verdictLegend') %></b>
  <span class="v 취약"><%= td('취약') %></span>
  <span class="v 양호"><%= td('양호') %></span>
  <span class="v 정보제공"><%= td('정보제공') %></span>
  <span class="v 판정불가"><%= td('판정불가') %></span>
  <span class="v 미점검"><%= td('미점검') %></span>
  <span style="color:#666;font-size:0.8rem;"><%- t('reports.threeway.legendNoteHtml') %></span>
</div>

<table class="tw" id="twTable">
  <thead>
    <tr>
      <th>SRV</th><th>os-xxx</th><th><%= t('reports.threeway.th.item') %></th>
      <th>① secums-AI</th><th>② script-AI</th><th><%= t('reports.threeway.th.secumsVerdict') %></th><th><%= t('reports.common.agree') %></th>
    </tr>
  </thead>
  <tbody>
    <% function cell(v){ if(!v) return '<span class="v none">-</span>'; return '<span class="v '+v+'">'+td(v)+'</span>'; } %>
    <% rows.forEach(function(r){ %>
      <tr class="<%= r.match === 'mismatch' ? 'mismatch' : (r.match === 'no_data' ? 'nodata' : '') %>" data-match="<%= r.match %>">
        <td class="code"><%= r.srv || '-' %></td>
        <td class="code"><%= r.scan_id %></td>
        <td><%= r.title %></td>
        <td><%- cell(r.ai_secums) %></td>
        <td><%- cell(r.ai_script) %></td>
        <td><%- cell(r.secums_self) %></td>
        <td>
          <% if (r.match === 'agree') { %><span class="m-agree"><%= t('reports.threeway.matchAgree') %></span>
          <% } else if (r.match === 'mismatch') { %><span class="m-mismatch"><%= t('reports.threeway.matchMismatch') %></span>
          <% } else { %><span class="m-nodata"><%= t('reports.threeway.matchNoData') %></span><% } %>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<script>
document.getElementById('answerForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = this.querySelector('button');
  const orig = btn.textContent;
  btn.disabled = true; btn.textContent = <%- JSON.stringify(t('reports.threeway.js.uploading')) %>;
  try {
    const res = await fetch('/reports/secums-answer/upload', { method: 'POST', body: new FormData(this) });
    const data = await res.json();
    if (data.status === 'ok') {
      const lineFmt = <%- JSON.stringify(t('reports.threeway.js.lineFmt')) %>;
      const lines = data.summary.map(function(s){ return s.hostname + ': ' + lineFmt.replace('{total}', s.total).replace('{bad}', s.bad).replace('{ok}', s.ok).replace('{info}', s.info); }).join('\n');
      alert(<%- JSON.stringify(t('reports.threeway.js.savedHead')) %> + '\n\n' + lines + '\n\n' + <%- JSON.stringify(t('reports.threeway.js.savedTail')) %>);
      location.reload();
    } else {
      alert(<%- JSON.stringify(t('reports.threeway.js.failPrefix')) %> + (data.error || '?'));
    }
  } catch (err) {
    alert(<%- JSON.stringify(t('reports.threeway.js.netErrPrefix')) %> + err.message);
  } finally {
    btn.disabled = false; btn.textContent = orig;
  }
});
function applyFilter() {
  var onlyMis = document.getElementById('onlyMismatch').checked;
  var hideND = document.getElementById('hideNoData').checked;
  var rows = document.querySelectorAll('#twTable tbody tr');
  rows.forEach(function(tr) {
    var m = tr.getAttribute('data-match');
    var show = true;
    if (onlyMis && m !== 'mismatch') show = false;
    if (hideND && m === 'no_data') show = false;
    tr.style.display = show ? '' : 'none';
  });
}
</script>

<%- include('../_footer') %>
