<%- include('../_header', { title: t('reports.remediation.title'), activeMenu: 'reports' }) %>
<style>
  .rm-item { background:#fff; border:1px solid #e1e5ea; border-radius:8px; margin:8px 0; box-shadow:0 1px 2px rgba(0,0,0,.04); }
  .rm-item summary { list-style:none; cursor:pointer; padding:12px 16px; display:flex; align-items:center; gap:10px; font-size:14px; }
  .rm-item summary::-webkit-details-marker { display:none; }
  .rm-item summary::before { content:'▶'; color:#888; font-size:11px; transition:transform .15s; }
  .rm-item[open] summary::before { transform:rotate(90deg); }
  .rm-code { font-family:Consolas,monospace; color:#2980b9; font-weight:700; }
  .rm-sev { margin-left:auto; padding:2px 10px; border-radius:12px; font-size:11px; font-weight:700; color:#fff; }
  .sev-상{background:#c0392b;} .sev-중{background:#e67e22;} .sev-하{background:#f1c40f;color:#333;}
  .rm-body { padding:0 16px 14px 34px; font-size:13px; border-top:1px solid #f0f0f0; }
  .rm-body .lbl { color:#888; font-size:12px; margin-top:8px; }
  .rm-fix { background:#eafaf1; border-left:3px solid #27ae60; padding:8px 12px; border-radius:0 4px 4px 0; margin-top:4px; color:#1e6e3c; }
  .rm-toolbar { margin:10px 0; }
</style>

<div class="report-header">
  <h1><%= t('reports.remediation.h1', { id: session.assessment_id }) %> <span class="muted" style="font-size:0.6em;"><%= t('reports.remediation.vulnOnlySuffix') %></span></h1>
  <div class="report-actions">
    <a href="/reports/<%= session.assessment_id %>/fsi" class="btn"><%= t('reports.common.report1') %></a>
    <a href="/reports/<%= session.assessment_id %>/fsi/vuln/xlsx" class="btn primary"><%= t('reports.remediation.xlsxWithFix') %></a>
    <button type="button" onclick="printReport()" class="btn"><%= t('reports.common.pdf') %></button>
    <button type="button" onclick="downloadReportHtml()" class="btn"><%= t('reports.common.html') %></button>
  </div>
</div>
<p class="muted small"><%- t('reports.remediation.metaHtml', { host: session.hostname || session.server_name, n: vulnRows.length }) %></p>

<div class="rm-toolbar">
  <button type="button" class="btn-sm" onclick="document.querySelectorAll('.rm-item').forEach(d=>d.open=true)"><%= t('reports.remediation.expandAll') %></button>
  <button type="button" class="btn-sm" onclick="document.querySelectorAll('.rm-item').forEach(d=>d.open=false)"><%= t('reports.remediation.collapseAll') %></button>
</div>

<% if (!vulnRows.length) { %>
  <div class="section-box" style="text-align:center;color:#27ae60;padding:24px;"><%= t('reports.remediation.empty') %></div>
<% } else { %>
  <% vulnRows.forEach(function (r) { %>
    <details class="rm-item">
      <summary>
        <span class="rm-code"><%= r.rule_id %></span>
        <span><%= r.title %></span>
        <span class="rm-sev sev-<%= r.severity %>"><%= td(r.severity) %></span>
      </summary>
      <div class="rm-body">
        <div class="lbl"><%= t('reports.remediation.vulnReason') %></div>
        <div><%= r.reason || '-' %></div>
        <% if (r.evidence) { %><div class="lbl"><%= t('reports.remediation.evidence') %></div><div class="muted"><%= r.evidence %></div><% } %>
        <div class="lbl"><%= t('reports.remediation.fix') %></div>
        <div class="rm-fix">🔧 <%= r.recommend || t('reports.remediation.noFixData') %></div>
      </div>
    </details>
  <% }); %>
<% } %>

<%- include('../_footer') %>
