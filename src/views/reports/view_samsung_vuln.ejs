<%- include('../_header', { title: t('reports.samsung.vuln.title'), activeMenu: 'reports' }) %>

<div class="report-header">
  <h1><%= t('reports.samsung.vuln.h1', { id: session.assessment_id }) %></h1>
  <div class="report-actions">
    <a href="/reports/<%= session.assessment_id %>/samsung" class="btn"><%= t('reports.samsung.vuln.toAll') %></a>
    <a href="/reports/<%= session.assessment_id %>/fsi/vuln" class="btn" style="background:#c0392b;color:#fff;"><%= t('reports.samsung.vuln.toV1') %></a>
    <a href="/reports/<%= session.assessment_id %>/samsung/vuln/xlsx" class="btn primary"><%= t('reports.common.xlsx') %></a>
    <button type="button" onclick="printReport()" class="btn"><%= t('reports.common.pdf') %></button>
    <button type="button" onclick="downloadReportHtml()" class="btn"><%= t('reports.common.html') %></button>
    <a href="/history?server_id=<%= session.server_id %>" class="btn"><%= t('reports.common.toHistory') %></a>
  </div>
</div>
<p class="muted small" style="margin:1rem 0;"><%- t('reports.samsung.vuln.descHtml', { url: '/reports/' + session.assessment_id + '/samsung' }) %></p>

<table class="meta-table">
  <tr><th><%= t('reports.common.server') %></th><td><%= session.server_name %> (<%= session.hostname %>)</td>
      <th>OS</th><td><%= session.os_type %> <%= session.os_version ? `(${session.os_version})` : '' %></td></tr>
  <tr><th><%= t('reports.common.assessedAt') %></th><td><%= session.executed_at %></td>
      <th><%= t('reports.common.executor') %></th><td><%= session.executed_by || '-' %></td></tr>
  <tr><th><%= t('reports.common.policyName') %></th><td><%= session.policy_name %></td>
      <th><%= t('reports.common.elapsed') %></th><td><%= fmtMs(session.elapsed_ms) %></td></tr>
  <tr><th><%= t('reports.common.adapter') %></th><td><%= session.adapter || '-' %></td>
      <th><%= t('reports.common.llmEngine') %></th><td><%= session.llm_engine || '-' %></td></tr>
  <tr><th><%= t('reports.common.rawFile') %></th><td colspan="3"><%= session.raw_file_name %>
      <span class="muted small">(SHA-256: <%= session.raw_file_hash.slice(0,32) %>...)</span></td></tr>
</table>

<div class="summary-cards">
  <div class="summary-card total"><div><%= t('reports.common.total') %></div><div class="num"><%= session.total_count %></div></div>
  <div class="summary-card vuln"><div><%= t('reports.common.vuln') %></div><div class="num"><%= session.vuln_count %></div></div>
  <div class="summary-card safe"><div><%= t('reports.common.safe') %></div><div class="num"><%= session.safe_count %></div></div>
  <div class="summary-card na"><div><%= t('reports.common.na') %></div><div class="num"><%= session.na_count %></div></div>
</div>

<div class="eval-method-summary">
  <%= t('reports.common.evalDist') %>
  <span class="method-badge simple"><%= t('reports.common.evalSimple', { n: session.simple_count || 0 }) %></span>
  <span class="method-badge llm"><%= t('reports.common.evalLlm', { n: session.llm_count || 0 }) %></span>
</div>

<% Object.keys(vulnGrouped).forEach(group => { %>
  <h2><%= t('reports.samsung.policyGroup', { g: group }) %>
    <span class="cat-stat">
      <%
        const c = vulnGrouped[group];
        const v = c.filter(r => r.status === '취약').length;
        const s = c.filter(r => r.status === '양호').length;
        const n = c.filter(r => r.status === '점검불가').length;
      %>
      <%= t('reports.common.catStat', { v: v, s: s, n: n }) %>
    </span>
  </h2>

  <% vulnGrouped[group].forEach(r => { %>
    <table class="policy-item-table status-<%= r.status === '취약' ? 'vuln' : r.status === '양호' ? 'safe' : 'na' %>">
      <colgroup>
        <col style="width:140px"><col>
      </colgroup>
      <tr class="item-header">
        <th colspan="2">
          <span class="rule-id"><%= r.rule_id %></span>
          <span class="item-title"><%= r.title %></span>
          <span class="badges-right">
            <span class="sev sev-<%= r.severity %>"><%= t('reports.common.sevLabel', { sev: td(r.severity) }) %></span>
            <span class="method-badge <%= r.eval_method === 'simple' ? 'simple' : r.eval_method === 'llm' ? 'llm' : 'na' %>">
              <%= r.eval_method === 'simple' ? 'SQL' : r.eval_method === 'llm' ? 'AI' : 'N/A' %>
            </span>
            <span class="badge b-<%= r.status === '취약' ? 'vuln' : r.status === '양호' ? 'safe' : 'na' %>">
              <%= td(r.status) %>
            </span>
          </span>
        </th>
      </tr>
      <tr><th><%= t('reports.samsung.th.content') %></th><td class="long-text"><%= r.description || '-' %></td></tr>
      <tr><th><%= t('reports.samsung.th.checkMethod') %></th><td class="long-text mono"><%= r.check_method || '-' %></td></tr>
      <tr><th><%= t('reports.samsung.th.criteria') %></th><td class="long-text"><%= r.check_criteria || '-' %></td></tr>
      <tr><th><%= t('reports.samsung.th.result') %></th><td class="result-cell">
        <strong><%= r.reason %></strong>
        <% if (r.evidence) { %>
          <div class="evidence"><%= t('reports.common.evidence') %> <code><%= r.evidence %></code></div>
        <% } %>
      </td></tr>
      <tr><th><%= t('reports.samsung.th.fix') %></th><td class="long-text"><%= r.recommend || '-' %></td></tr>
      <% if (r.related_cves && r.related_cves.length) { %>
        <tr><th><%= t('reports.samsung.th.cve') %></th><td>
          <% r.related_cves.forEach(cve => { %>
            <span class="cve-tag cvss-<%= cve.severity_class %>">
              <a href="https://nvd.nist.gov/vuln/detail/<%= cve.id %>" target="_blank"><%= cve.id %></a>
              <span class="cvss-score">CVSS <%= cve.cvss %></span>
            </span>
          <% }); %>
        </td></tr>
      <% } %>
    </table>
  <% }); %>
<% }); %>

<%- include('../_footer') %>
