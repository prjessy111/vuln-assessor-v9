<%- include('../_header', { title: t('reports.fsi.all.title'), activeMenu: 'reports' }) %>

<div class="report-header">
  <h1><%= t('reports.fsi.all.h1', { id: session.assessment_id }) %></h1>
  <div class="report-actions">
    <a href="/reports/<%= session.assessment_id %>/fsi/vuln" class="btn" style="background:#c0392b;color:#fff;"><%= t('reports.common.vulnOnly') %></a>
    <a href="/reports/<%= session.assessment_id %>/samsung" class="btn"><%= t('reports.fsi.all.toR2') %></a>
    <a href="/reports/<%= session.assessment_id %>/fsi/xlsx" class="btn primary"><%= t('reports.common.xlsx') %></a>
    <button type="button" onclick="printReport()" class="btn"><%= t('reports.common.pdf') %></button>
    <button type="button" onclick="downloadReportHtml()" class="btn"><%= t('reports.common.html') %></button>
    <a href="/history?server_id=<%= session.server_id %>" class="btn"><%= t('reports.common.toHistory') %></a>
  </div>
</div>

<table class="meta-table">
  <tr><th><%= t('reports.common.hostname') %></th><td><%= session.hostname %></td>
      <th><%= t('reports.common.assetNo') %></th><td><%= session.asset_no || t('reports.common.notRegistered') %></td></tr>
  <tr><th><%= t('reports.common.serviceName') %></th><td><%= session.service_name || t('reports.common.notRegistered') %></td>
      <th>IP</th><td><%= session.ip_address || '-' %></td></tr>
  <tr><th><%= t('reports.common.analysisEnv') %></th><td><%= session.os_type %> <%= session.os_version ? `(${session.os_version})` : '' %> / <%= session.policy_name %></td>
      <th><%= t('reports.common.assessedAt') %></th><td><%= session.executed_at %></td></tr>
  <tr><th><%= t('reports.common.department') %></th><td><%= session.department || '-' %></td>
      <th><%= t('reports.common.executor') %></th><td><%= session.executed_by || '-' %></td></tr>
  <tr><th><%= t('reports.fsi.dataSource') %></th>
      <td>
        <% if (session.source_type === 'script') { %>
          <strong style="color:#6c5ce7;"><%= t('reports.fsi.scriptSource') %></strong>
        <% } else { %>
          <strong style="color:#27ae60;"><%= t('reports.fsi.secumsSource') %></strong>
        <% } %>
      </td>
      <th><%= t('reports.fsi.engine') %></th><td><%= session.llm_engine %></td></tr>
</table>

<div class="summary-cards">
  <div class="summary-card vuln">
    <div><%= t('reports.common.vulnMid') %></div><div class="num"><%= session.vuln_count %></div>
    <div class="small muted"><%= t('reports.common.subCount', { n: session.sub_vuln || 0 }) %></div>
  </div>
  <div class="summary-card new-flag">
    <div><%= t('reports.common.new') %></div><div class="num"><%= session.new_vuln_count || 0 %></div>
  </div>
  <div class="summary-card recurring">
    <div><%= t('reports.common.existingUnfixed') %></div><div class="num"><%= (session.vuln_count - (session.new_vuln_count || 0)) %></div>
  </div>
  <div class="summary-card safe">
    <div><%= t('reports.common.safe') %></div><div class="num"><%= session.safe_count %></div>
  </div>
  <div class="summary-card na">
    <div><%= t('reports.common.na') %></div><div class="num"><%= session.na_count %></div>
  </div>
</div>

<h2><%= t('reports.fsi.all.listTitle', { n: allRows.length }) %></h2>
<p class="muted small">
  <%- t('reports.fsi.all.descHtml', { url: '/reports/' + session.assessment_id + '/fsi/vuln' }) %>
</p>

<div class="fsi-table-wrap">
<table class="fsi-table">
  <thead>
    <tr>
      <th><%= t('reports.fsi.th.mgmtNo') %></th>
      <th><%= t('reports.fsi.th.itemNo') %></th>
      <th><%= t('reports.fsi.th.assetNo') %></th>
      <th><%= t('reports.fsi.th.hostname') %></th>
      <th><%= t('reports.fsi.th.serviceName') %></th>
      <th>IP</th>
      <th><%= t('reports.fsi.th.vuln') %></th>
      <th><%= t('reports.fsi.th.category') %></th>
      <th><%= t('reports.fsi.th.severity') %></th>
      <th><%= t('reports.fsi.th.sub') %></th>
      <th><%= t('reports.fsi.th.reason') %></th>
      <th><%= t('reports.fsi.th.isNew') %></th>
      <th><%= t('reports.fsi.th.assignee') %></th>
      <th><%= t('reports.fsi.th.deliveredAt') %></th>
      <th><%= t('reports.fsi.th.fixedAt') %></th>
      <th><%= t('reports.fsi.th.fixStatus') %></th>
      <th><%= t('reports.fsi.th.unfixedReason') %></th>
      <th><%= t('reports.fsi.th.remark') %></th>
    </tr>
  </thead>
  <tbody>
    <% allRows.forEach((r) => { %>
      <% var rowStatus = r.status === '취약' ? 'vuln' : r.status === '양호' ? 'safe' : (r.status === '정보제공' || r.status === '정보') ? 'info' : 'na'; %>
      <tr class="row-status-<%= rowStatus %> row-<%= r.fix_status === '조치완료' ? 'done' : r.fix_status === '진행중' ? 'in-progress' : '' %>">
        <td class="mono"><%= r.management_no %></td>
        <td class="mono"><%= r.rule_id %></td>
        <td class="mono"><%= session.asset_no || '-' %></td>
        <td><%= session.hostname %></td>
        <td><%= session.service_name || '-' %></td>
        <td class="mono small"><%= session.ip_address || '-' %></td>
        <td class="long-text"><%= r.title %></td>
        <td class="small"><%= r.category %></td>
        <td>
          <% if (r.status === '취약') { %>
            <span class="sev sev-<%= r.severity %>"><%= td(r.severity) %></span>
          <% } else if (r.status === '양호') { %>
            <span style="color:#27ae60;font-weight:600;"><%= t('reports.fsi.goodMark') %></span>
          <% } else if (r.status === '정보제공' || r.status === '정보') { %>
            <span class="muted"><%= t('reports.fsi.infoMark') %></span>
          <% } else { %>
            <span class="muted"><%= t('reports.fsi.naMark') %></span>
          <% } %>
        </td>
        <td class="small">
          <% if (r.subs && r.subs.length) {
               const sv = r.subs.filter(s => s.status === '취약').length; %>
            <span class="sub-badge">
              <%- t('reports.fsi.subVulnHtml', { sv: sv, m: r.subs.length }) %>
            </span>
          <% } else { %>
            <span class="muted">-</span>
          <% } %>
        </td>
        <td class="long-text small">
          <%= r.reason %>
          <% if (r.evidence) { %><br><span class="muted">→ <%= r.evidence %></span><% } %>
          <% if (r.status === '취약' && r.recommend) { %><br><span style="color:#1e8449;font-weight:600;"><%= t('reports.fsi.fixLabel') %><%= r.recommend %></span><% } %>
        </td>
        <td>
          <span class="newflag newflag-<%= r.is_new ? 'new' : 'old' %>">
            <%= td(r.is_new ? '신규' : '기존') %>
          </span>
        </td>
        <td class="editable"><%= r.assignee || '-' %></td>
        <td class="editable mono small"><%= r.delivered_at || '-' %></td>
        <td class="editable mono small"><%= r.fixed_at || '-' %></td>
        <td class="editable">
          <span class="fix-status fs-<%= r.fix_status === '조치완료' ? 'done' :
                                          r.fix_status === '진행중' ? 'progress' :
                                          r.fix_status === '예외' ? 'exempt' : 'pending' %>">
            <%= td(r.fix_status) %>
          </span>
          <% if (r.fix_status !== '조치완료' && r.fix_status !== '예외') { %>
            <% if (r.subs && r.subs.length) { %>
              <div class="cascade-hint">
                <%- t('reports.fsi.cascadeHintHtml', { n: r.subs.length }) %>
              </div>
            <% } %>
          <% } else { %>
            <% if (r.subs && r.subs.length) { %>
              <div class="cascade-done"><%= t('reports.fsi.cascadeDone', { n: r.subs.length }) %></div>
            <% } %>
          <% } %>
        </td>
        <td class="editable long-text small"><%= r.unfixed_reason || '-' %></td>
        <td class="editable small"><%= r.remark || '-' %></td>
      </tr>
    <% }); %>
    <% if (!vulnRows.length) { %>
      <tr><td colspan="18" class="empty" style="padding:32px;text-align:center;"><%= t('reports.fsi.all.empty') %></td></tr>
    <% } %>
  </tbody>
</table>
</div>

<div class="legend">
  <strong><%= t('reports.fsi.legend.title') %></strong>
  <span class="sub-badge"><%- t('reports.fsi.legend.subBadgeHtml') %></span> <%= t('reports.fsi.legend.subDesc') %>
  <span class="newflag newflag-new"><%= td('신규') %></span> <%= t('reports.fsi.legend.newDesc') %>
  <span class="newflag newflag-old"><%= td('기존') %></span> <%= t('reports.fsi.legend.oldDesc') %>
  <span class="fix-status fs-pending"><%= td('미조치') %></span>
  <span class="fix-status fs-progress"><%= td('진행중') %></span>
  <span class="fix-status fs-done"><%= td('조치완료') %></span>
  <span class="fix-status fs-exempt"><%= td('예외') %></span>
</div>

<%- include('../_footer') %>
