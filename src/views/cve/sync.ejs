<%- include('../_header', { title: t('cve.sync.title'), activeMenu: 'diagnosis' }) %>

<div class="page-header">
  <h1><%= t('cve.sync.title') %></h1>
  <p class="muted small">
    <%= t('cve.sync.intro') %>
  </p>
  <div class="header-actions">
    <button class="btn primary" onclick="runSync(false)"><%= t('cve.sync.btnSyncNow') %></button>
    <button class="btn" onclick="runSync(true)"><%= t('cve.sync.btnDryRun') %></button>
  </div>
</div>

<!-- KPI -->
<div class="kpi-grid kpi-5col">
  <div class="kpi-card">
    <div class="kpi-label"><%= t('cve.sync.kpi.curated') %></div>
    <div class="kpi-num"><%= stats.total %></div>
    <div class="kpi-sub"><%= t('cve.sync.kpi.curatedSub') %></div>
  </div>
  <div class="kpi-card kpi-<%= stats.sync_available ? 'success' : 'fail' %>">
    <div class="kpi-label"><%= t('cve.sync.kpi.feedSync') %></div>
    <div class="kpi-num" style="font-size:1.6rem; padding-top:0.4rem;">
      <%= stats.sync_available ? t('cve.sync.kpi.active') : t('cve.sync.kpi.notRun') %>
    </div>
    <div class="kpi-sub">NVD + CISA KEV</div>
  </div>
  <div class="kpi-card kpi-running">
    <div class="kpi-label"><%= t('cve.sync.kpi.enriched') %></div>
    <div class="kpi-num"><%= stats.enriched %></div>
    <div class="kpi-sub"><%= t('cve.sync.kpi.enrichedSub') %></div>
  </div>
  <div class="kpi-card" style="border-top-color:#c0392b;">
    <div class="kpi-label"><%= t('cve.sync.kpi.newKev') %></div>
    <div class="kpi-num" style="color:#c0392b;"><%= stats.kev_newly_added %></div>
    <div class="kpi-sub"><%= t('cve.sync.kpi.newKevSub') %></div>
  </div>
  <div class="kpi-card kpi-avg">
    <div class="kpi-label"><%= t('cve.sync.kpi.cvssUpdated') %></div>
    <div class="kpi-num"><%= stats.cvss_updated %></div>
    <div class="kpi-sub"><%= t('cve.sync.kpi.cvssUpdatedSub') %></div>
  </div>
</div>

<!-- 폐쇄망 안내 -->
<% if (!stats.sync_available) { %>
  <div class="section-box" style="background:#fff8e1;">
    <h3><%= t('cve.sync.noSyncTitle') %></h3>
    <p class="muted small"><%= t('cve.sync.noSyncDesc') %></p>
    <details>
      <summary><strong><%= t('cve.sync.offlineTitle') %></strong></summary>
      <ol style="margin-top:0.5rem;">
        <li><%= t('cve.sync.offlineStep1') %>
          <ul>
            <li><code>https://nvd.nist.gov/feeds/json/cve/1.1/nvdcve-1.1-modified.json.gz</code></li>
            <li><code>https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json</code></li>
          </ul>
        </li>
        <li><%- t('cve.sync.offlineStep2') %></li>
        <li><%- t('cve.sync.offlineStep3') %></li>
      </ol>
    </details>
  </div>
<% } %>

<!-- 동기화 이력 -->
<div class="section-box">
  <h3><%= t('cve.sync.historyTitle', { n: history.length }) %></h3>
  <% if (!history.length) { %>
    <p class="muted"><%= t('cve.sync.historyEmpty') %></p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('cve.sync.th.time') %></th>
          <th><%= t('cve.sync.th.totalCve') %></th>
          <th><%= t('cve.sync.th.new') %></th>
          <th><%= t('cve.sync.th.cvssChanged') %></th>
          <th><%= t('cve.sync.th.kevNew') %></th>
          <th><%= t('cve.sync.th.descEnriched') %></th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach(h => { %>
          <tr>
            <td class="mono small"><%= h.timestamp %></td>
            <td><%= h.total_cves %></td>
            <td><%= h.new_count > 0 ? '<strong>' + h.new_count + '</strong>' : 0 %></td>
            <td><%= h.cvss_changed %></td>
            <td>
              <% if (h.kev_added > 0) { %>
                <span style="color:#c0392b;font-weight:600;"><%= h.kev_added %></span>
              <% } else { %>0<% } %>
            </td>
            <td><%= h.description_updated %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- 큐레이션 미등록 KEV (즉시 검토 필요) -->
<div class="section-box">
  <h3><%= t('cve.sync.untrackedTitle', { n: untracked_kev.length }) %></h3>
  <p class="muted small">
    <%= t('cve.sync.untrackedDesc') %>
  </p>
  <% if (!untracked_kev.length) { %>
    <p class="muted"><%= t('cve.sync.untrackedNone') %></p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>CVE</th>
          <th><%= t('cve.sync.th.vendor') %></th>
          <th><%= t('cve.sync.th.product') %></th>
          <th><%= t('cve.sync.th.name') %></th>
          <th><%= t('cve.sync.th.due') %></th>
        </tr>
      </thead>
      <tbody>
        <% untracked_kev.forEach(u => { %>
          <tr>
            <td><strong><%= u.cve_id %></strong></td>
            <td class="small"><%= u.vendor || '-' %></td>
            <td class="small"><code><%= u.product || '-' %></code></td>
            <td class="small"><%= u.name || '-' %></td>
            <td class="small mono"><%= u.due || '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- 실행 결과 출력 -->
<div id="syncResult" class="section-box" style="display:none;">
  <h3><%= t('cve.sync.resultTitle') %></h3>
  <pre id="syncResultBody" style="background:#f8f9fa; padding:1rem; border-radius:4px; overflow:auto; max-height:500px; font-size:0.85rem;"></pre>
</div>

<script>
var I18N = <%- JSON.stringify({
  confirmDry: t('cve.sync.js.confirmDry'),
  confirmRun: t('cve.sync.js.confirmRun'),
  running: t('cve.sync.js.running'),
  confirmReload: t('cve.sync.js.confirmReload'),
  errorPrefix: t('cve.sync.js.errorPrefix')
}) %>;

async function runSync(dryRun) {
  if (!confirm(dryRun ? I18N.confirmDry : I18N.confirmRun)) return;

  const box = document.getElementById('syncResult');
  const body = document.getElementById('syncResultBody');
  box.style.display = 'block';
  body.textContent = I18N.running;

  try {
    const res = await fetch('/cve/sync/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dry_run: !!dryRun }),
    });
    const j = await res.json();
    body.textContent =
      `=== exit code: ${j.exit_code} ===\n\n` +
      (j.stdout || '(no stdout)') +
      (j.stderr ? '\n\n=== stderr ===\n' + j.stderr : '');

    if (j.status === 'success' && !dryRun) {
      setTimeout(() => {
        if (confirm(I18N.confirmReload)) location.reload();
      }, 1500);
    }
  } catch (e) {
    body.textContent = I18N.errorPrefix + e.message;
  }
}
</script>

<%- include('../_footer') %>
