<%- include('../_header', { title: t('cve.scanWin.title'), activeMenu: 'diagnosis' }) %>

<div class="page-header">
  <h1><%= t('cve.scanWin.heading', { id: assessment_id }) %></h1>
  <p class="muted small">
    <%- t('cve.scanWin.intro', { n: result.packages_count }) %>
  </p>
  <div class="header-actions">
    <a href="/diagnosis/<%= assessment_id %>/ai" class="btn" style="background:#6c5ce7;color:#fff;"><%= t('cve.scan.btnAiResult') %></a>
    <a href="/cve/sync" class="btn"><%= t('cve.scan.btnSync') %></a>
    <button type="button" onclick="printReport()" class="btn">🖨 PDF</button>
    <button type="button" onclick="downloadReportHtml()" class="btn">📄 HTML</button>
  </div>
</div>

<div class="info-box" style="background:#eef2ff; border-left:4px solid #6c5ce7; padding:0.75rem 1rem; margin:0 0 1rem; border-radius:4px;">
  <strong><%= t('cve.scanWin.banner') %></strong>
  <span class="muted small">
    <%- t('cve.scanWin.bannerDetail', { os: result.env.os_distro, build: result.env.os_version, n: result.packages_count }) %>
    <% if (result.hotfixes && result.hotfixes.length) { %>
      (<%= result.hotfixes.map(h => h.id).join(', ') %>)
    <% } %>
  </span>
</div>

<% if (result.error) { %>
  <div class="alert alert-warning"><strong><%= t('cve.scan.errorLabel') %></strong> <%= result.error %></div>
<% } else { %>

<!-- 환경 정보 -->
<table class="info-table">
  <tr>
    <th><%= t('cve.scan.hostname') %></th><td><%= result.env.hostname %></td>
    <th>OS</th><td><%= result.env.os_distro %> (<%= result.env.os_version %>)</td>
  </tr>
  <tr>
    <th><%= t('cve.scanWin.installedHotfix') %></th><td><strong><%= t('common.unit.count', { n: result.packages_count }) %></strong></td>
    <th><%= t('cve.scan.matchedCve') %></th><td><strong><%= t('common.unit.count', { n: result.summary.total }) %></strong> (<%= t('cve.scanWin.vulnN', { n: result.summary.actually_vulnerable }) %>)</td>
  </tr>
  <tr>
    <th><%= t('cve.scanWin.installedSw') %></th><td colspan="3"><strong><%= t('common.unit.count', { n: (result.software && result.software.length) || 0 }) %></strong> <span class="muted small"><%= t('cve.scanWin.swInventoryNote') %></span></td>
  </tr>
</table>

<!-- 서드파티 소프트웨어 CVE 매칭 결과 -->
<% var swMatches = result.software_matches || []; %>
<% if (swMatches.length) { %>
  <div class="section-box" style="margin-top:16px;border:2px solid #d35400;">
    <h3 style="margin-top:0;color:#d35400;"><%= t('cve.scanWin.swMatchTitle', { n: swMatches.length }) %></h3>
    <div style="background:#fff8e1;border-left:4px solid #f1c40f;padding:8px 12px;margin:0 0 10px;border-radius:4px;font-size:12.5px;">
      <%- t('cve.scanWin.swMatchWarn') %>
    </div>
    <table class="data-table">
      <thead><tr><th>CVE</th><th><%= t('cve.scanWin.th.software') %></th><th><%= t('cve.scanWin.th.version') %></th><th>CVSS</th><th><%= t('cve.scanWin.th.verdict') %></th><th><%= t('cve.scanWin.th.basis') %></th></tr></thead>
      <tbody>
        <% swMatches.forEach(function (m) { var j = m.ai_judgment || {}; var vd = j.verdict || m.verdict || 'POTENTIAL';
           var badge = vd === 'PATCHED_BACKPORT' ? '<span style="color:#27ae60;font-weight:700;">' + t('cve.scanWin.verdictPatched') + '</span>'
                     : vd === 'CONFIRMED' ? '<span style="color:#c0392b;font-weight:700;">' + t('cve.scanWin.verdictConfirmed') + '</span>'
                     : vd === 'LIKELY_VULNERABLE' ? '<span style="color:#e67e22;font-weight:700;">' + t('cve.scanWin.verdictLikely') + '</span>'
                     : '<span style="color:#2980b9;font-weight:700;">' + t('cve.scanWin.verdictReview') + '</span>'; %>
          <tr>
            <td class="mono small"><%= m.cve_id %><%= m.cisa_kev ? ' 🔴KEV' : '' %></td>
            <td><%= m.software %></td>
            <td class="mono small"><strong style="color:#c0392b;"><%= m.version %></strong></td>
            <td class="small"><%= m.cvss_v3 %></td>
            <td class="small"><%- badge %></td>
            <td class="small">
              <div><%= m.basis || t('cve.scanWin.basisFallback', { sw: m.software, ver: m.version }) %></div>
              <% if (j.rationale_ko) { %><div class="muted" style="margin-top:3px;">↳ <%= j.rationale_ko %></div><% } %>
              <% if (m.backport_check && m.backport_check.detail) { %><div style="margin-top:3px;color:#1e8449;"><%= t('cve.scanWin.backportCheckPrefix') %> <%= m.backport_check.detail %></div><% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else if (result.software && result.software.length) { %>
  <p class="muted small" style="margin-top:12px;"><%= t('cve.scanWin.swNoMatch', { n: result.software.length }) %></p>
<% } %>

<!-- CISA KEV 등재 제품 탐지 (활성 익스플로잇 — 버전 미검증 자문) -->
<% var kevP = result.kev_products || []; %>
<% if (kevP.length) { %>
  <div class="section-box" style="margin-top:16px;border:2px solid #e67e22;">
    <h3 style="margin-top:0;color:#d35400;"><%= t('cve.scanWin.kevProductTitle', { n: kevP.length }) %></h3>
    <p class="muted small" style="margin:4px 0 10px;"><%- t('cve.scanWin.kevProductDesc') %></p>
    <table class="data-table">
      <thead><tr><th><%= t('cve.scanWin.th.kevProduct') %></th><th><%= t('cve.scanWin.installedSw') %></th><th><%= t('cve.scanWin.th.version') %></th><th>KEV CVE</th></tr></thead>
      <tbody>
        <% kevP.forEach(function (k) { %>
          <tr>
            <td><strong style="color:#d35400;"><%= k.product %></strong></td>
            <td><%= k.software %></td>
            <td class="mono small"><%= k.version || '-' %></td>
            <td class="small"><%= t('common.unit.count', { n: k.kev_cve_count }) %> <span class="muted">(<%= (k.sample_cves||[]).slice(0,3).join(', ') %>…)</span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<!-- 설치 소프트웨어 인벤토리 (rpm -qa 의 Windows 대응) -->
<% if (result.software && result.software.length) { %>
  <details class="section-box" style="margin-top:16px;">
    <summary style="cursor:pointer;font-weight:700;"><%= t('cve.scanWin.swInventoryTitle', { n: result.software.length }) %></summary>
    <p class="muted small" style="margin:8px 0;"><%= t('cve.scanWin.swInventoryDesc') %></p>
    <table class="data-table" style="margin-top:8px;">
      <thead><tr><th>#</th><th><%= t('cve.scanWin.th.software') %></th><th><%= t('cve.scanWin.th.version') %></th><th><%= t('cve.scanWin.th.publisher') %></th></tr></thead>
      <tbody>
        <% result.software.forEach(function (sw, i) { %>
          <tr>
            <td class="small mono"><%= i + 1 %></td>
            <td><%= sw.name %></td>
            <td class="mono small"><%= sw.version || '-' %></td>
            <td class="small muted"><%= sw.publisher || '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </details>
<% } %>

<!-- KPI 카드 -->
<div class="kpi-grid kpi-5col" style="margin-top:16px;">
  <div class="kpi-card kpi-critical">
    <div class="kpi-label">CRITICAL</div>
    <div class="kpi-num"><%= result.summary.by_severity.critical %></div>
    <div class="kpi-sub">CVSS 9.0+</div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label">HIGH</div>
    <div class="kpi-num"><%= result.summary.by_severity.high %></div>
    <div class="kpi-sub">CVSS 7.0~8.9</div>
  </div>
  <div class="kpi-card kpi-warning">
    <div class="kpi-label">MEDIUM</div>
    <div class="kpi-num"><%= result.summary.by_severity.medium %></div>
    <div class="kpi-sub">CVSS 4.0~6.9</div>
  </div>
  <div class="kpi-card" style="border-top-color:#c0392b;">
    <div class="kpi-label">CISA KEV</div>
    <div class="kpi-num" style="color:#c0392b;"><%= result.summary.kev_count %></div>
    <div class="kpi-sub"><%= t('cve.scanWin.kpi.kevSub') %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('cve.scanWin.kpi.patched') %></div>
    <div class="kpi-num"><%= result.summary.patched_count %></div>
    <div class="kpi-sub"><%= t('cve.scanWin.kpi.patchedSub') %></div>
  </div>
</div>

<!-- 우선순위 KPI -->
<div class="kpi-grid kpi-4col" style="margin-top:12px;">
  <div class="kpi-card" style="border-top-color:#c0392b;">
    <div class="kpi-label">IMMEDIATE</div>
    <div class="kpi-num" style="color:#c0392b;"><%= result.summary.by_priority.IMMEDIATE || 0 %></div>
    <div class="kpi-sub"><%= t('cve.scan.kpi.immediateSub') %></div>
  </div>
  <div class="kpi-card" style="border-top-color:#e67e22;">
    <div class="kpi-label">URGENT</div>
    <div class="kpi-num" style="color:#e67e22;"><%= result.summary.by_priority.URGENT || 0 %></div>
    <div class="kpi-sub"><%= t('cve.scan.kpi.urgentSub') %></div>
  </div>
  <div class="kpi-card" style="border-top-color:#f39c12;">
    <div class="kpi-label">SCHEDULED</div>
    <div class="kpi-num" style="color:#f39c12;"><%= result.summary.by_priority.SCHEDULED || 0 %></div>
    <div class="kpi-sub"><%= t('cve.scan.kpi.scheduledSub') %></div>
  </div>
  <div class="kpi-card" style="border-top-color:#7f8c8d;">
    <div class="kpi-label">MONITOR</div>
    <div class="kpi-num" style="color:#7f8c8d;"><%= result.summary.by_priority.MONITOR || 0 %></div>
    <div class="kpi-sub"><%= t('cve.scan.kpi.monitorSub') %></div>
  </div>
</div>

<!-- CVE 목록 -->
<div class="section-box" style="margin-top:20px;">
  <h3><%= t('cve.scan.listTitle') %></h3>
  <table class="data-table cve-table">
    <thead>
      <tr>
        <th width="110">CVE ID</th>
        <th><%= t('cve.scan.th.name') %></th>
        <th width="60">CVSS</th>
        <th width="50">KEV</th>
        <th width="60">EPSS</th>
        <th><%= t('cve.scanWin.th.target') %></th>
        <th width="100"><%= t('cve.scan.th.priority') %></th>
        <th width="80"><%= t('cve.scan.th.realRisk') %></th>
      </tr>
    </thead>
    <tbody>
      <% result.matches.forEach(m => {
        const j = m.ai_judgment || {};
        const isPatched = m.backport.isPatched;
      %>
        <tr class="row-priority-<%= (j.patch_priority || 'monitor').toLowerCase() %>">
          <td class="mono"><strong><%= m.cve_id %></strong></td>
          <td class="small">
            <%= m.cve_name %>
            <% if (m.exploit_public) { %><span class="badge-exploit">PoC</span><% } %>
          </td>
          <td><span class="sev-badge sev-<%= m.severity.toLowerCase() %>"><%= m.cvss_v3 %></span></td>
          <td class="text-center">
            <% if (m.cisa_kev) { %><span class="kev-badge">🔴</span><% } else { %><span class="muted">·</span><% } %>
          </td>
          <td class="text-center small"><%= (m.epss * 100).toFixed(1) %>%</td>
          <td class="mono small">
            <%= m.pkg_full %>
            <% if (isPatched) { %>
              <div class="muted small" style="color:#27ae60;"><%= t('cve.scanWin.patchApplied', { kb: m.fix_kb }) %></div>
            <% } else { %>
              <div class="muted small" style="color:#c0392b;"><%= t('cve.scanWin.kbMissing', { kb: m.fix_kb }) %></div>
            <% } %>
            <% if (m.service_note) { %>
              <div class="muted small"><%= m.service_note %></div>
            <% } %>
          </td>
          <td>
            <% if (j.patch_priority === 'IMMEDIATE') { %>
              <span class="prio-badge prio-immediate">🚨 IMMEDIATE</span>
            <% } else if (j.patch_priority === 'URGENT') { %>
              <span class="prio-badge prio-urgent">⚠ URGENT</span>
            <% } else if (j.patch_priority === 'SCHEDULED') { %>
              <span class="prio-badge prio-scheduled">SCHEDULED</span>
            <% } else { %>
              <span class="prio-badge prio-monitor">MONITOR</span>
            <% } %>
          </td>
          <td class="text-center">
            <% if (j.is_vulnerable) { %>
              <span class="status-cell st-vuln"><%= t('cve.scan.vuln') %></span>
            <% } else { %>
              <span class="status-cell st-safe"><%= t('cve.scan.safe') %></span>
            <% } %>
          </td>
        </tr>
        <tr class="cve-detail-row">
          <td colspan="8" class="cve-detail">
            <div class="cve-detail-grid">
              <div class="cve-detail-block">
                <div class="detail-label"><%= t('cve.scan.detail.rationale') %></div>
                <div class="detail-text"><%= j.rationale_ko %></div>
              </div>
              <div class="cve-detail-block">
                <div class="detail-label"><%= t('cve.scan.detail.scenario') %></div>
                <div class="detail-text"><%= j.exploit_scenario %></div>
              </div>
              <div class="cve-detail-block">
                <div class="detail-label"><%= t('cve.scan.detail.actions') %></div>
                <ul class="detail-list">
                  <% (j.recommended_actions || []).forEach(a => { %><li><%= a %></li><% }); %>
                </ul>
              </div>
              <div class="cve-detail-block">
                <div class="detail-label"><%= t('cve.scan.detail.patchInfo') %></div>
                <div class="detail-text">
                  <strong><%= t('cve.scanWin.detail.advisory') %></strong> <%= m.patches && m.patches.upstream || '-' %><br>
                  <strong><%= t('cve.scanWin.detail.fixKb') %></strong> <%= (m.fixed_by_kb || []).join(', ') || '-' %><br>
                  <strong><%= t('cve.scanWin.detail.installedKbs') %></strong> <%= (m.installed_kbs || []).join(', ') || t('cve.scanWin.detail.none') %>
                </div>
              </div>
            </div>
          </td>
        </tr>
      <% }); %>
      <% if (!result.matches.length) { %>
        <tr><td colspan="8" class="empty" style="padding:32px;text-align:center;">
          <%= t('cve.scanWin.empty') %>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="info-box" style="margin-top:20px;">
  <h4><%= t('cve.scanWin.howTitle') %></h4>
  <ul>
    <li><%- t('cve.scanWin.how1', { n: result.packages_count }) %></li>
    <li><%- t('cve.scanWin.how2') %></li>
    <li><%- t('cve.scanWin.how3') %></li>
    <li><%- t('cve.scanWin.how4') %></li>
  </ul>
  <p class="small muted" style="margin-top:12px;">
    <%= t('cve.scanWin.howNote') %>
  </p>
</div>

<% } %>

<%- include('../_footer') %>
