<%- include('../_header', { title: t('schedules.history.title'), activeMenu: 'diagnosis' }) %>

<div class="page-header">
  <h1>🔄 <%= t('schedules.history.h1') %></h1>
  <div class="header-actions">
    <a href="/diagnosis" class="btn"><%= t('schedules.history.toDiag') %></a>
    <button class="btn primary" onclick="runAll()" style="background:#27ae60;border-color:#27ae60;"><%= t('schedules.history.runAllBtn') %></button>
    <button class="btn" onclick="location.reload()">🔁 <%= t('schedules.history.refresh') %></button>
  </div>
</div>

<p class="muted small" style="margin:0.5rem 0 1rem;">
  <%- t('schedules.history.introHtml') %>
</p>

<h2 style="margin-top:1.5rem;">📋 <%= t('schedules.history.csvTitle', { n: csvServers.length }) %></h2>
<% if (csvServers.length === 0) { %>
  <p class="muted" style="padding:1rem;background:#fffbe6;border-left:3px solid #f1c40f;">
    <%- t('schedules.history.emptyCsvHtml') %>
  </p>
<% } else { %>
  <table class="data-table" style="margin-bottom:1.5rem;">
    <thead>
      <tr>
        <th><%= t('schedules.history.th.host') %></th><th>IP</th><th>OS</th><th><%= t('schedules.history.th.user') %></th><th><%= t('schedules.history.th.assetNo') %></th>
        <th style="width:180px;"><%= t('schedules.history.th.runSingle') %></th>
      </tr>
    </thead>
    <tbody>
      <% csvServers.forEach(s => { %>
        <tr>
          <td><strong><%= s.hostname %></strong></td>
          <td class="mono small"><%= s.ip %></td>
          <td><%= s.os %></td>
          <td class="small"><%= s.username %></td>
          <td class="small"><%= s.asset_no %></td>
          <td>
            <button class="btn-sm primary" onclick="fetchAndRun('<%= s.ip %>', '<%= s.hostname %>')" style="background:#6c5ce7;">🔄 <%= t('schedules.history.fetchRun') %></button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2 style="margin-top:1.5rem;">🕒 <%= t('schedules.history.historyTitle') %></h2>
<p class="muted small">
  <%- t('schedules.history.recentHtml', { n: history.length, total: total }) %>
</p>

<table class="data-table">
  <thead>
    <tr>
      <th style="width:140px;"><%= t('schedules.history.th.startedAt') %></th>
      <th><%= t('schedules.history.th.host') %></th><th style="width:110px;">IP</th><th style="width:70px;">OS</th>
      <th style="width:80px;"><%= t('schedules.history.th.fetch') %></th><th style="width:80px;"><%= t('schedules.history.th.diagnose') %></th>
      <th style="width:90px;"><%= t('schedules.history.th.resultId') %></th><th><%= t('schedules.history.th.summary') %></th><th style="width:80px;"><%= t('schedules.history.th.elapsed') %></th>
    </tr>
  </thead>
  <tbody>
    <% if (!history.length) { %>
      <tr>
        <td colspan="9" class="empty" style="padding:40px;text-align:center;">
          <%= t('schedules.history.emptyHistory') %><br>
          <span class="muted small"><%- t('schedules.history.emptyHistoryHintHtml') %></span>
        </td>
      </tr>
    <% } %>
    <% history.forEach(h => { %>
      <tr>
        <td class="small mono"><%= h.started_at %></td>
        <td><strong><%= h.hostname %></strong></td>
        <td class="mono small"><%= h.ip %></td>
        <td><%= h.os %></td>
        <td>
          <% if (h.fetch_status === 'success') { %><span style="color:#27ae60;font-weight:600;">✓ <%= t('schedules.history.stSuccess') %></span>
          <% } else if (h.fetch_status === 'failed') { %><span style="color:#c0392b;font-weight:600;" title="<%= h.fetch_error %>">✗ <%= t('schedules.history.stFailed') %></span>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td>
          <% if (h.diagnose_status === 'success') { %><span style="color:#27ae60;font-weight:600;">✓ <%= t('schedules.history.stDone') %></span>
          <% } else if (h.diagnose_status === 'skipped') { %><span class="muted" title="<%= h.diagnose_error %>"><%= t('schedules.history.stSkipped') %></span>
          <% } else if (h.diagnose_status === 'failed') { %><span style="color:#c0392b;font-weight:600;" title="<%= h.diagnose_error %>">✗ <%= t('schedules.history.stFailed') %></span>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td>
          <% if (h.assessment_id) { %><a href="/diagnosis/<%= h.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;">#<%= h.assessment_id %></a>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td class="small">
          <% if (h.summary) { %>
            <span style="color:#c0392b;"><%= t('schedules.history.sumVuln') %> <%= h.summary.vuln %></span> /
            <span style="color:#27ae60;"><%= t('schedules.history.sumSafe') %> <%= h.summary.safe %></span>
            <% if (h.summary.info) { %>/ <%= t('schedules.history.sumInfo') %> <%= h.summary.info %><% } %>
          <% } else if (h.fetch_error) { %>
            <span class="muted" style="font-size:0.85em;"><%= h.fetch_error.substring(0, 80) %></span>
          <% } else if (h.diagnose_error) { %>
            <span class="muted" style="font-size:0.85em;"><%= h.diagnose_error.substring(0, 80) %></span>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td class="small mono"><%= h.elapsed_ms ? fmtMs(h.elapsed_ms) : '-' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<script>
var I18N = <%- JSON.stringify({
  confirmFetch: t('schedules.history.js.confirmFetch'),
  doneMsg: t('schedules.history.js.doneMsg'),
  fetchFail: t('schedules.history.js.fetchFailPrefix'),
  diagFail: t('schedules.history.js.diagFailPrefix'),
  unknownError: t('schedules.history.js.unknownError'),
  failMsg: t('schedules.history.js.failMsg'),
  netError: t('schedules.history.js.netErrorPrefix'),
  confirmRunAll: t('schedules.history.js.confirmRunAll'),
  runningBtn: t('schedules.history.js.runningBtn'),
  batchDone: t('schedules.history.js.batchDone'),
  detailHeader: t('schedules.history.js.detailHeader'),
  vulnParen: t('schedules.history.js.vulnParen'),
  fetchTag: t('schedules.history.js.fetchTag'),
  batchFail: t('schedules.history.js.batchFailPrefix'),
  runAllBtn: t('schedules.history.runAllBtn')
}) %>;

function tfmt(s, p) {
  return s.replace(/\{(\w+)\}/g, function(m, k) { return p[k] !== undefined ? String(p[k]) : m; });
}

async function fetchAndRun(serverId, hostname) {
  if (!confirm(tfmt(I18N.confirmFetch, { host: hostname }))) return;
  const btns = document.querySelectorAll('button[onclick*="fetchAndRun"]');
  btns.forEach(function(b) { b.disabled = true; });
  try {
    const res = await fetch('/diagnosis/fetch-and-run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ server_id: serverId }),
    });
    const data = await res.json();
    if (data.status === 'success') {
      const s = data.summary || {};
      alert(tfmt(I18N.doneMsg, {
        host: data.hostname,
        vuln: s.vuln,
        safe: s.safe,
        info: (s.info || 0),
        agree: s.agreement_rate,
        vfr: (s.validation_failure_rate || 0)
      }));
      location.href = '/diagnosis/' + data.assessment_id + '/ai';
    } else {
      const reason = data.fetch_status === 'failed' ? I18N.fetchFail + data.fetch_error :
                     data.diagnose_status === 'failed' ? I18N.diagFail + data.diagnose_error :
                     data.error || I18N.unknownError;
      alert(tfmt(I18N.failMsg, { host: (data.hostname || hostname), reason: reason }));
    }
  } catch (e) {
    alert(I18N.netError + e.message);
  } finally {
    btns.forEach(function(b) { b.disabled = false; });
  }
}

async function runAll() {
  if (!confirm(I18N.confirmRunAll)) return;
  const btn = event.target;
  btn.disabled = true;
  btn.textContent = I18N.runningBtn;
  try {
    const res = await fetch('/scheduler/run-all', { method: 'POST' });
    const data = await res.json();
    if (data.status === 'completed') {
      const s = data.summary;
      let msg = tfmt(I18N.batchDone, { total: s.total, success: s.success, fetched: s.fetched_only, failed: s.failed });
      if (data.results) {
        msg += I18N.detailHeader;
        data.results.forEach(function(r) {
          const tag = r.diagnose_status === 'success' ? '✓' :
                      r.fetch_status === 'failed' ? I18N.fetchTag : '⚠';
          const detail = r.summary ? tfmt(I18N.vulnParen, { n: r.summary.vuln }) :
                         (r.error ? '(' + r.error.substring(0, 40) + ')' : '');
          msg += '  ' + tag + ' ' + r.hostname + ' ' + detail + '\n';
        });
      }
      alert(msg);
      location.reload();
    } else {
      alert(I18N.batchFail + (data.error || '?'));
    }
  } catch (e) {
    alert(I18N.netError + e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = I18N.runAllBtn;
  }
}
</script>

<%- include('../_footer') %>
