<%- include('../_header', { title: t('collection.title'), activeMenu: 'collection' }) %>
<% const deployJobs = scriptDeployJobs || []; %>
<style>
  .progress-panel { margin-top:10px;padding:10px 12px;background:#f8fafc;border:1px solid #dfe6e9;border-radius:6px; }
  .progress-row { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px; }
  .progress-title { font-weight:600;color:#2d3436; }
  .progress-percent { font-variant-numeric:tabular-nums;color:#0984e3;font-weight:700; }
  .progress-track { height:10px;background:#e9eef3;border-radius:999px;overflow:hidden; }
  .progress-fill { height:100%;width:0%;background:#0984e3;transition:width .25s ease; }
  .progress-message { margin-top:6px;color:#636e72; }
  .progress-mini { width:120px;height:8px;background:#e9eef3;border-radius:999px;overflow:hidden;display:inline-block;vertical-align:middle;margin-right:6px; }
  .progress-mini > span { display:block;height:100%;background:#0984e3; }
</style>

<div class="page-header">
  <h1><%= t('collection.idx.heading') %></h1>
  <div class="header-actions">
    <a href="/collection/history" class="btn"><%= t('collection.idx.historyBtn') %></a>
    <label style="font-size:0.9rem;"><%= t('collection.idx.engineLabel') %>
      <select id="engineSelect" style="padding:5px 8px;border:1px solid #ccc;border-radius:6px;">
        <option value="ai_llm" selected><%= t('collection.idx.engineBoth') %></option>
        <option value="ai"><%= t('collection.idx.engineMockOnly') %></option>
        <option value="llm"><%= t('collection.idx.engineLlmOnly') %></option>
      </select>
    </label>
    <label style="font-size:0.9rem;"><%= t('collection.idx.llmLabel') %>
      <select id="llmSelect" style="padding:5px 8px;border:1px solid #ccc;border-radius:6px;">
        <option value="internal"><%= t('collection.idx.llmInternal') %></option>
        <option value="haiku">Claude Haiku (92%·$)</option>
        <option value="sonnet">Claude Sonnet ($$)</option>
      </select>
    </label>
    <button class="btn primary" onclick="runAll('secums')" style="background:#27ae60;border-color:#27ae60;"><%= t('collection.idx.runAllSecums') %></button>
    <button class="btn primary" onclick="runAll('script')" style="background:#6c5ce7;border-color:#6c5ce7;"><%= t('collection.idx.runAllScript') %></button>
    <button id="retryFailedBtn" class="btn" onclick="retryFailed()" style="display:none;background:#e67e22;border-color:#e67e22;color:#fff;"><%= t('collection.idx.retryFailedBtn') %></button>
    <button class="btn" onclick="cancelBatch()" style="background:#c0392b;border-color:#c0392b;color:#fff;"><%= t('collection.idx.stopBatch') %></button>
    <button class="btn" onclick="location.reload()"><%= t('collection.idx.refresh') %></button>
  </div>
</div>

<p class="muted small" style="margin:0.5rem 0 1rem;">
  <%= t('collection.idx.intro') %>
</p>
<div id="collectionProgress" style="display:none;"></div>

<div style="display:flex;gap:8px;margin:0 0 12px;">
  <button type="button" class="btn primary collection-tab-btn" data-tab="secums" style="background:#27ae60;border-color:#27ae60;"><%= t('collection.idx.tabSecums') %></button>
  <button type="button" class="btn collection-tab-btn" data-tab="script-diagnosis"><%= t('collection.idx.tabScriptDiag') %></button>
  <button type="button" class="btn collection-tab-btn" data-tab="script"><%= t('collection.idx.tabScriptUpload') %></button>
  <button type="button" class="btn collection-tab-btn" data-tab="deploy"><%= t('collection.idx.tabDeploy') %></button>
</div>

<div id="tab-script" class="collection-tab" style="display:none;">
<div class="section-box">
  <h3><%= t('collection.idx.upload.heading') %></h3>
  <p class="muted small">
    <%= t('collection.idx.upload.desc1') %> <code>data/uploads/YYYY-MM-DD/hostname_script_YYYYMMDD.xml</code> <%= t('collection.idx.upload.desc2') %>
  </p>
  <form id="scriptUploadForm" enctype="multipart/form-data" style="display:grid;grid-template-columns:repeat(4,minmax(160px,1fr));gap:12px;align-items:end;">
    <label>
      <span class="small muted"><%= t('collection.idx.upload.serverSelect') %></span>
      <select name="server_id" id="scriptServerSelect">
        <option value=""><%= t('collection.idx.upload.manualInput') %></option>
        <% csvServers.forEach(s => { %>
          <option value="<%= s.server_id || s.ip %>" data-hostname="<%= s.hostname %>">
            <%= s.hostname %> (<%= s.ip %>)
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      <span class="small muted"><%= t('collection.idx.upload.hostname') %></span>
      <input type="text" name="hostname" id="scriptHostname" placeholder="<%= t('collection.idx.upload.hostnamePh') %>" required>
    </label>
    <label>
      <span class="small muted"><%= t('collection.idx.engineField') %></span>
      <select name="engine">
        <option value="ai_llm" selected><%= t('collection.idx.engOptAiLlm') %></option>
        <option value="llm"><%= t('collection.idx.engOptLlm') %></option>
        <option value="ai"><%= t('collection.idx.engOptAi') %></option>
      </select>
    </label>
    <label>
      <span class="small muted">Script XML</span>
      <input type="file" name="scriptfile" accept=".xml" required>
    </label>
    <label style="grid-column:1 / span 2;">
      <input type="checkbox" name="run_immediately" checked>
      <%= t('collection.idx.upload.runImmediately') %>
    </label>
    <div style="grid-column:3 / span 2;text-align:right;">
      <button type="submit" class="btn primary" style="background:#6c5ce7;border-color:#6c5ce7;"><%= t('collection.idx.upload.submit') %></button>
    </div>
  </form>
  <div id="scriptUploadResult" class="muted small" style="margin-top:10px;"></div>
</div>
</div>

<div id="tab-deploy" class="collection-tab" style="display:none;">
<div class="section-box">
  <h3><%= t('collection.idx.deploy.heading') %></h3>
  <div style="display:flex;gap:18px;margin-bottom:12px;padding:8px 10px;background:#f5f6fa;border-radius:6px;">
    <label style="display:flex;align-items:center;gap:6px;font-weight:600;">
      <input type="radio" name="deploy_kind" value="standard" checked> <%= t('collection.idx.deploy.kindStandard') %>
    </label>
    <label style="display:flex;align-items:center;gap:6px;">
      <input type="radio" name="deploy_kind" value="custom"> <%= t('collection.idx.deploy.kindCustom') %>
    </label>
  </div>
  <form id="scriptDeployForm" enctype="multipart/form-data" style="display:grid;grid-template-columns:repeat(4,minmax(160px,1fr));gap:12px;align-items:end;">
    <div style="grid-column:1 / span 4;">
      <span class="small muted"><%= t('collection.idx.deploy.serverSelect') %></span>
      <div id="deployServerList" style="display:flex;flex-wrap:wrap;gap:6px 16px;max-height:130px;overflow:auto;border:1px solid #dfe6e9;border-radius:6px;padding:8px;margin-top:4px;">
        <% if (!csvServers.length) { %>
          <span class="muted small"><%= t('collection.idx.deploy.csvEmpty') %></span>
        <% } %>
        <% if (csvServers.length) { %>
          <label class="std-only" style="display:flex;align-items:center;gap:4px;font-weight:600;">
            <input type="checkbox" id="deploySelectAll"> <%= t('collection.idx.deploy.selectAll') %>
          </label>
        <% } %>
        <% csvServers.forEach(s => { %>
          <label style="display:flex;align-items:center;gap:4px;">
            <input type="checkbox" class="deploy-check" name="deploy_server_ids" value="<%= s.server_id || s.ip %>" data-hostname="<%= s.hostname %>" data-os="<%= s.os || s.os_type || '' %>">
            <%= s.hostname %> <span class="muted small">(<%= s.ip %> · <%= s.os || s.os_type || '?' %>)</span>
          </label>
        <% }) %>
      </div>
    </div>

    <!-- 공통 -->
    <label>
      <span class="small muted"><%= t('collection.idx.engineField') %></span>
      <select name="engine">
        <option value="ai_llm" selected><%= t('collection.idx.engOptAiLlm') %></option>
        <option value="llm"><%= t('collection.idx.engOptLlm') %></option>
        <option value="ai"><%= t('collection.idx.engOptAi') %></option>
      </select>
    </label>
    <label>
      <span class="small muted"><%= t('collection.idx.deploy.execMode') %></span>
      <select name="deploy_mode">
        <option value="direct"><%= t('collection.idx.deploy.execDirect') %></option>
        <option value="agent"><%= t('collection.idx.deploy.execAgent') %></option>
      </select>
    </label>
    <label>
      <span class="small muted"><%= t('collection.idx.deploy.step') %></span>
      <select name="script_action" id="deployActionSelect">
        <option value="deploy_run_diagnose"><%= t('collection.idx.deploy.step3') %></option>
        <option value="deploy_run"><%= t('collection.idx.deploy.step2') %></option>
        <option value="deploy_only"><%= t('collection.idx.deploy.step1') %></option>
      </select>
    </label>

    <!-- 표준 모드 전용 -->
    <label class="std-only">
      <span class="small muted"><%= t('collection.idx.deploy.scanMode') %></span>
      <select name="scan_mode">
        <option value="full"><%= t('collection.idx.deploy.scanFull') %></option>
        <option value="fast"><%= t('collection.idx.deploy.scanFast') %></option>
      </select>
    </label>
    <label class="std-only" style="grid-column:1 / span 2;">
      <span class="small muted"><%= t('collection.idx.deploy.scanDirs') %></span>
      <input type="text" name="scan_dirs" placeholder="<%= t('collection.idx.deploy.scanDirsPh') %>">
    </label>
    <p class="std-only muted small" style="grid-column:1 / span 4;margin:0;">
      <%- t('collection.idx.deploy.stdNote') %>
    </p>

    <!-- DB(MSSQL) 접속정보 — 저장 시 fsi_config.ini 로 기록, 수집 스크립트가 읽음 -->
    <div class="std-only" style="grid-column:1 / span 4; border:1px solid #dbe2ea; background:#f7f9fb; border-radius:6px; padding:10px 12px; margin-top:2px;">
      <div class="small" style="font-weight:600; margin-bottom:6px;"><%= t('collection.idx.deploy.dbTitle') %>
        <span class="muted" style="font-weight:400;"><%- t('collection.idx.deploy.dbTitleNote') %></span>
      </div>
      <div class="filter-row" style="flex-wrap:wrap; gap:6px;">
        <input type="text" id="dbHost" placeholder="<%= t('collection.idx.deploy.dbHostPh') %>" style="min-width:180px;">
        <input type="text" id="dbPort" placeholder="<%= t('collection.idx.deploy.portPh') %>" value="1433" style="width:80px;">
        <input type="text" id="dbInstance" placeholder="<%= t('collection.idx.deploy.dbInstancePh') %>" style="width:130px;">
        <input type="text" id="dbUser" placeholder="<%= t('collection.idx.deploy.dbUserPh') %>" style="width:170px;">
        <input type="password" id="dbPass" placeholder="<%= t('collection.idx.deploy.dbPassPh') %>" style="width:130px;">
        <button type="button" class="btn-sm" onclick="testDb()"><%= t('collection.idx.deploy.connTest') %></button>
        <button type="button" class="btn-sm primary" onclick="saveDb()"><%= t('common.btn.save') %></button>
      </div>
      <div id="dbMsg" class="small" style="margin-top:6px;"></div>
      <div class="small" style="font-weight:600; margin:10px 0 6px;"><%= t('collection.idx.deploy.wasTitle') %> <span class="muted" style="font-weight:400;"><%= t('collection.idx.deploy.wasTitleNote1') %></span>
        <span class="muted" style="font-weight:400;"><%= t('collection.idx.deploy.wasTitleNote2') %></span>
      </div>
      <div class="filter-row" style="flex-wrap:wrap; gap:6px;">
        <input type="text" id="wasHost" placeholder="<%= t('collection.idx.deploy.wasHostPh') %>" style="min-width:180px;">
        <input type="text" id="wasPort" placeholder="<%= t('collection.idx.deploy.portPh') %>" value="8080" style="width:80px;">
        <select id="wasScheme" style="width:90px;"><option value="http">http</option><option value="https">https</option></select>
        <button type="button" class="btn-sm" onclick="testWas()"><%= t('collection.idx.deploy.connTest') %></button>
      </div>
      <div id="wasMsg" class="small" style="margin-top:6px;"></div>
    </div>
    <script>
      var DBI18N = <%- JSON.stringify({
        testing: t('collection.js.dbTesting'),
        savedPh: t('collection.js.dbSavedPh'),
        connOk: t('collection.js.connOk'),
        connFail: t('collection.js.connFail'),
        err: t('collection.js.errPrefix'),
        saving: t('collection.js.dbSaving'),
        savedPrefix: t('collection.js.dbSavedPrefix'),
        savedSuffix: t('collection.js.dbSavedSuffix'),
        saveFail: t('collection.js.dbSaveFail')
      }) %>;
      (function(){
        fetch('/db-config').then(function(r){return r.json();}).then(function(c){
          if(!c) return;
          if(c.host) document.getElementById('dbHost').value = c.host;
          if(c.port) document.getElementById('dbPort').value = c.port;
          if(c.instance) document.getElementById('dbInstance').value = c.instance;
          if(c.user) document.getElementById('dbUser').value = c.user;
          if(c.has_password) document.getElementById('dbPass').placeholder = DBI18N.savedPh;
        }).catch(function(){});
      })();
      function _dbBody(){ return { host:document.getElementById('dbHost').value.trim(), port:document.getElementById('dbPort').value.trim(), instance:document.getElementById('dbInstance').value.trim(), user:document.getElementById('dbUser').value.trim(), password:document.getElementById('dbPass').value }; }
      function testDb(){
        var m=document.getElementById('dbMsg'); m.style.color='#666'; m.textContent=DBI18N.testing;
        fetch('/connection-test/db',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(_dbBody())})
          .then(function(r){return r.json();}).then(function(j){
            if(j.ok){ m.style.color='#1e824c'; m.textContent=DBI18N.connOk+' ('+(j.server||'')+') · '+(j.version||''); }
            else { m.style.color='#c0392b'; m.textContent=DBI18N.connFail+' ('+(j.server||'')+'): '+(j.error||''); }
          }).catch(function(e){ m.style.color='#c0392b'; m.textContent=DBI18N.err+e; });
      }
      function saveDb(){
        var m=document.getElementById('dbMsg'); m.style.color='#666'; m.textContent=DBI18N.saving;
        fetch('/db-config/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(_dbBody())})
          .then(function(r){return r.json();}).then(function(j){
            if(j.status==='success'){ m.style.color='#1e824c'; m.textContent=DBI18N.savedPrefix+j.path+DBI18N.savedSuffix; }
            else { m.style.color='#c0392b'; m.textContent=DBI18N.saveFail+(j.error||''); }
          }).catch(function(e){ m.style.color='#c0392b'; m.textContent=DBI18N.err+e; });
      }
      function testWas(){
        var m=document.getElementById('wasMsg'); m.style.color='#666'; m.textContent=DBI18N.testing;
        var body={ host:document.getElementById('wasHost').value.trim(), port:document.getElementById('wasPort').value.trim(), scheme:document.getElementById('wasScheme').value };
        fetch('/connection-test/was',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
          .then(function(r){return r.json();}).then(function(j){
            if(j.ok){ m.style.color='#1e824c'; m.textContent=DBI18N.connOk+' ('+(j.endpoint||'')+') · HTTP '+(j.status||'')+' · Server: '+(j.server||''); }
            else { m.style.color='#c0392b'; m.textContent=DBI18N.connFail+' ('+(j.endpoint||'')+'): '+(j.error||''); }
          }).catch(function(e){ m.style.color='#c0392b'; m.textContent=DBI18N.err+e; });
      }
    </script>

    <!-- 커스텀(단일) 모드 전용 -->
    <label class="custom-only" style="grid-column:1 / span 2;">
      <span class="small muted"><%= t('collection.idx.deploy.customHostname') %></span>
      <input type="text" name="hostname" id="deployHostname" placeholder="<%= t('collection.idx.upload.hostnamePh') %>">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.remoteUser') %></span>
      <input type="text" name="remote_username" id="deployRemoteUsername" placeholder="<%= t('collection.idx.deploy.remoteUserPh') %>">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.remotePass') %></span>
      <input type="password" name="remote_password" autocomplete="off" placeholder="<%= t('collection.idx.deploy.remotePassPh') %>">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.remotePort') %></span>
      <input type="number" name="remote_port" id="deployRemotePort" min="1" max="65535" placeholder="<%= t('collection.idx.deploy.remotePortPh') %>">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.sshKey') %></span>
      <input type="text" name="remote_ssh_key_path" placeholder="<%= t('collection.idx.deploy.sshKeyPh') %>">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.scriptArgs') %></span>
      <input type="text" name="script_args" placeholder="<%= t('collection.idx.deploy.scriptArgsPh') %>">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.zipEntry') %></span>
      <input type="text" name="package_script" placeholder="<%= t('collection.idx.deploy.zipEntryPh') %>">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.resultGlob') %></span>
      <input type="text" name="result_glob" value="*.xml">
    </label>
    <label class="custom-only">
      <span class="small muted"><%= t('collection.idx.deploy.deployScript') %></span>
      <input type="file" name="deploy_script" accept=".sh,.bash,.ps1,.bat,.cmd,.py,.pl,.xml,.zip">
    </label>

    <!-- 공통: 작업 폴더(비우면 OS별 기본값) -->
    <label style="grid-column:1 / span 2;">
      <span class="small muted"><%= t('collection.idx.deploy.workDir') %></span>
      <input type="text" name="remote_work_dir" placeholder="<%= t('collection.idx.deploy.workDirPh') %>">
    </label>

    <!-- 공통: Windows 원격 방식 (Linux 대상은 항상 SSH — 이 옵션 무시) -->
    <label style="grid-column:3 / span 2;">
      <span class="small muted"><%= t('collection.idx.deploy.winTransport') %></span>
      <select name="remote_transport">
        <option value=""><%= t('collection.idx.deploy.winTransportDefault') %></option>
        <option value="winrm">WinRM</option>
        <option value="ssh">SSH (OpenSSH)</option>
      </select>
    </label>

    <div style="grid-column:1 / span 4;text-align:right;">
      <button type="submit" class="btn primary" style="background:#0984e3;border-color:#0984e3;"><%= t('collection.idx.deploy.submit') %></button>
    </div>
  </form>
  <p class="muted small" style="margin-top:8px;"><%- t('collection.idx.deploy.footNote') %></p>
  <div id="scriptDeployResult" class="muted small" style="margin-top:10px;"></div>
</div>

<h2 style="margin-top:1.5rem;"><%= t('collection.idx.deploy.recentJobs', { n: deployJobs.length }) %></h2>
<% if (deployJobs.length === 0) { %>
  <p class="muted"><%= t('collection.idx.deploy.noJobs') %></p>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th><%= t('collection.idx.deploy.thStatus') %></th><th><%= t('collection.idx.deploy.thProgress') %></th><th><%= t('collection.idx.deploy.thHost') %></th><th>Script</th><th><%= t('collection.idx.deploy.thResult') %></th><th><%= t('collection.idx.deploy.thDiag') %></th><th><%= t('collection.idx.deploy.thCreated') %></th>
      </tr>
    </thead>
    <tbody>
      <% deployJobs.forEach(j => { %>
        <tr>
          <td><span class="badge"><%= td(j.status) %></span></td>
          <td class="small">
            <% const pct = Math.max(0, Math.min(100, Number(j.progress_percent || 0))); %>
            <span class="progress-mini"><span style="width:<%= pct %>%;"></span></span><%= pct %>%
            <% if (j.progress_message || j.agent_message) { %>
              <br><span class="muted"><%= j.progress_message || j.agent_message %></span>
            <% } %>
          </td>
          <td><strong><%= j.hostname %></strong><br><span class="small muted"><%= j.ip || '' %></span></td>
          <td class="small"><%= j.original_name || j.script_file %><br><code><%= j.job_id %></code></td>
          <td class="small"><%= j.result_file || '-' %></td>
          <td>
            <% if (j.assessment_id) { %>
              <a href="/diagnosis/<%= j.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;">#<%= j.assessment_id %></a>
            <% } else { %>
              <span class="muted small"><%= j.diagnose_error || '-' %></span>
            <% } %>
          </td>
          <td class="small"><%= j.created_at || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
</div>

<div id="tab-secums" class="collection-tab">
<div style="display:flex;align-items:center;justify-content:space-between;margin-top:1.5rem;">
  <h2 style="margin:0;"><%= t('collection.idx.servers.heading', { n: csvServers.length }) %></h2>
  <button type="button" class="btn primary" onclick="runSelected('secums')" style="background:#27ae60;border-color:#27ae60;"><%= t('collection.idx.servers.runSelectedSecums') %></button>
</div>
<% if (csvServers.length === 0) { %>
  <p class="muted" style="padding:1rem;background:#fffbe6;border-left:3px solid #f1c40f;">
    <%- t('collection.idx.servers.csvMissing') %>
  </p>
<% } else { %>
  <input type="search" class="server-search" data-target="tab-secums" placeholder="<%= t('collection.idx.servers.searchPh') %>" style="margin:8px 0;padding:6px 10px;border:1px solid #ccc;border-radius:6px;width:320px;">
  <table class="data-table">
    <thead>
      <tr>
        <th style="width:32px;"><input type="checkbox" class="diag-all" data-tab="tab-secums"></th>
        <th><%= t('collection.idx.servers.thHost') %></th><th>IP</th><th>OS</th><th><%= t('collection.idx.servers.thUser') %></th><th><%= t('collection.idx.servers.thAsset') %></th>
      </tr>
    </thead>
    <tbody>
      <% csvServers.forEach(s => { %>
        <tr data-search="<%= (s.hostname + ' ' + s.ip + ' ' + s.os + ' ' + (s.username || '') + ' ' + (s.asset_no || '')).toLowerCase() %>">
          <td><input type="checkbox" class="diag-check" data-tab="tab-secums" value="<%= s.server_id || s.ip %>"></td>
          <td><strong><%= s.hostname %></strong></td>
          <td class="mono small"><%= s.ip %></td>
          <td><%= s.os %></td>
          <td class="small"><%= s.username %></td>
          <td class="small"><%= s.asset_no %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
</div>

<div id="tab-script-diagnosis" class="collection-tab" style="display:none;">
<div style="display:flex;align-items:center;justify-content:space-between;margin-top:1.5rem;">
  <h2 style="margin:0;"><%= t('collection.idx.servers.heading', { n: csvServers.length }) %></h2>
  <button type="button" class="btn primary" onclick="runSelected('script')" style="background:#6c5ce7;border-color:#6c5ce7;"><%= t('collection.idx.servers.runSelectedScript') %></button>
</div>
<% if (csvServers.length === 0) { %>
  <p class="muted" style="padding:1rem;background:#fffbe6;border-left:3px solid #f1c40f;">
    <%- t('collection.idx.servers.csvMissing') %>
  </p>
<% } else { %>
  <input type="search" class="server-search" data-target="tab-script-diagnosis" placeholder="<%= t('collection.idx.servers.searchPh') %>" style="margin:8px 0;padding:6px 10px;border:1px solid #ccc;border-radius:6px;width:320px;">
  <table class="data-table">
    <thead>
      <tr>
        <th style="width:32px;"><input type="checkbox" class="diag-all" data-tab="tab-script-diagnosis"></th>
        <th><%= t('collection.idx.servers.thHost') %></th><th>IP</th><th>OS</th><th><%= t('collection.idx.servers.thUser') %></th><th><%= t('collection.idx.servers.thAsset') %></th>
      </tr>
    </thead>
    <tbody>
      <% csvServers.forEach(s => { %>
        <tr data-search="<%= (s.hostname + ' ' + s.ip + ' ' + s.os + ' ' + (s.username || '') + ' ' + (s.asset_no || '')).toLowerCase() %>">
          <td><input type="checkbox" class="diag-check" data-tab="tab-script-diagnosis" value="<%= s.server_id || s.ip %>"></td>
          <td><strong><%= s.hostname %></strong></td>
          <td class="mono small"><%= s.ip %></td>
          <td><%= s.os %></td>
          <td class="small"><%= s.username %></td>
          <td class="small"><%= s.asset_no %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
</div>

<script>
<%
  const I18N_KEYS = ['preparing','retryBtn','noRetryTargets','retryConfirm','proceed','retryProgress','retryDoneMsg','retryDoneAlert','retryFailMsg','retryFailAlert','netErr','hourUnit','minUnit','secUnit','lineCount','lineOk','lineFetchedOnly','lineFail','sending','llmWorking','elapsedPrefix','doneDefault','totalElapsed','failDefault','pollFail','uploading','uploadFail','uploadProgress','uploadDoneMsg','donePrefix','diagIdSuffix','uploadDiagDoneAlert','savedPrefix','uploadDoneAlert','errPrefix','uploadFailAlert','selectOneServer','stdConfirm','customNeedsFile','customSingleOnly','selectOrType','progressBtn','deployProgress','deployRegFail','diagRef','registered','deployDoneAlert','cancelConfirm','cancelRequested','cancelFail','fetchRunConfirm','fetchRunProgress','diagDone','fetchRunDoneAlert','procFail','fetchFailPrefix','diagFailPrefix','unknownErr','procFailAlert','runAllConfirm','running','runAllProgress','runAllDone','runAllDoneAlert','retryHint','runAllFailAlert','selConfirm','selProgress','selDone','selDoneAlert','selFailAlert'];
  const I18N_OBJ = {};
  I18N_KEYS.forEach(k => { I18N_OBJ[k] = t('collection.js.' + k); });
%>
var I18N = <%- JSON.stringify(I18N_OBJ) %>;
function tf(s, p) {
  s = String(s);
  if (p) for (var k in p) s = s.split('{' + k + '}').join(p[k]);
  return s;
}
function clampProgress(value) {
  const n = Number(value);
  if (!Number.isFinite(n)) return 0;
  return Math.max(0, Math.min(100, Math.round(n)));
}

function createProgress(target, title) {
  const el = typeof target === 'string' ? document.getElementById(target) : target;
  if (!el) return null;
  el.style.display = '';
  el.innerHTML =
    '<div class="progress-panel">' +
      '<div class="progress-row">' +
        '<span class="progress-title">' + title + '</span>' +
        '<span class="progress-percent">0%</span>' +
      '</div>' +
      '<div class="progress-track"><div class="progress-fill"></div></div>' +
      '<div class="progress-message small">' + I18N.preparing + '</div>' +
    '</div>';
  return el.querySelector('.progress-panel');
}

function setProgress(panel, percent, message) {
  if (!panel) return;
  const pct = clampProgress(percent);
  const fill = panel.querySelector('.progress-fill');
  const pctEl = panel.querySelector('.progress-percent');
  const msgEl = panel.querySelector('.progress-message');
  if (fill) fill.style.width = pct + '%';
  if (pctEl) pctEl.textContent = pct + '%';
  if (msgEl && message) msgEl.textContent = message;
}

function selectedLlm() {
  var el = document.getElementById('llmSelect');
  return el ? el.value : 'internal';
}
function selectedEngine() {
  var el = document.getElementById('engineSelect');
  return el ? el.value : 'ai_llm';   // mock+LLM 기본
}
var _lastFailed = null; // { source, ids:[ip...] }
function trackFailed(source, results) {
  var failed = (results || []).filter(function(r){ return r.fetch_status === 'failed' || r.diagnose_status === 'failed'; });
  var btn = document.getElementById('retryFailedBtn');
  if (failed.length) {
    _lastFailed = { source: source, ids: failed.map(function(r){ return String(r.ip || r.hostname); }) };
    if (btn) { btn.style.display = ''; btn.textContent = tf(I18N.retryBtn, { n: failed.length }); }
  } else {
    _lastFailed = null;
    if (btn) btn.style.display = 'none';
  }
}
async function retryFailed() {
  if (!_lastFailed || !_lastFailed.ids.length) { alert(I18N.noRetryTargets); return; }
  if (!confirm(tf(I18N.retryConfirm, { n: _lastFailed.ids.length, label: diagnosisSourceLabel(_lastFailed.source) }) + '\n' + _lastFailed.ids.join(', ') + '\n' + I18N.proceed)) return;
  var progress = startSoftProgress('collectionProgress', tf(I18N.retryProgress, { n: _lastFailed.ids.length }), 5, 95);
  var startedAt = new Date();
  try {
    var res = await fetch('/scheduler/run-all', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ source: _lastFailed.source, server_ids: _lastFailed.ids, llm: selectedLlm(), engine: selectedEngine() }),
    });
    var data = await res.json();
    if (data.status === 'completed' || data.status === 'cancelled') {
      var endedAt = new Date();
      progress.done(I18N.retryDoneMsg);
      var s = data.summary;
      alert(tf(I18N.retryDoneAlert, { success: s.success, fetchedOnly: s.fetched_only, failed: s.failed }) + timingLines(startedAt, endedAt) + '\n' + serverLines(data.results));
      trackFailed(_lastFailed.source, data.results);
      location.reload();
    } else {
      progress.fail(data.error || I18N.retryFailMsg);
      alert(I18N.retryFailAlert + (data.error || '?'));
    }
  } catch (e) { progress.fail(e.message); alert(I18N.netErr + e.message); }
}
function fmtElapsed(t0) {
  const s = Math.max(0, Math.floor((Date.now() - t0) / 1000));
  return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
}
function fmtClock(d) {
  d = d || new Date();
  return String(d.getHours()).padStart(2, '0') + ':' +
         String(d.getMinutes()).padStart(2, '0') + ':' +
         String(d.getSeconds()).padStart(2, '0');
}
function fmtDuration(ms) {
  const s = Math.max(0, Math.floor(ms / 1000));
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  return (h ? h + I18N.hourUnit : '') + (h || m ? m + I18N.minUnit : '') + sec + I18N.secUnit;
}
function timingLines(startedAt, endedAt) {
  return '\n⏱ ' + fmtClock(startedAt) + ' → ' + fmtClock(endedAt) + ' (' + fmtDuration(endedAt - startedAt) + ')';
}
function serverLines(results) {
  if (!Array.isArray(results) || !results.length) return '';
  // 실패/수집만을 위에, 성공을 아래에 (중요한 것 먼저)
  var ordered = results.slice().sort(function(a, b) {
    var ra = (a.diagnose_status === 'success') ? 1 : 0;
    var rb = (b.diagnose_status === 'success') ? 1 : 0;
    return ra - rb;
  });
  return '\n' + ordered.map(function(r) {
    var ok = r.diagnose_status === 'success';
    var fetchedOnly = r.fetch_status === 'success' && r.diagnose_status === 'skipped';
    var icon = ok ? '✅' : (fetchedOnly ? '📥' : '❌');
    var s = r.summary || {};
    var total = (s.total != null ? s.total : s.total_count);
    var cnt = (ok && total != null)
      ? tf(I18N.lineCount, { total: total, vuln: (s.vuln != null ? s.vuln : (s.vuln_count||0)), safe: (s.safe != null ? s.safe : (s.safe_count||0)), na: (s.na != null ? s.na : (s.na_count||0)) })
      : '';
    var label = ok ? (I18N.lineOk + (r.assessment_id ? ' #' + r.assessment_id : '') + cnt)
                   : (fetchedOnly ? I18N.lineFetchedOnly : I18N.lineFail);
    var reason = (!ok && !fetchedOnly && r.error) ? ' — ' + r.error : '';
    return icon + ' ' + (r.hostname || r.ip || '?') + ' · ' + label + reason;
  }).join('\n');
}
function startSoftProgress(target, title, start, maxBeforeDone) {
  const panel = createProgress(target, title);
  let pct = clampProgress(start || 8);
  const max = clampProgress(maxBeforeDone || 92);
  const t0 = Date.now();
  let lastMsg = I18N.sending;
  function render() { setProgress(panel, pct, lastMsg + I18N.elapsedPrefix + fmtElapsed(t0)); }
  render();
  const timer = setInterval(function() {
    if (pct < max) {
      pct = Math.min(max, pct + Math.max(1, Math.round((max - pct) * 0.08)));
    } else {
      lastMsg = I18N.llmWorking;
    }
    render();
  }, 1000);
  return {
    panel,
    set: function(nextPct, message) {
      pct = clampProgress(nextPct);
      if (message) lastMsg = message;
      render();
    },
    done: function(message) {
      clearInterval(timer);
      setProgress(panel, 100, (message || I18N.doneDefault) + I18N.totalElapsed + fmtElapsed(t0));
    },
    fail: function(message) {
      clearInterval(timer);
      setProgress(panel, 100, (message || I18N.failDefault) + I18N.elapsedPrefix + fmtElapsed(t0));
      const fill = panel && panel.querySelector('.progress-fill');
      if (fill) fill.style.background = '#d63031';
    },
    stop: function() {
      clearInterval(timer);
    },
  };
}

function isTerminalDeployStatus(status) {
  return ['completed', 'diagnosed', 'failed', 'diagnosis_failed'].includes(String(status || ''));
}

async function pollDeployProgress(jobId, progress) {
  for (let i = 0; i < 120; i += 1) {
    const res = await fetch('/collection/script-deploy/' + encodeURIComponent(jobId) + '/status');
    const data = await res.json();
    if (!res.ok || data.status !== 'success') throw new Error(data.error || I18N.pollFail);
    progress.set(data.progress_percent, data.progress_message || data.job_status);
    if (isTerminalDeployStatus(data.job_status)) return data;
    await new Promise(function(resolve) { setTimeout(resolve, 2000); });
  }
  return null;
}

document.querySelectorAll('.collection-tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    const tab = this.getAttribute('data-tab');
    document.querySelectorAll('.collection-tab').forEach(function(panel) {
      panel.style.display = panel.id === 'tab-' + tab ? '' : 'none';
    });
    document.querySelectorAll('.collection-tab-btn').forEach(function(b) {
      b.classList.remove('primary');
      b.style.background = '';
      b.style.borderColor = '';
    });
    this.classList.add('primary');
    if (tab === 'secums') {
      this.style.background = '#27ae60';
      this.style.borderColor = '#27ae60';
    } else if (tab === 'script-diagnosis') {
      this.style.background = '#6c5ce7';
      this.style.borderColor = '#6c5ce7';
    } else if (tab === 'deploy') {
      this.style.background = '#0984e3';
      this.style.borderColor = '#0984e3';
    }
  });
});

const scriptServerSelect = document.getElementById('scriptServerSelect');
if (scriptServerSelect) {
  scriptServerSelect.addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    const hostname = opt ? opt.getAttribute('data-hostname') : '';
    if (hostname) document.getElementById('scriptHostname').value = hostname;
  });
}

// 배포 탭: 전체 선택 체크박스
const deploySelectAll = document.getElementById('deploySelectAll');
if (deploySelectAll) {
  deploySelectAll.addEventListener('change', function() {
    if (deployKind() !== 'standard') return; // 커스텀(단일)에선 전체선택 무시
    document.querySelectorAll('.deploy-check').forEach(function(c) { c.checked = deploySelectAll.checked; });
  });
}

// 배포 탭: 표준/커스텀 모드 토글
function deployKind() {
  const r = document.querySelector('input[name="deploy_kind"]:checked');
  return r ? r.value : 'standard';
}
function applyDeployKind() {
  const kind = deployKind();
  const std = kind === 'standard';
  document.querySelectorAll('#tab-deploy .std-only').forEach(function(el) { el.style.display = std ? '' : 'none'; });
  document.querySelectorAll('#tab-deploy .custom-only').forEach(function(el) { el.style.display = std ? 'none' : ''; });
  // 커스텀(단일): 체크는 한 대만 유지
  if (!std) {
    const checked = document.querySelectorAll('.deploy-check:checked');
    for (let i = 1; i < checked.length; i += 1) checked[i].checked = false;
    if (deploySelectAll) deploySelectAll.checked = false;
  }
}
document.querySelectorAll('input[name="deploy_kind"]').forEach(function(r) {
  r.addEventListener('change', applyDeployKind);
});
document.querySelectorAll('.deploy-check').forEach(function(c) {
  c.addEventListener('change', function() {
    if (deployKind() === 'custom' && this.checked) {
      document.querySelectorAll('.deploy-check').forEach(function(o) { if (o !== c) o.checked = false; });
    }
  });
});
applyDeployKind();

// 진단 탭(SecuMS/Script): 표 머리글 전체 선택 체크박스
document.querySelectorAll('.diag-all').forEach(function(master) {
  master.addEventListener('change', function() {
    const tabId = this.getAttribute('data-tab');
    document.querySelectorAll('#' + tabId + ' .diag-check').forEach(function(c) { c.checked = master.checked; });
  });
});

const scriptUploadForm = document.getElementById('scriptUploadForm');
if (scriptUploadForm) {
  scriptUploadForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const resultBox = document.getElementById('scriptUploadResult');
    const btn = this.querySelector('button[type="submit"]');
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = I18N.uploading;
    resultBox.textContent = '';
    const progress = startSoftProgress(resultBox, I18N.uploadProgress, 8, 92);
    try {
      const res = await fetch('/collection/script-upload', {
        method: 'POST',
        body: new FormData(this),
      });
      const data = await res.json();
      if (!res.ok || data.status !== 'success') {
        throw new Error(data.error || I18N.uploadFail);
      }
      progress.done(I18N.uploadDoneMsg);
      let msg = I18N.donePrefix + data.saved_path;
      if (data.assessment_id) {
        msg += I18N.diagIdSuffix + data.assessment_id;
        alert(I18N.uploadDiagDoneAlert + (data.message || '') + I18N.savedPrefix + data.saved_path);
        location.href = '/diagnosis/' + data.assessment_id + '/ai';
      } else {
        alert(I18N.uploadDoneAlert + data.saved_path);
      }
      resultBox.textContent = msg;
    } catch (err) {
      progress.fail(err.message);
      resultBox.textContent = I18N.errPrefix + err.message;
      alert(I18N.uploadFailAlert + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = orig;
    }
  });
}

const scriptDeployForm = document.getElementById('scriptDeployForm');
if (scriptDeployForm) {
  scriptDeployForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const resultBox = document.getElementById('scriptDeployResult');
    const btn = this.querySelector('button[type="submit"]');
    const orig = btn.textContent;

    const kind = deployKind();
    const checks = Array.prototype.slice.call(this.querySelectorAll('.deploy-check:checked'));
    let targets;
    const standard = kind === 'standard';

    if (standard) {
      // 표준: 체크한 서버들 → OS별 표준 스크립트 자동, csv 인증
      if (!checks.length) { alert(I18N.selectOneServer); return; }
      targets = checks.map(function(c) { return { id: c.value, hostname: c.getAttribute('data-hostname') || '' }; });
      if (targets.length > 1 && !confirm(tf(I18N.stdConfirm, { n: targets.length }) + '\n' + I18N.proceed)) return;
    } else {
      // 커스텀: 단일 서버 + 업로드 파일 필수
      if (!this.querySelector('input[name="deploy_script"]').files.length) { alert(I18N.customNeedsFile); return; }
      if (checks.length > 1) { alert(I18N.customSingleOnly); return; }
      if (checks.length === 1) {
        targets = [{ id: checks[0].value, hostname: checks[0].getAttribute('data-hostname') || '' }];
      } else {
        const manualHost = (document.getElementById('deployHostname').value || '').trim();
        if (!manualHost) { alert(I18N.selectOrType); return; }
        targets = [{ id: '', hostname: manualHost }];
      }
    }

    btn.disabled = true;
    resultBox.innerHTML = '';
    const summary = [];
    let lastAssessmentId = null;
    for (let i = 0; i < targets.length; i += 1) {
      const t = targets[i];
      const tag = t.hostname || t.id;
      btn.textContent = tf(I18N.progressBtn, { i: i + 1, n: targets.length });
      const progress = startSoftProgress(resultBox, tf(I18N.deployProgress, { tag: tag, i: i + 1, n: targets.length }), 8, 92);
      try {
        const fd = new FormData(scriptDeployForm);
        fd.delete('deploy_server_ids');
        fd.set('server_id', t.id);
        fd.set('hostname', t.hostname);
        if (standard) {
          // OS별 표준 스크립트 자동 + csv 인증: 파일·일회성 인증·커스텀 인자 제거
          fd.delete('deploy_script');
          fd.delete('remote_username');
          fd.delete('remote_password');
          fd.delete('remote_ssh_key_path');
          fd.delete('remote_port');
          fd.delete('script_args');
          fd.delete('package_script');
          fd.delete('result_glob');
          fd.set('use_standard_script', '1');
        } else {
          fd.delete('scan_mode');
          fd.delete('scan_dirs');
        }
        const res = await fetch('/collection/script-deploy', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok || data.status !== 'success') throw new Error(data.error || I18N.deployRegFail);
        if (data.job_id && !isTerminalDeployStatus(data.deploy_status || data.job_status)) {
          progress.stop();
          const latest = await pollDeployProgress(data.job_id, progress);
          if (latest && latest.assessment_id) data.assessment_id = latest.assessment_id;
        }
        progress.done(I18N.doneDefault);
        lastAssessmentId = data.assessment_id || lastAssessmentId;
        summary.push('✅ ' + tag + (data.assessment_id ? I18N.diagRef + data.assessment_id : ' (' + (data.deploy_status || I18N.registered) + ')'));
      } catch (err) {
        progress.fail(err.message);
        summary.push('❌ ' + tag + ' : ' + err.message);
      }
    }
    resultBox.innerHTML = summary.join('<br>');
    btn.disabled = false;
    btn.textContent = orig;
    alert(tf(I18N.deployDoneAlert, { n: targets.length }) + summary.join('\n'));
    if (targets.length === 1 && lastAssessmentId) {
      location.href = '/diagnosis/' + lastAssessmentId + '/ai';
    } else {
      location.reload();
    }
  });
}

function diagnosisSourceLabel(source) {
  return source === 'script' ? 'Script XML' : 'SecuMS raw DB';
}

async function cancelBatch() {
  if (!confirm(I18N.cancelConfirm)) return;
  try {
    const res = await fetch('/scheduler/cancel', { method: 'POST' });
    const data = await res.json();
    alert(data.message || I18N.cancelRequested);
  } catch (e) {
    alert(I18N.cancelFail + e.message);
  }
}

async function fetchAndRun(serverId, hostname, source) {
  source = source || 'secums';
  const label = diagnosisSourceLabel(source);
  if (!confirm(tf(I18N.fetchRunConfirm, { hostname: hostname, label: label }) + '\n' + I18N.proceed)) return;
  const btns = document.querySelectorAll('button[onclick*="fetchAndRun"]');
  btns.forEach(function(b) { b.disabled = true; });
  const progress = startSoftProgress('collectionProgress', tf(I18N.fetchRunProgress, { hostname: hostname, label: label }), 8, 92);
  const startedAt = new Date();
  try {
    const res = await fetch('/diagnosis/fetch-and-run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ server_id: serverId, source: source, llm: selectedLlm() }),
    });
    const data = await res.json();
    if (data.status === 'success') {
      const endedAt = new Date();
      progress.done(tf(I18N.diagDone, { label: label }));
      const s = data.summary || {};
      alert(tf(I18N.fetchRunDoneAlert, { hostname: data.hostname, label: label, vuln: s.vuln, safe: s.safe, info: (s.info || 0), rate: s.agreement_rate, vf: (s.validation_failure_rate || 0) }) + timingLines(startedAt, endedAt));
      location.href = '/diagnosis/' + data.assessment_id + '/ai';
    } else {
      progress.fail(I18N.procFail);
      const reason = data.fetch_status === 'failed' ? I18N.fetchFailPrefix + data.fetch_error :
                     data.diagnose_status === 'failed' ? I18N.diagFailPrefix + data.diagnose_error :
                     data.error || I18N.unknownErr;
      alert(tf(I18N.procFailAlert, { hostname: (data.hostname || hostname) }) + reason);
    }
  } catch (e) {
    progress.fail(e.message);
    alert(I18N.netErr + e.message);
  } finally {
    btns.forEach(function(b) { b.disabled = false; });
  }
}

async function runAll(source) {
  source = source || 'secums';
  const label = diagnosisSourceLabel(source);
  if (!confirm(tf(I18N.runAllConfirm, { label: label }))) return;
  const btn = event.target;
  const orig = btn.textContent;
  btn.disabled = true;
  btn.textContent = I18N.running;
  const progress = startSoftProgress('collectionProgress', tf(I18N.runAllProgress, { label: label }), 5, 95);
  const startedAt = new Date();
  try {
    const res = await fetch('/scheduler/run-all', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ source: source, llm: selectedLlm(), engine: selectedEngine() }),
    });
    const data = await res.json();
    if (data.status === 'completed') {
      const endedAt = new Date();
      progress.done(I18N.runAllDone);
      const s = data.summary;
      let msg = tf(I18N.runAllDoneAlert, { total: s.total, success: s.success, fetchedOnly: s.fetched_only, failed: s.failed }) + timingLines(startedAt, endedAt) + '\n' + serverLines(data.results);
      trackFailed(source, data.results);
      alert(msg + (s.failed ? tf(I18N.retryHint, { n: s.failed }) : ''));
      if (!s.failed) location.href = '/collection/history';
    } else {
      progress.fail(data.error || I18N.procFail);
      alert(I18N.runAllFailAlert + (data.error || '?'));
    }
  } catch (e) {
    progress.fail(e.message);
    alert(I18N.netErr + e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = orig;
  }
}

// 서버 표 검색 (호스트/IP/OS/사용자/자산번호)
document.addEventListener('input', function (e) {
  if (!e.target.classList || !e.target.classList.contains('server-search')) return;
  var tabId = e.target.getAttribute('data-target');
  var q = e.target.value.trim().toLowerCase();
  document.querySelectorAll('#' + tabId + ' tbody tr').forEach(function (tr) {
    var hay = tr.getAttribute('data-search') || '';
    tr.style.display = (!q || hay.indexOf(q) !== -1) ? '' : 'none';
  });
});

async function runSelected(source) {
  source = source || 'secums';
  const tabId = source === 'secums' ? 'tab-secums' : 'tab-script-diagnosis';
  const label = diagnosisSourceLabel(source);
  const ids = Array.prototype.slice.call(document.querySelectorAll('#' + tabId + ' .diag-check:checked')).map(function(c) { return c.value; });
  if (!ids.length) { alert(I18N.selectOneServer); return; }
  if (!confirm(tf(I18N.selConfirm, { n: ids.length, label: label }))) return;
  const progress = startSoftProgress('collectionProgress', tf(I18N.selProgress, { n: ids.length, label: label }), 5, 95);
  const startedAt = new Date();
  try {
    const res = await fetch('/scheduler/run-all', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ source: source, server_ids: ids, llm: selectedLlm(), engine: selectedEngine() }),
    });
    const data = await res.json();
    if (data.status === 'completed') {
      const endedAt = new Date();
      progress.done(I18N.selDone);
      const s = data.summary;
      alert(tf(I18N.selDoneAlert, { n: ids.length, total: s.total, success: s.success, fetchedOnly: s.fetched_only, failed: s.failed }) + timingLines(startedAt, endedAt) + '\n' + serverLines(data.results));
      location.href = '/collection/history';
    } else {
      progress.fail(data.error || I18N.procFail);
      alert(I18N.selFailAlert + (data.error || '?'));
    }
  } catch (e) {
    progress.fail(e.message);
    alert(I18N.netErr + e.message);
  }
}
</script>

