<%- include('../_header', { title: t('collection.hist.title'), activeMenu: 'collection' }) %>

<div class="page-header">
  <h1><%= t('collection.hist.heading') %></h1>
  <div class="header-actions">
    <a href="/collection" class="btn"><%= t('collection.hist.toManage') %></a>
    <button class="btn" onclick="location.reload()"><%= t('collection.idx.refresh') %></button>
  </div>
</div>

<p class="muted small">
  <%- t('collection.hist.summary', { recent: history.length, total: total }) %>
</p>

<div class="section-box">
  <div class="filter-row">
    <input type="search" id="historySearch" placeholder="<%= t('collection.hist.searchPh') %>">
    <select id="historyFetch">
      <option value=""><%= t('collection.hist.fetchAll') %></option>
      <option value="success"><%= t('collection.hist.fetchSuccess') %></option>
      <option value="failed"><%= t('collection.hist.fetchFailed') %></option>
    </select>
    <select id="historyDiagnose">
      <option value=""><%= t('collection.hist.diagAll') %></option>
      <option value="success"><%= t('collection.hist.diagSuccess') %></option>
      <option value="failed"><%= t('collection.hist.diagFailed') %></option>
      <option value="skipped"><%= t('collection.hist.skipped') %></option>
    </select>
    <select id="historySource">
      <option value=""><%= t('collection.hist.sourceAll') %></option>
      <option value="secums">SecuMS</option>
      <option value="script">Script</option>
      <option value="script_deploy"><%= t('collection.hist.sourceScriptDeploy') %></option>
      <option value="both">SecuMS+Script</option>
    </select>
    <input type="date" id="historyFrom">
    <input type="date" id="historyTo">
    <button class="btn-sm" onclick="applyHistoryFilter()"><%= t('collection.hist.applyFilter') %></button>
    <button class="btn-sm" onclick="resetHistoryFilter()"><%= t('collection.hist.resetFilter') %></button>
  </div>
</div>

<table class="data-table" id="collectionHistoryTable">
  <thead>
    <tr>
      <th style="width:140px;"><%= t('collection.hist.thStarted') %></th>
      <th><%= t('collection.hist.thHost') %></th><th style="width:110px;">IP</th><th style="width:70px;">OS</th>
      <th style="width:80px;"><%= t('collection.hist.thFetch') %></th><th style="width:80px;"><%= t('collection.hist.thDiag') %></th>
      <th style="width:90px;"><%= t('collection.hist.thResultId') %></th><th><%= t('collection.hist.thSummary') %></th><th style="width:80px;"><%= t('collection.hist.thElapsed') %></th>
    </tr>
  </thead>
  <tbody>
    <% if (!history.length) { %>
      <tr>
        <td colspan="9" class="empty" style="padding:40px;text-align:center;">
          <%= t('collection.hist.empty1') %><br>
          <span class="muted small"><%- t('collection.hist.empty2') %></span>
        </td>
      </tr>
    <% } %>
    <% history.forEach(h => { %>
      <tr data-fetch="<%= h.fetch_status || '' %>"
          data-diagnose="<%= h.diagnose_status || '' %>"
          data-source="<%= h.source_type || '' %>"
          data-date="<%= (h.started_at || '').slice(0, 10) %>"
          data-search="<%= ((h.hostname || '') + ' ' + (h.ip || '') + ' ' + (h.os || '') + ' ' + (h.assessment_id || '') + ' ' + (h.deploy_job_id || '') + ' ' + (h.fetch_error || '') + ' ' + (h.diagnose_error || '')).toLowerCase() %>">
        <td class="small mono"><%= h.started_at %></td>
        <td><strong><%= h.hostname %></strong></td>
        <td class="mono small"><%= h.ip %></td>
        <td><%= h.os %></td>
        <td>
          <% if (h.fetch_status === 'success') { %><span style="color:#27ae60;font-weight:600;"><%= t('collection.hist.stSuccess') %></span>
          <% } else if (h.fetch_status === 'failed') { %><span style="color:#c0392b;font-weight:600;" title="<%= h.fetch_error %>"><%= t('collection.hist.stFail') %></span>
          <% } else if (h.fetch_status === 'queued') { %><span class="muted"><%= t('collection.hist.stQueued') %></span>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td>
          <% if (h.diagnose_status === 'success') { %><span style="color:#27ae60;font-weight:600;"><%= t('collection.hist.stDone') %></span>
          <% } else if (h.diagnose_status === 'skipped') { %><span class="muted"><%= t('collection.hist.skipped') %></span>
          <% } else if (h.diagnose_status === 'waiting_agent') { %><span class="muted"><%= t('collection.hist.stAgentWait') %></span>
          <% } else if (h.diagnose_status === 'failed') { %><span style="color:#c0392b;font-weight:600;" title="<%= h.diagnose_error %>"><%= t('collection.hist.stFail') %></span>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td>
          <% if (h.assessment_id) { %><a href="/diagnosis/<%= h.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;">#<%= h.assessment_id %></a>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td class="small">
          <% if (h.summary) { %>
            <span style="color:#c0392b;"><%= t('collection.hist.vuln') %> <%= h.summary.vuln %></span> /
            <span style="color:#27ae60;"><%= t('collection.hist.safe') %> <%= h.summary.safe %></span>
            <% if (h.summary.info) { %>/ <%= t('collection.hist.info') %> <%= h.summary.info %><% } %>
            <% if (h.summary.na) { %>/ <span style="color:#b9770e;">N/A <%= h.summary.na %></span><% } %>
          <% } else if (h.fetch_error) { %>
            <span class="muted" style="font-size:0.85em;"><%= h.fetch_error.substring(0, 80) %></span>
          <% } else if (h.diagnose_error) { %>
            <span class="muted" style="font-size:0.85em;"><%= h.diagnose_error.substring(0, 80) %></span>
          <% } else { %><span class="muted">-</span><% } %>
        </td>
        <td class="small mono"><%= h.elapsed_ms ? (function(ms){var s=Math.round(ms/1000);return s<60 ? s+t('collection.hist.sec') : Math.floor(s/60)+t('collection.hist.min')+(s%60)+t('collection.hist.sec');})(h.elapsed_ms) : '-' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<script>
function applyHistoryFilter() {
  const q = document.getElementById('historySearch').value.toLowerCase();
  const fetchStatus = document.getElementById('historyFetch').value;
  const diagnoseStatus = document.getElementById('historyDiagnose').value;
  const source = document.getElementById('historySource').value;
  const from = document.getElementById('historyFrom').value;
  const to = document.getElementById('historyTo').value;

  document.querySelectorAll('#collectionHistoryTable tbody tr').forEach(tr => {
    if (!tr.dataset.search) return;
    let show = true;
    const date = tr.dataset.date || '';
    if (q && !tr.dataset.search.includes(q)) show = false;
    if (fetchStatus && tr.dataset.fetch !== fetchStatus) show = false;
    if (diagnoseStatus && tr.dataset.diagnose !== diagnoseStatus) show = false;
    if (source && tr.dataset.source !== source) show = false;
    if (from && date && date < from) show = false;
    if (to && date && date > to) show = false;
    tr.style.display = show ? '' : 'none';
  });
}

function resetHistoryFilter() {
  ['historySearch', 'historyFetch', 'historyDiagnose', 'historySource', 'historyFrom', 'historyTo'].forEach(id => {
    document.getElementById(id).value = '';
  });
  document.querySelectorAll('#collectionHistoryTable tbody tr').forEach(tr => { tr.style.display = ''; });
}

['historySearch', 'historyFetch', 'historyDiagnose', 'historySource', 'historyFrom', 'historyTo'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener(id === 'historySearch' ? 'input' : 'change', applyHistoryFilter);
});
</script>

<%- include('../_footer') %>
