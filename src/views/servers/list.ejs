<%- include('../_header', { title: t('servers.title') }) %>

<div style="display:flex;justify-content:space-between;align-items:center;">
  <h1><%= t('servers.title') %></h1>
  <a href="/servers/new" class="btn primary"><%= t('servers.list.addServer') %></a>
</div>

<table class="data-table">
  <thead>
    <tr><th>ID</th><th><%= t('servers.list.th.name') %></th><th><%= t('servers.list.th.host') %></th><th>OS</th><th>SSH</th><th><%= t('servers.list.th.rawPath') %></th><th><%= t('servers.list.th.lastCollected') %></th><th><%= t('servers.list.th.actions') %></th></tr>
  </thead>
  <tbody>
    <% servers.forEach(s => { %>
    <tr>
      <td><%= s.server_id %></td>
      <td><%= s.name %></td>
      <td><code><%= s.hostname %>:<%= s.ssh_port||22 %></code></td>
      <td><span class="os-badge"><%= s.os_type.toUpperCase() %></span></td>
      <td>
        <% if (s.ssh_user) { %>
          <%= s.ssh_user %> <span class="muted small">(<%= s.ssh_auth_type %>)</span>
        <% } else { %>
          <span class="muted"><%= t('servers.list.notSet') %></span>
        <% } %>
      </td>
      <td><code class="small"><%= s.remote_raw_path || '-' %></code></td>
      <td class="small"><%= s.last_collected_at || '-' %></td>
      <td>
        <a href="/servers/<%= s.server_id %>/edit" class="btn-sm"><%= t('common.btn.edit') %></a>
        <a href="/assess/new?server_id=<%= s.server_id %>" class="btn-sm primary"><%= t('servers.list.diagnose') %></a>
        <form method="post" action="/servers/<%= s.server_id %>/delete" style="display:inline"
              onsubmit='return confirm(<%- JSON.stringify(t("servers.list.deleteConfirm")) %>);'>
          <button class="btn-sm danger"><%= t('common.btn.delete') %></button>
        </form>
      </td>
    </tr>
    <% }); %>
    <% if (!servers.length) { %>
      <tr><td colspan="8" class="empty"><%= t('servers.list.empty') %></td></tr>
    <% } %>
  </tbody>
</table>

<%- include('../_footer') %>
