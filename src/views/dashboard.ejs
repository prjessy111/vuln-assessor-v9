<%- include('_header', { title: t('dashboard.title') }) %>

<div class="dash-header">
  <h1><%= t('dashboard.title') %></h1>
  <div class="dash-period">
    <%= t('dashboard.asOf', { now: now }) %>
    <a href="/collect" class="btn-sm primary"><%= t('common.btn.newCollect') %></a>
    <a href="/assess/new" class="btn-sm"><%= t('common.btn.runAssess') %></a>
  </div>
</div>

<div class="kpi-grid">
  <div class="kpi-card kpi-vuln">
    <div class="kpi-label"><%= t('dashboard.kpi.totalVuln') %></div>
    <div class="kpi-num"><%= kpi.totalVuln %></div>
    <div class="kpi-sub"><%= t('dashboard.kpi.severeHigh', { n: kpi.severeVuln }) %></div>
  </div>
  <div class="kpi-card kpi-new">
    <div class="kpi-label"><%= t('dashboard.kpi.newFound') %></div>
    <div class="kpi-num"><%= kpi.newVuln %></div>
    <div class="kpi-sub"><%= t('dashboard.kpi.vsTotal', { pct: kpi.newPct }) %></div>
  </div>
  <div class="kpi-card kpi-pending">
    <div class="kpi-label"><%= t('dashboard.kpi.pending') %></div>
    <div class="kpi-num"><%= kpi.pending %></div>
    <div class="kpi-sub"><%= t('dashboard.kpi.noAssignee', { n: kpi.noAssignee }) %></div>
  </div>
  <div class="kpi-card kpi-rate">
    <div class="kpi-label"><%= t('dashboard.kpi.fixRate') %></div>
    <div class="kpi-num"><%= kpi.fixRate %>%</div>
    <div class="kpi-sub"><%= t('dashboard.kpi.fixedOf', { fixed: kpi.fixed, total: kpi.totalVuln }) %></div>
  </div>
  <div class="kpi-card kpi-servers">
    <div class="kpi-label"><%= t('dashboard.kpi.servers') %></div>
    <div class="kpi-num"><%= kpi.serverCount %></div>
    <div class="kpi-sub"><%= t('dashboard.kpi.recent7d', { n: kpi.recentAssess }) %></div>
  </div>
</div>

<div class="charts-row">
  <div class="chart-box">
    <h3><%= t('dashboard.chart.category') %></h3>
    <svg viewBox="0 0 200 200" class="donut-svg">
      <%
        const cats = Object.entries(categoryStats);
        const total = cats.reduce((s, [_, n]) => s + n, 0) || 1;
        const colors = ['#e74c3c', '#e67e22', '#f1c40f', '#3498db', '#9b59b6', '#1abc9c', '#34495e'];
        let cumA = -Math.PI / 2;
        const cx = 100, cy = 100, r = 70, sw = 28;
      %>
      <% cats.forEach(([name, n], idx) => {
        const a1 = cumA;
        const a2 = cumA + (n / total) * 2 * Math.PI;
        cumA = a2;
        const large = (a2 - a1) > Math.PI ? 1 : 0;
        const x1 = cx + r * Math.cos(a1), y1 = cy + r * Math.sin(a1);
        const x2 = cx + r * Math.cos(a2), y2 = cy + r * Math.sin(a2);
      %>
        <path d="M <%= x1 %> <%= y1 %> A <%= r %> <%= r %> 0 <%= large %> 1 <%= x2 %> <%= y2 %>"
              fill="none" stroke="<%= colors[idx % colors.length] %>" stroke-width="<%= sw %>"></path>
      <% }); %>
      <text x="100" y="95" text-anchor="middle" font-size="14" fill="#666"><%= t('dashboard.chart.total') %></text>
      <text x="100" y="115" text-anchor="middle" font-size="22" font-weight="bold" fill="#2c3e50"><%= total %></text>
    </svg>
    <div class="donut-legend">
      <% cats.forEach(([name, n], idx) => { const pct = Math.round(n / total * 100); %>
        <div class="legend-item" title="<%= td(name) %>: <%= t('common.unit.count', { n: n }) %> (<%= pct %>%)">
          <span class="dot" style="background:<%= colors[idx % colors.length] %>"></span>
          <span class="legend-text"><%= td(name) %></span>
          <span class="legend-num"><%= n %> · <%= pct %>%</span>
        </div>
      <% }); %>
    </div>
  </div>

  <div class="chart-box wide">
    <h3><%= t('dashboard.chart.trend4w') %></h3>
    <svg viewBox="0 0 500 200" class="trend-svg" preserveAspectRatio="xMidYMid meet">
      <%
        const maxVal = Math.max(1, ...trend.map(t2 => t2.vuln));
        const barW = 70, gap = 30, startX = 70;
        const baseY = 170, topY = 30, plotH = baseY - topY;
        // 눈금선 4단계
        const ticks = [0, 0.25, 0.5, 0.75, 1];
      %>
      <% ticks.forEach(tk => { const gy = baseY - tk * plotH; const gv = Math.round(maxVal * tk); %>
        <line x1="60" y1="<%= gy %>" x2="490" y2="<%= gy %>" stroke="<%= tk === 0 ? '#bbb' : '#eee' %>"/>
        <text x="52" y="<%= gy + 4 %>" text-anchor="end" font-size="10" fill="#999"><%= gv %></text>
      <% }); %>
      <% trend.forEach((tr, idx) => {
        const x = startX + idx * (barW + gap);
        const h = (tr.vuln / maxVal) * plotH;
        const y = baseY - h;
      %>
        <rect x="<%= x %>" y="<%= y %>" width="<%= barW %>" height="<%= h %>" fill="#2980b9" rx="4"/>
        <text x="<%= x + barW/2 %>" y="<%= y - 6 %>" text-anchor="middle"
              font-size="14" font-weight="bold" fill="#2c3e50"><%= tr.vuln %></text>
        <text x="<%= x + barW/2 %>" y="190" text-anchor="middle" font-size="11" fill="#666"><%= tr.label %></text>
      <% }); %>
    </svg>
  </div>
</div>

<div class="chart-box full">
  <h3><%= t('dashboard.chart.hostVuln') %></h3>
  <%
    const maxHostVuln = Math.max(1, ...hostStats.map(h => h.total));
  %>
  <% hostStats.forEach(h => { %>
    <div class="bar-row">
      <div class="bar-label"><%= h.hostname %> <span class="muted small">(<%= h.service_name || '-' %>)</span></div>
      <div class="bar-track" title="<%= t('dashboard.chart.tipSev', { h: h.sev_high, m: h.sev_mid, l: h.sev_low, total: h.total }) %>">
        <% const wHi = h.sev_high / maxHostVuln * 100;
           const wMd = h.sev_mid / maxHostVuln * 100;
           const wLo = h.sev_low / maxHostVuln * 100; %>
        <div class="bar-seg sev-high" style="width:<%= wHi %>%" title="<%= t('common.sev.high') %> <%= t('common.unit.count', { n: h.sev_high }) %>"><%= wHi >= 7 ? h.sev_high : '' %></div>
        <div class="bar-seg sev-mid"  style="width:<%= wMd %>%" title="<%= t('common.sev.mid') %> <%= t('common.unit.count', { n: h.sev_mid }) %>"><%= wMd >= 7 ? h.sev_mid : '' %></div>
        <div class="bar-seg sev-low"  style="width:<%= wLo %>%" title="<%= t('common.sev.low') %> <%= t('common.unit.count', { n: h.sev_low }) %>"><%= wLo >= 7 ? h.sev_low : '' %></div>
      </div>
      <div class="bar-total"><%= h.total %></div>
    </div>
  <% }); %>
  <div class="bar-legend">
    <span class="legend-item"><span class="dot sev-high"></span><%= t('common.sev.high') %></span>
    <span class="legend-item"><span class="dot sev-mid"></span><%= t('common.sev.mid') %></span>
    <span class="legend-item"><span class="dot sev-low"></span><%= t('common.sev.low') %></span>
  </div>
</div>

<div class="workqueue-box">
  <h3><%= t('dashboard.wq.title') %>
    <span class="muted small"><%= t('dashboard.wq.subtitle') %></span>
  </h3>
  <table class="data-table">
    <thead>
      <tr>
        <th><%= t('dashboard.wq.mgmtNo') %></th><th><%= t('dashboard.wq.server') %></th><th><%= t('dashboard.wq.vuln') %></th>
        <th><%= t('dashboard.wq.severity') %></th><th><%= t('dashboard.wq.isNew') %></th><th><%= t('dashboard.wq.assignee') %></th>
        <th><%= t('dashboard.wq.deliveredAt') %></th><th><%= t('dashboard.wq.fixStatus') %></th><th></th>
      </tr>
    </thead>
    <tbody>
      <% workqueue.forEach(w => { %>
        <tr>
          <td class="mono small"><%= w.management_no %></td>
          <td><%= w.hostname %></td>
          <td><%= w.title %></td>
          <td><span class="sev sev-<%= w.severity %>"><%= td(w.severity) %></span></td>
          <td>
            <% if (w.is_new) { %><span class="newflag newflag-new"><%= td('신규') %></span>
            <% } else { %><span class="newflag newflag-old"><%= td('기존') %></span><% } %>
          </td>
          <td>
            <% if (w.assignee) { %><%= w.assignee %>
            <% } else { %><span class="muted"><%= td('미지정') %></span><% } %>
          </td>
          <td class="small"><%= w.delivered_at || '-' %></td>
          <td><span class="fix-status fs-<%= w.fix_status === '진행중' ? 'progress' : 'pending' %>"><%= td(w.fix_status) %></span></td>
          <td><a href="/diagnosis/<%= w.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;"><%= t('common.btn.aiResult') %></a></td>
        </tr>
      <% }); %>
      <% if (!workqueue.length) { %>
        <tr><td colspan="9" class="empty"><%= t('dashboard.wq.empty') %></td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<h2><%= t('dashboard.srv.title') %></h2>
<div class="server-cards">
  <% summaries.forEach(s => { %>
    <div class="server-card">
      <div class="server-card-header">
        <span class="server-name"><%= s.name %></span>
        <span class="os-badge"><%= s.os_type ? s.os_type.toUpperCase() : '?' %></span>
      </div>
      <div class="server-card-host"><%= s.hostname %></div>
      <% if (s.asset_no) { %>
        <div class="server-card-meta"><%= t('dashboard.srv.asset') %> <%= s.asset_no %> · <%= s.service_name || '-' %></div>
      <% } %>
      <% if (s.executed_at) { %>
        <div class="server-card-time"><%= t('dashboard.srv.lastAssess') %> <%= s.executed_at %></div>
        <div class="card-badges">
          <span class="badge total"><%= t('dashboard.srv.total', { n: s.total_count }) %></span>
          <% if (s.vuln_count) { %><span class="badge b-vuln"><%= t('dashboard.srv.vuln', { n: s.vuln_count }) %></span><% } %>
          <% if (s.safe_count) { %><span class="badge b-safe"><%= t('dashboard.srv.safe', { n: s.safe_count }) %></span><% } %>
          <% if (s.na_count) { %><span class="badge b-na"><%= t('dashboard.srv.na', { n: s.na_count }) %></span><% } %>
        </div>
        <div class="card-actions">
          <a href="/diagnosis/<%= s.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;"><%= t('common.btn.aiResult') %></a>
          <a href="/assess/new?server_id=<%= s.server_id %>" class="btn-sm"><%= t('common.btn.reassess') %></a>
        </div>
      <% } else { %>
        <div class="server-card-time muted"><%= t('dashboard.srv.noHistory') %></div>
        <a href="/assess/new?server_id=<%= s.server_id %>" class="btn-sm"><%= t('common.btn.runAssess') %></a>
      <% } %>
    </div>
  <% }); %>
</div>

<%- include('_footer') %>
