<%- include('../_header', { title: t('rulesets.index.title'), activeMenu: 'rulesets' }) %>

<div class="page-header">
  <h1><%= t('rulesets.index.title') %></h1>
  <p class="muted"><%- t('rulesets.index.introHtml') %></p>
</div>

<!-- 룰셋 메타 -->
<div class="ruleset-meta">
  <div class="rs-card">
    <div class="rs-label"><%= t('rulesets.index.meta.current') %></div>
    <div class="rs-value">secums-unix-v2.0</div>
  </div>
  <div class="rs-card">
    <div class="rs-label"><%= t('rulesets.index.meta.active') %></div>
    <div class="rs-value"><%= t('common.unit.count', { n: 14 }) %></div>
  </div>
  <div class="rs-card">
    <div class="rs-label"><%= t('rulesets.index.meta.userDefined') %></div>
    <div class="rs-value rs-user"><%= t('common.unit.count', { n: 3 }) %></div>
  </div>
  <div class="rs-card">
    <div class="rs-label"><%= t('rulesets.index.meta.lastModified') %></div>
    <div class="rs-value mono small">2026-05-23 06:45</div>
  </div>
</div>

<!-- 3가지 룰 추가 방식 -->
<div class="section-box">
  <h3><%= t('rulesets.index.addTitle') %></h3>
  <div class="rule-add-methods">
    <div class="add-method">
      <div class="method-icon">📝</div>
      <h4><%= t('rulesets.index.m1Title') %></h4>
      <p class="muted small"><%= t('rulesets.index.m1Desc') %></p>
      <a href="/rulesets/new?mode=form" class="btn primary"><%= t('rulesets.index.m1Btn') %></a>
    </div>
    <div class="add-method">
      <div class="method-icon">⌨️</div>
      <h4><%= t('rulesets.index.m2Title') %></h4>
      <p class="muted small"><%= t('rulesets.index.m2Desc') %></p>
      <a href="/rulesets/new?mode=yaml" class="btn"><%= t('rulesets.index.m2Btn') %></a>
    </div>
    <div class="add-method">
      <div class="method-icon">🤖</div>
      <h4><%= t('rulesets.index.m3Title') %></h4>
      <p class="muted small"><%= t('rulesets.index.m3Desc') %></p>
      <a href="/rulesets/new?mode=ai" class="btn"><%= t('rulesets.index.m3Btn') %></a>
    </div>
  </div>
</div>

<!-- 룰 목록 -->
<div class="section-box">
  <div class="rules-toolbar">
    <h3><%= t('rulesets.index.allRules') %></h3>
    <div class="filters">
      <select><option><%= t('rulesets.index.filter.allCategory') %></option><option><%= t('rulesets.index.filter.catAccount') %></option><option><%= t('rulesets.index.filter.catService') %></option><option><%= t('rulesets.index.filter.catFilePerm') %></option></select>
      <select><option><%= t('rulesets.index.filter.allOs') %></option><option>linux</option><option>windows</option></select>
      <select><option><%= t('rulesets.index.filter.allSev') %></option><option><%= t('common.sev.high') %></option><option><%= t('common.sev.mid') %></option><option><%= t('common.sev.low') %></option></select>
      <input type="search" placeholder="<%= t('rulesets.index.filter.searchPh') %>">
    </div>
  </div>

  <table class="data-table rules-table">
    <thead>
      <tr>
        <th><%= t('rulesets.index.th.ruleId') %></th>
        <th><%= t('rulesets.index.th.title') %></th>
        <th><%= t('rulesets.index.th.category') %></th>
        <th>OS</th>
        <th><%= t('rulesets.index.th.severity') %></th>
        <th><%= t('rulesets.index.th.evalMethod') %></th>
        <th><%= t('rulesets.index.th.type') %></th>
        <th><%= t('rulesets.index.th.source') %></th>
        <th><%= t('rulesets.index.th.updatedAt') %></th>
        <th><%= t('rulesets.index.th.enabled') %></th>
        <th><%= t('rulesets.index.th.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% rules.forEach(r => { %>
        <tr class="<%= !r.enabled ? 'rule-disabled' : '' %>">
          <td class="mono"><%= r.rule_id %></td>
          <td>
            <strong><%= r.title %></strong>
            <div class="muted small"><%= r.description.slice(0, 80) %>...</div>
          </td>
          <td class="small"><%= r.category %></td>
          <td><span class="os-badge os-<%= r.os_target %>"><%= r.os_target.toUpperCase() %></span></td>
          <td><span class="sev sev-<%= r.severity %>"><%= td(r.severity) %></span></td>
          <td>
            <% if (r.eval_type === 'simple') { %>
              <span class="method-badge simple">SQL</span>
            <% } else if (r.eval_type === 'llm') { %>
              <span class="method-badge llm">AI</span>
            <% } else { %>
              <span class="method-badge mixed"><%= t('rulesets.index.badge.hybrid') %></span>
            <% } %>
          </td>
          <td>
            <% if (r.is_per_row) { %>
              <span class="rule-type-badge per-row"><%= t('rulesets.index.badge.perRow') %></span>
            <% } else { %>
              <span class="rule-type-badge host"><%= t('rulesets.index.badge.host') %></span>
            <% } %>
          </td>
          <td>
            <% if (r.source === 'builtin') { %>
              <span class="src-badge src-builtin"><%= t('rulesets.index.badge.builtin') %></span>
            <% } else if (r.source === 'user') { %>
              <span class="src-badge src-user"><%= t('rulesets.index.badge.user') %></span>
            <% } else if (r.source === 'ai') { %>
              <span class="src-badge src-ai"><%= t('rulesets.index.badge.aiSuggest') %></span>
            <% } %>
          </td>
          <td class="mono small"><%= r.updated_at %></td>
          <td>
            <label class="toggle">
              <input type="checkbox" <%= r.enabled ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </td>
          <td>
            <a href="/rulesets/<%= r.rule_id %>" class="btn-sm"><%= t('rulesets.index.view') %></a>
            <a href="/rulesets/<%= r.rule_id %>/edit" class="btn-sm"><%= t('rulesets.index.edit') %></a>
            <a href="/rulesets/<%= r.rule_id %>/test" class="btn-sm"><%= t('rulesets.index.test') %></a>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../_footer') %>
