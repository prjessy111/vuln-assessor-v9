<%- include('../_header', { title: t('rulesets.form.title'), activeMenu: 'rulesets' }) %>

<div class="page-header">
  <h1><%= t('rulesets.form.title') %></h1>
  <div class="mode-tabs">
    <a href="?mode=form" class="tab active">📝 <%= t('rulesets.tabs.form') %></a>
    <a href="?mode=yaml" class="tab">⌨️ YAML</a>
    <a href="?mode=ai" class="tab">🤖 <%= t('rulesets.tabs.ai') %></a>
  </div>
</div>

<div class="rule-add-layout">
  <!-- 왼쪽: 폼 입력 -->
  <div class="form-pane">
    <h3><%= t('rulesets.form.step1') %></h3>
    <div class="form-grid">
      <div class="form-row">
        <label><%= t('rulesets.form.ruleId') %> <span class="required">*</span></label>
        <input type="text" value="USER-001" placeholder="<%= t('rulesets.form.ruleIdPh') %>">
        <div class="hint"><%= t('rulesets.form.ruleIdHint') %></div>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.titleLabel') %> <span class="required">*</span></label>
        <input type="text" value="SSH PermitRootLogin 비활성화 확인" placeholder="<%= t('rulesets.form.titlePh') %>">
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.category') %></label>
        <select>
          <option><%= t('rulesets.form.cat.service') %></option>
          <option><%= t('rulesets.form.cat.account') %></option>
          <option><%= t('rulesets.form.cat.fileDir') %></option>
          <option><%= t('rulesets.form.cat.logPatch') %></option>
          <option><%= t('rulesets.form.cat.new') %></option>
        </select>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.severity') %></label>
        <div class="radio-group">
          <label class="radio sev-radio sev-상"><input type="radio" name="sev" checked> <%= t('common.sev.high') %></label>
          <label class="radio sev-radio sev-중"><input type="radio" name="sev"> <%= t('common.sev.mid') %></label>
          <label class="radio sev-radio sev-하"><input type="radio" name="sev"> <%= t('common.sev.low') %></label>
        </div>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.targetOs') %></label>
        <select>
          <option>linux</option>
          <option>windows</option>
          <option>all</option>
        </select>
      </div>
    </div>

    <h3><%= t('rulesets.form.step2') %></h3>
    <div class="form-grid">
      <div class="form-row">
        <label><%= t('rulesets.form.descNatural') %></label>
        <textarea rows="4">SSH 데몬에서 root 직접 로그인이 허용되어 있으면 brute-force 공격에 노출됨.
PermitRootLogin이 'yes'면 즉시 취약, 'no' 또는 'prohibit-password'면 양호.</textarea>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.checkMethod') %></label>
        <textarea rows="3">/etc/ssh/sshd_config 파일에서 PermitRootLogin 값을 확인.
주석 처리 시 기본값(yes)으로 동작하므로 명시적 'no' 필요.</textarea>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.checkCriteria') %></label>
        <textarea rows="3">양호 - PermitRootLogin이 'no' 또는 'prohibit-password'로 설정됨
취약 - PermitRootLogin이 'yes' 또는 미설정(기본값 적용)</textarea>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.remedy') %></label>
        <textarea rows="3">1. /etc/ssh/sshd_config 편집
2. PermitRootLogin no
3. systemctl restart sshd</textarea>
      </div>
    </div>

    <h3><%= t('rulesets.form.step3') %></h3>
    <div class="form-grid">
      <div class="form-row">
        <label><%= t('rulesets.form.judgeType') %></label>
        <div class="radio-group vertical">
          <label class="radio">
            <input type="radio" name="type" checked>
            <strong><%= t('rulesets.form.hostUnit') %></strong> — <%= t('rulesets.form.hostUnitDesc') %>
          </label>
          <label class="radio">
            <input type="radio" name="type">
            <strong><%= t('rulesets.form.perRowUnit') %></strong> — <%= t('rulesets.form.perRowDesc') %>
          </label>
        </div>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.rawSql') %> <span class="required">*</span></label>
        <textarea rows="4" class="mono">SELECT FILE, KEY, VALUE FROM U_SSHD_CONFIG_TB
WHERE KEY = 'PermitRootLogin'</textarea>
        <div class="hint">
          <a href="#" class="link"><%= t('rulesets.form.viewTables') %></a>
          <a href="#" class="link"><%= t('rulesets.form.runSample') %></a>
        </div>
      </div>
      <div class="form-row">
        <label><%= t('rulesets.form.judgeMethod') %></label>
        <div class="radio-group vertical">
          <label class="radio">
            <input type="radio" name="judge" checked>
            <strong><%= t('rulesets.form.simpleCheck') %></strong> — <%= t('rulesets.form.simpleCheckDesc') %>
          </label>
          <label class="radio">
            <input type="radio" name="judge">
            <strong><%= t('rulesets.form.aiJudge') %></strong> — <%= t('rulesets.form.aiJudgeDesc') %>
          </label>
        </div>
      </div>

      <!-- 단순 검사 선택 시 -->
      <div class="form-row simple-check-pane">
        <label><%= t('rulesets.form.checkType') %></label>
        <div class="check-config">
          <select>
            <option><%= t('rulesets.form.opt.notContains') %></option>
            <option><%= t('rulesets.form.opt.equals') %></option>
            <option><%= t('rulesets.form.opt.regex') %></option>
            <option><%= t('rulesets.form.opt.permLe') %></option>
            <option><%= t('rulesets.form.opt.intMin') %></option>
            <option><%= t('rulesets.form.opt.rowCountZero') %></option>
          </select>
          <div class="check-params">
            <label>field: <input type="text" value="VALUE"></label>
            <label>keyword: <input type="text" value="yes"></label>
          </div>
          <div class="hint"><%= t('rulesets.form.checkTypeHint') %></div>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <button class="btn primary"><%= t('rulesets.form.previewTest') %></button>
      <button class="btn"><%= t('common.btn.save') %></button>
      <a href="/rulesets" class="btn"><%= t('common.btn.cancel') %></a>
    </div>
  </div>

  <!-- 오른쪽: 실시간 YAML 미리보기 + 테스트 결과 -->
  <div class="preview-pane">
    <h3><%= t('rulesets.form.livePreview') %></h3>
    <pre class="yaml-preview"><code>- rule_id: USER-001
  title: SSH PermitRootLogin 비활성화 확인
  description: |
    SSH 데몬에서 root 직접 로그인이 허용되어 있으면 brute-force
    공격에 노출됨. PermitRootLogin이 'yes'면 즉시 취약,
    'no' 또는 'prohibit-password'면 양호.
  category: 서비스 보호
  severity: 상
  os_target: linux

  check_method: |
    /etc/ssh/sshd_config 파일에서 PermitRootLogin 값을 확인.
    주석 처리 시 기본값(yes)으로 동작하므로 명시적 'no' 필요.
  check_criteria: |
    양호 - PermitRootLogin이 'no' 또는 'prohibit-password'
    취약 - PermitRootLogin이 'yes' 또는 미설정

  context_sql: |
    SELECT FILE, KEY, VALUE FROM U_SSHD_CONFIG_TB
    WHERE KEY = 'PermitRootLogin'

  simple_check:
    type: not_contains
    field: VALUE
    keyword: yes

  recommend: |
    1. /etc/ssh/sshd_config 편집
    2. PermitRootLogin no
    3. systemctl restart sshd

  enabled: true
</code></pre>

    <h3><%= t('rulesets.form.testResultTitle', { host: 'jessy62' }) %></h3>
    <div class="test-result">
      <div class="test-row">
        <span class="test-label"><%= t('rulesets.form.ctxSqlRun') %></span>
        <span class="test-result-ok">✓ <%= t('rulesets.form.rowsReturned', { n: 1 }) %></span>
      </div>
      <div class="test-detail">
        <table class="mini-table">
          <tr><th>FILE</th><th>KEY</th><th>VALUE</th></tr>
          <tr><td>/etc/ssh/sshd_config</td><td>PermitRootLogin</td><td>yes</td></tr>
        </table>
      </div>
      <div class="test-row">
        <span class="test-label"><%= t('rulesets.form.simpleCheckEval') %></span>
        <span class="test-result-ng">✗ <%= t('rulesets.form.vuln') %></span>
      </div>
      <div class="test-detail">
        <%- t('rulesets.form.reasonHtml') %>
      </div>
      <div class="test-row">
        <span class="test-label"><%= t('rulesets.form.elapsedLabel') %></span>
        <span>3ms</span>
      </div>
    </div>

    <div class="preview-actions">
      <button class="btn-sm"><%= t('rulesets.form.testOnServers', { n: 5 }) %></button>
      <button class="btn-sm"><%= t('rulesets.form.copyYaml') %></button>
    </div>
  </div>
</div>

<%- include('../_footer') %>
