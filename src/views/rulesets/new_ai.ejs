<%- include('../_header', { title: t('rulesets.ai.title'), activeMenu: 'rulesets' }) %>

<div class="page-header">
  <h1><%= t('rulesets.ai.h1') %></h1>
  <div class="mode-tabs">
    <a href="?mode=form" class="tab">📝 <%= t('rulesets.tabs.form') %></a>
    <a href="?mode=yaml" class="tab">⌨️ YAML</a>
    <a href="?mode=ai" class="tab active">🤖 <%= t('rulesets.tabs.ai') %></a>
  </div>
</div>

<div class="section-box">
  <h3><%= t('rulesets.ai.step1') %></h3>
  <p class="muted small"><%= t('rulesets.ai.step1Desc') %></p>
  <div class="ai-target-grid">
    <label class="ai-target-card selected">
      <input type="checkbox" checked>
      <div class="atc-name">jessy62</div>
      <div class="atc-meta">CentOS 7.5 / 내부 결제 DB</div>
      <div class="atc-tables"><%= t('rulesets.ai.tablesFound', { n: 33 }) %></div>
    </label>
    <label class="ai-target-card">
      <input type="checkbox">
      <div class="atc-name">linux-prod-02</div>
      <div class="atc-meta">RHEL 8.5 / 주문 API</div>
      <div class="atc-tables"><%= t('rulesets.ai.tablesFound', { n: 31 }) %></div>
    </label>
    <label class="ai-target-card">
      <input type="checkbox">
      <div class="atc-name">linux-db-01</div>
      <div class="atc-meta">CentOS 7.9 / 결제 DB</div>
      <div class="atc-tables"><%= t('rulesets.ai.tablesFound', { n: 33 }) %></div>
    </label>
  </div>
</div>

<div class="section-box">
  <h3><%= t('rulesets.ai.step2') %></h3>
  <div class="form-grid">
    <div class="form-row">
      <label><%= t('rulesets.ai.interestCat') %></label>
      <div class="check-group">
        <label class="check"><input type="checkbox" checked> <%= t('rulesets.ai.cat.accountPerm') %></label>
        <label class="check"><input type="checkbox" checked> <%= t('rulesets.ai.cat.service') %></label>
        <label class="check"><input type="checkbox" checked> <%= t('rulesets.ai.cat.filePerm') %></label>
        <label class="check"><input type="checkbox"> <%= t('rulesets.ai.cat.log') %></label>
        <label class="check"><input type="checkbox"> <%= t('rulesets.ai.cat.network') %></label>
      </div>
    </div>
    <div class="form-row">
      <label><%= t('rulesets.ai.excludeExisting') %></label>
      <p class="muted small"><%= t('rulesets.ai.excludeDesc', { n: 14 }) %></p>
    </div>
    <div class="form-row">
      <label><%= t('rulesets.ai.refStd') %></label>
      <select multiple class="multi-select">
        <option selected><%= t('rulesets.ai.stdFsi') %></option>
        <option selected><%= t('rulesets.ai.stdKisa') %></option>
        <option>CIS Benchmarks</option>
        <option><%= t('rulesets.ai.stdStig') %></option>
      </select>
    </div>
  </div>
  <button class="btn primary">🤖 <%= t('rulesets.ai.startBtn') %></button>
</div>

<div class="section-box">
  <h3><%= t('rulesets.ai.step3') %> <span class="muted small"><%= t('rulesets.ai.step3Meta', { n: 13, sec: 7 }) %></span></h3>
  <p class="muted small"><%= t('rulesets.ai.step3Desc') %></p>

  <div class="ai-suggestions">
    <% suggestions.forEach((s, idx) => { %>
      <div class="ai-suggestion-card priority-<%= s.priority %>">
        <div class="ais-header">
          <label class="check-large">
            <input type="checkbox" <%= s.recommended ? 'checked' : '' %>>
            <span class="ais-id"><%= s.rule_id %></span>
            <span class="ais-title"><%= s.title %></span>
          </label>
          <div class="ais-meta">
            <span class="sev sev-<%= s.severity %>"><%= td(s.severity) %></span>
            <span class="ais-category"><%= s.category %></span>
            <span class="ais-confidence"><%= t('rulesets.ai.confidence', { n: s.confidence }) %></span>
          </div>
        </div>

        <div class="ais-body">
          <div class="ais-rationale">
            <strong>💡 <%= t('rulesets.ai.rationale') %></strong> <%= s.rationale %>
          </div>

          <div class="ais-grid">
            <div class="ais-col">
              <h5><%= t('rulesets.ai.relatedTables') %></h5>
              <code class="ais-table-hint"><%= s.related_tables %></code>
              <div class="ais-data-sample">
                <%= s.data_sample %>
              </div>
            </div>
            <div class="ais-col">
              <h5><%= t('rulesets.ai.generatedYaml') %></h5>
              <pre class="yaml-mini"><code><%= s.yaml_preview %></code></pre>
            </div>
          </div>

          <% if (s.related_cves && s.related_cves.length) { %>
            <div class="ais-cves">
              <strong><%= t('rulesets.ai.relatedCves') %></strong>
              <% s.related_cves.forEach(c => { %>
                <span class="cve-tag cvss-<%= c.severity_class %>">
                  <%= c.id %> · CVSS <%= c.cvss %>
                </span>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="ais-actions">
          <button class="btn-sm"><%= t('rulesets.ai.previewEdit') %></button>
          <button class="btn-sm"><%= t('rulesets.ai.runTest') %></button>
          <button class="btn-sm danger"><%= t('rulesets.ai.skip') %></button>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="bulk-actions">
    <button class="btn primary"><%= t('rulesets.ai.bulkAdd', { n: 8 }) %></button>
    <button class="btn"><%= t('rulesets.ai.downloadYaml') %></button>
    <a href="/rulesets" class="btn"><%= t('common.btn.cancel') %></a>
  </div>
</div>

<%- include('../_footer') %>
