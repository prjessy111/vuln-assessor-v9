<%- include('../_header', { title: t('schedules.run.title', { id: run.run_id }), activeMenu: 'schedules' }) %>

<div class="page-header">
  <h1><%= t('schedules.run.h1') %></h1>
  <p class="muted small">
    <%- t('schedules.run.intro1') %><strong><%= run.schedule_name %></strong><%- t('schedules.run.intro2') %> <%= run.started_at %> <%= t('schedules.run.intro3') %>
  </p>
  <div class="header-actions">
    <a href="/schedules" class="btn"><%= t('schedules.form.back') %></a>
    <% if (typeof schedule !== 'undefined' && schedule) { %>
      <a href="/schedules/<%= schedule.schedule_id %>/edit" class="btn"><%= t('schedules.run.editSchedule') %></a>
    <% } %>
  </div>
</div>

<!-- 요약 KPI -->
<div class="kpi-grid kpi-5col">
  <div class="kpi-card">
    <div class="kpi-label"><%= t('schedules.run.status') %></div>
    <% var stColor = run.status === '성공' ? '#27ae60'
                   : run.status === '실패' ? '#c0392b'
                   : run.status === '부분실패' ? '#e67e22'
                   : '#888';
       var stText = run.status === '성공' ? t('schedules.index.status.success')
                  : run.status === '실패' ? t('schedules.index.status.failed')
                  : run.status === '부분실패' ? t('schedules.index.status.partial')
                  : run.status === '실행중' ? t('schedules.index.status.running')
                  : td(run.status); %>
    <div class="kpi-num" style="color:<%= stColor %>;"><%= stText %></div>
    <div class="kpi-sub"><%= t('schedules.run.overallResult') %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('schedules.run.success') %></div>
    <div class="kpi-num" style="color:#27ae60;"><%= run.success %></div>
    <div class="kpi-sub"><%= t('schedules.run.ofServers', { n: run.total }) %></div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label"><%= t('schedules.run.failed') %></div>
    <div class="kpi-num" style="color:#c0392b;"><%= run.failed %></div>
    <div class="kpi-sub"><%= t('schedules.run.targetServers') %></div>
  </div>
  <div class="kpi-card kpi-avg">
    <div class="kpi-label"><%= t('schedules.run.elapsed') %></div>
    <div class="kpi-num"><%= fmtMs(run.elapsed_ms || 0) %></div>
    <div class="kpi-sub"><%= t('schedules.run.totalTime') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label"><%= t('schedules.run.trigger') %></div>
    <div class="kpi-num" style="font-size:1.2rem;">
      <% if (run.triggered_by === 'cron') { %>⏰ <%= t('schedules.run.auto') %><% } else { %>👤 <%= t('schedules.run.manual') %><% } %>
    </div>
    <div class="kpi-sub"><%= run.triggered_by %></div>
  </div>
</div>

<!-- 메타 정보 -->
<div class="section-box">
  <h3><%= t('schedules.run.runInfo') %></h3>
  <table class="data-table" style="max-width:700px;">
    <tr>
      <th style="width:160px;"><%= t('schedules.run.scheduleIdName') %></th>
      <td>
        #<%= run.schedule_id %>
        <% if (typeof schedule !== 'undefined' && schedule) { %>
          <span class="muted">/</span> <%= run.schedule_name %>
          <% if (schedule.cron_expr) { %>
            <span class="muted small">(<code><%= schedule.cron_expr %></code>)</span>
          <% } %>
        <% } else { %>
          <span class="muted"><%= t('schedules.run.scheduleDeleted') %></span>
        <% } %>
      </td>
    </tr>
    <tr><th><%= t('schedules.run.runId') %></th><td class="mono"><%= run.run_id %></td></tr>
    <tr><th><%= t('schedules.run.startedAt') %></th><td class="mono"><%= run.started_at %></td></tr>
    <tr><th><%= t('schedules.run.finishedAt') %></th><td class="mono"><%= run.finished_at %></td></tr>
  </table>
</div>

<!-- 서버별 결과 -->
<div class="section-box">
  <h3><%= t('schedules.run.perServerTitle', { n: (run.per_server || []).length }) %></h3>
  <% if (!run.per_server || !run.per_server.length) { %>
    <p class="muted"><%= t('schedules.run.noPerServer') %></p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('schedules.run.th.server') %></th>
          <th><%= t('schedules.run.th.hostname') %></th>
          <th><%= t('schedules.run.th.status') %></th>
          <th><%= t('schedules.run.th.vulnFound') %></th>
          <th><%= t('schedules.run.th.elapsed') %></th>
          <th><%= t('schedules.run.th.assessId') %></th>
          <th><%= t('schedules.run.th.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% run.per_server.forEach(p => { %>
          <tr style="background:<%= p.status === 'failed' ? '#fff5f5' : 'transparent' %>;">
            <td>#<%= p.server_id %></td>
            <td class="mono"><%= p.hostname || '-' %></td>
            <td>
              <% if (p.status === 'success') { %>
                <span style="color:#27ae60;font-weight:600;">✓ <%= t('schedules.index.status.success') %></span>
              <% } else { %>
                <span style="color:#c0392b;font-weight:600;">✗ <%= t('schedules.index.status.failed') %></span>
              <% } %>
            </td>
            <td>
              <% if (p.status === 'success' && typeof p.vuln_count === 'number') { %>
                <% if (p.vuln_count > 0) { %>
                  <span style="color:#c0392b;font-weight:600;"><%= t('common.unit.count', { n: p.vuln_count }) %></span>
                <% } else { %>
                  <span style="color:#27ae60;"><%= t('schedules.run.none') %></span>
                <% } %>
              <% } else { %>
                <span class="muted">-</span>
              <% } %>
            </td>
            <td class="mono small">
              <%= p.elapsed_ms !== undefined ? fmtMs(p.elapsed_ms) : '-' %>
            </td>
            <td class="mono small">
              <% if (p.assessment_id) { %>
                #<%= p.assessment_id %>
              <% } else { %>
                <span class="muted">-</span>
              <% } %>
            </td>
            <td>
              <% if (p.assessment_id) { %>
                <a href="/diagnosis/<%= p.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;"><%= t('common.btn.aiResult') %></a>
                <a href="/diagnosis/<%= p.assessment_id %>/cve" class="btn-sm">CVE</a>
              <% } %>
            </td>
          </tr>
          <% if (p.status === 'failed' && p.error) { %>
            <tr style="background:#fff5f5;">
              <td colspan="7" class="small" style="padding-left:2rem;color:#c0392b;">
                <strong><%= t('schedules.run.errorLabel') %></strong> <%= p.error %>
              </td>
            </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../_footer') %>
