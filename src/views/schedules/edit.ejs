<%- include('../_header', { title: t('schedules.form.titleEditId', { id: schedule.schedule_id }), activeMenu: 'schedules' }) %>

<div class="page-header">
  <h1><%= t('schedules.form.h1EditName', { name: schedule.name }) %></h1>
  <p class="muted small">
    <%= t('schedules.form.editIntro') %>
  </p>
  <div class="header-actions">
    <a href="/schedules" class="btn"><%= t('schedules.form.back') %></a>
  </div>
</div>

<form id="schForm" class="form-container">
  <div class="form-section">
    <h3><%= t('schedules.form.basicInfo') %></h3>
    <div class="form-row inline">
      <label><%= t('schedules.form.nameLabel') %></label>
      <input type="text" name="name" required maxlength="80" value="<%= schedule.name %>">
    </div>
    <div class="form-row inline">
      <label><%= t('schedules.form.descLabel') %></label>
      <input type="text" name="description" maxlength="200" value="<%= schedule.description || '' %>">
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.runInterval') %></h3>
    <div class="form-row inline">
      <label><%= t('schedules.form.cronLabel') %></label>
      <input type="text" id="cronInput" name="cron_expr" required value="<%= schedule.cron_expr %>">
      <button type="button" class="btn-sm" onclick="testCron()"><%= t('schedules.form.preview') %></button>
    </div>
    <p class="muted small" id="cronPreview">
      <%= t('schedules.form.currentLabel') %> <strong><%= schedule.cron_humanized || schedule.cron_expr %></strong>
      <% if (schedule.next_run_at && schedule.next_run_at !== '-') { %>
        <%= t('schedules.form.nextRunInline') %> <code><%= schedule.next_run_at %></code>
      <% } %>
    </p>
    <div class="form-row inline">
      <label><%= t('schedules.form.quickSelect') %></label>
      <select onchange="if(this.value) { document.getElementById('cronInput').value = this.value; testCron(); }">
        <option value=""><%= t('schedules.form.quickPatterns') %></option>
        <option value="0 2 * * *"><%= t('schedules.form.opt.daily2') %></option>
        <option value="0 */6 * * *"><%= t('schedules.form.opt.every6h') %></option>
        <option value="0 * * * *"><%= t('schedules.form.opt.hourly') %></option>
        <option value="*/15 * * * *"><%= t('schedules.form.opt.every15m') %></option>
        <option value="0 3 * * 0"><%= t('schedules.form.opt.sun3') %></option>
        <option value="0 3 1 * *"><%= t('schedules.form.opt.monthly1') %></option>
        <option value="manual"><%= t('schedules.form.opt.manualOnly') %></option>
      </select>
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.targetServers') %></h3>
    <div class="radio-group">
      <label>
        <input type="radio" name="server_scope" value="all" <%= schedule.server_scope === 'all' ? 'checked' : '' %>>
        <strong><%= t('schedules.form.allServers') %></strong>
      </label>
      <label>
        <input type="radio" name="server_scope" value="group" <%= schedule.server_scope === 'group' ? 'checked' : '' %>>
        <strong><%= t('schedules.form.group') %></strong>
      </label>
    </div>
    <div class="form-row inline" id="groupRow" style="display:<%= schedule.server_scope === 'group' ? 'flex' : 'none' %>;">
      <label><%= t('schedules.form.groupName') %></label>
      <input type="text" name="server_group" value="<%= schedule.server_group || '' %>">
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.notifySection') %></h3>
    <div class="form-row inline">
      <label>
        <input type="checkbox" name="notify_on_vuln" value="on" <%= schedule.notify_on_vuln ? 'checked' : '' %>>
        <%= t('schedules.form.notifyOnVuln') %>
      </label>
    </div>
    <div class="form-row inline">
      <label>
        <input type="checkbox" name="notify_on_failure" value="on" <%= schedule.notify_on_failure ? 'checked' : '' %>>
        <%= t('schedules.form.notifyOnFailure') %>
      </label>
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.statusSection') %></h3>
    <div class="form-row inline">
      <label>
        <input type="checkbox" name="enabled" value="on" <%= schedule.enabled ? 'checked' : '' %>>
        <%= t('schedules.form.enabledShort') %>
      </label>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn primary"><%= t('common.btn.save') %></button>
    <a href="/schedules" class="btn"><%= t('common.btn.cancel') %></a>
  </div>
</form>

<script>
var I18N = <%- JSON.stringify({
  manualExec: t('schedules.form.js.manualExec'),
  nextPrefix: t('schedules.form.js.nextPrefix'),
  savedEdit: t('schedules.form.js.savedEdit'),
  fail: t('schedules.form.js.failPrefix'),
  error: t('schedules.form.js.error')
}) %>;

document.querySelectorAll('input[name="server_scope"]').forEach(r => {
  r.addEventListener('change', e => {
    document.getElementById('groupRow').style.display = e.target.value === 'group' ? 'flex' : 'none';
  });
});

async function testCron() {
  const expr = document.getElementById('cronInput').value.trim();
  const out = document.getElementById('cronPreview');
  if (expr === 'manual') { out.innerHTML = '<strong>' + I18N.manualExec + '</strong>'; return; }
  try {
    const res = await fetch('/schedules/preview-cron?expr=' + encodeURIComponent(expr));
    const j = await res.json();
    if (j.status === 'success') {
      out.innerHTML = '<strong>' + j.humanized + '</strong>' + I18N.nextPrefix +
        j.next_runs.slice(0, 3).map(t => '<code>' + t + '</code>').join(', ');
    } else {
      out.innerHTML = '<span style="color:#c0392b;">⚠ ' + j.error + '</span>';
    }
  } catch (e) {
    out.innerHTML = '<span style="color:#c0392b;">⚠ ' + e.message + '</span>';
  }
}

document.getElementById('schForm').onsubmit = async (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const data = {};
  for (const [k, v] of fd.entries()) data[k] = v;
  data.notify_on_vuln    = fd.has('notify_on_vuln');
  data.notify_on_failure = fd.has('notify_on_failure');
  data.enabled           = fd.has('enabled');

  const res = await fetch('/schedules/<%= schedule.schedule_id %>/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.savedEdit);
    location.href = '/schedules';
  } else {
    alert(I18N.fail + (j.error || I18N.error));
  }
};
</script>

<%- include('../_footer') %>
