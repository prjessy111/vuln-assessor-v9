<%- include('../_header', { title: t('schedules.index.title'), activeMenu: 'schedules' }) %>

<div class="page-header">
  <h1><%= t('schedules.index.title') %></h1>
  <div class="header-actions">
    <a href="/diagnosis" class="btn"><%= t('schedules.index.backToDiag') %></a>
    <a href="/schedules/new" class="btn primary"><%= t('schedules.index.newSchedule') %></a>
  </div>
</div>

<div class="kpi-grid kpi-4col">
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('schedules.index.kpi.active') %></div>
    <div class="kpi-num"><%= kpi.activeSchedules %></div>
    <div class="kpi-sub"><%= t('schedules.index.kpi.activeSub', { n: kpi.totalSchedules }) %></div>
  </div>
  <div class="kpi-card kpi-running">
    <div class="kpi-label"><%= t('schedules.index.kpi.todayPending') %></div>
    <div class="kpi-num"><%= kpi.todayPending %></div>
    <div class="kpi-sub"><%= t('schedules.index.kpi.nextRun', { at: kpi.nextRunAt }) %></div>
  </div>
  <div class="kpi-card kpi-avg">
    <div class="kpi-label"><%= t('schedules.index.kpi.runs24h') %></div>
    <div class="kpi-num"><%= kpi.runs24h %></div>
    <div class="kpi-sub"><%= t('schedules.index.kpi.successRate', { n: kpi.successRate }) %></div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label"><%= t('schedules.index.kpi.notifications') %></div>
    <div class="kpi-num"><%= kpi.notifications %></div>
    <div class="kpi-sub"><%= t('schedules.index.kpi.last7d') %></div>
  </div>
</div>

<!-- 스케줄 목록 -->
<div class="section-box">
  <h3><%= t('schedules.index.listTitle') %></h3>
  <table class="data-table">
    <thead>
      <tr>
        <th><%= t('schedules.index.th.enabled') %></th>
        <th><%= t('schedules.index.th.name') %></th>
        <th><%= t('schedules.index.th.cron') %></th>
        <th><%= t('schedules.index.th.target') %></th>
        <th><%= t('schedules.index.th.ruleset') %></th>
        <th><%= t('schedules.index.th.lastRun') %></th>
        <th><%= t('schedules.index.th.lastStatus') %></th>
        <th><%= t('schedules.index.th.nextRun') %></th>
        <th><%= t('schedules.index.th.notify') %></th>
        <th><%= t('schedules.index.th.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% schedules.forEach(s => { %>
        <tr class="<%= !s.enabled ? 'rule-disabled' : '' %>">
          <td>
            <label class="toggle">
              <input type="checkbox" <%= s.enabled ? 'checked' : '' %> onchange="toggleSchedule(<%= s.schedule_id %>, this)">
              <span class="slider"></span>
            </label>
          </td>
          <td>
            <strong><%= s.name %></strong>
            <div class="muted small"><%= s.description %></div>
          </td>
          <td>
            <code class="cron-display"><%= s.cron_expr %></code>
            <div class="muted small"><%= s.cron_humanized %></div>
          </td>
          <td class="small">
            <% if (s.server_scope === 'all') { %>
              <span class="scope-badge scope-all"><%= t('schedules.index.scope.all', { n: s.target_count }) %></span>
            <% } else if (s.server_scope === 'group') { %>
              <span class="scope-badge scope-group"><%= t('schedules.index.scope.group', { name: s.server_group, n: s.target_count }) %></span>
            <% } else { %>
              <span class="scope-badge scope-list"><%= t('schedules.index.scope.list', { n: s.target_count }) %></span>
            <% } %>
          </td>
          <td class="mono small"><%= s.ruleset_ver %></td>
          <td class="mono small"><%= s.last_run_at || '-' %></td>
          <td>
            <% if (s.last_status === '성공') { %>
              <span class="status-badge st-success">✓ <%= s.last_success %>/<%= s.last_total %></span>
            <% } else if (s.last_status === '실패') { %>
              <span class="status-badge st-failed">✗ <%= t('schedules.index.status.failed') %></span>
            <% } else if (s.last_status === '부분실패') { %>
              <span class="status-badge st-warning">⚠ <%= s.last_success %>/<%= s.last_total %></span>
            <% } else if (s.last_status === '실행중') { %>
              <span class="status-badge st-running">▶ <%= t('schedules.index.status.running') %></span>
            <% } else { %>
              <span class="muted">-</span>
            <% } %>
          </td>
          <td class="mono small"><%= s.next_run_at %></td>
          <td>
            <% if (s.notify_on_vuln) { %><span class="notif-badge">🔔 <%= t('schedules.index.notif.vuln') %></span><% } %>
            <% if (s.notify_on_failure) { %><span class="notif-badge">🔔 <%= t('schedules.index.notif.failure') %></span><% } %>
          </td>
          <td>
            <button class="btn-sm primary" onclick="runNow(<%= s.schedule_id %>, '<%= s.name.replace(/'/g, "\\'") %>')"><%= t('schedules.index.runNow') %></button>
            <a href="/schedules/<%= s.schedule_id %>/edit" class="btn-sm"><%= t('schedules.index.edit') %></a>
            <button class="btn-sm" onclick="deleteSchedule(<%= s.schedule_id %>)"><%= t('common.btn.delete') %></button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- 실행 캘린더 -->
<div class="section-box">
  <h3><%= t('schedules.index.calTitle') %></h3>
  <div class="schedule-calendar">
    <div class="cal-header">
      <% days.forEach(d => { %>
        <div class="cal-day-header <%= d.is_today ? 'today' : '' %>">
          <div class="day-name"><%= d.day_name %></div>
          <div class="day-date"><%= d.date %></div>
        </div>
      <% }); %>
    </div>
    <div class="cal-body">
      <% days.forEach(d => { %>
        <div class="cal-day-body">
          <% d.events.forEach(e => { %>
            <div class="cal-event status-<%= e.status %>" title="<%= e.name %> at <%= e.time %>">
              <div class="event-time"><%= e.time %></div>
              <div class="event-name"><%= e.name %></div>
              <div class="event-target"><%= e.target %></div>
            </div>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<!-- 최근 실행 이력 -->
<div class="section-box">
  <h3><%= t('schedules.index.runsTitle') %></h3>
  <table class="data-table">
    <thead>
      <tr>
        <th><%= t('schedules.index.runsTh.run') %></th>
        <th><%= t('schedules.index.runsTh.schedule') %></th>
        <th><%= t('schedules.index.runsTh.startedAt') %></th>
        <th><%= t('schedules.index.runsTh.elapsed') %></th>
        <th><%= t('schedules.index.runsTh.trigger') %></th>
        <th><%= t('schedules.index.runsTh.status') %></th>
        <th><%= t('schedules.index.runsTh.result') %></th>
        <th><%= t('schedules.index.runsTh.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% runs.forEach(r => { %>
        <tr class="row-<%= r.status === '성공' ? 'success' : r.status === '실패' ? 'failed' : 'running' %>">
          <td class="mono small">#<%= String(r.run_id).slice(-6) %></td>
          <td><%= r.schedule_name %></td>
          <td class="mono small"><%= r.started_at %></td>
          <td><%= r.elapsed_ms ? fmtMs(r.elapsed_ms) : '-' %></td>
          <td>
            <span class="trigger-badge tr-<%= r.triggered_by %>">
              <%= r.triggered_by === 'cron' ? '⏰ ' + t('schedules.index.trigger.auto') :
                  r.triggered_by === 'manual' ? '👆 ' + t('schedules.index.trigger.manual') : '🔄 ' + t('schedules.index.trigger.retry') %>
            </span>
          </td>
          <td>
            <% if (r.status === '성공') { %>
              <span class="status-badge st-success">✓ <%= t('schedules.index.status.success') %></span>
            <% } else if (r.status === '실패') { %>
              <span class="status-badge st-failed">✗ <%= t('schedules.index.status.failed') %></span>
            <% } else if (r.status === '부분실패') { %>
              <span class="status-badge st-warning">⚠ <%= t('schedules.index.status.partial') %></span>
            <% } else { %>
              <span class="status-badge st-running">▶ <%= t('schedules.index.status.running') %></span>
            <% } %>
          </td>
          <td class="small">
            <% if (r.total_servers) { %>
              <%= t('schedules.index.result.success') %> <span class="b-safe"><%= r.success_count %></span> /
              <%= t('schedules.index.result.failed') %> <span class="b-vuln"><%= r.failed_count %></span> /
              <%= t('schedules.index.result.total') %> <%= r.total_servers %>
            <% } else { %>-<% } %>
          </td>
          <td>
            <a href="/schedules/runs/<%= r.run_id %>" class="btn-sm"><%= t('schedules.index.detailLog') %></a>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
var I18N = <%- JSON.stringify({
  fail: t('schedules.index.js.failPrefix'),
  error: t('schedules.index.js.error'),
  confirmRunNow: t('schedules.index.js.confirmRunNow'),
  running: t('schedules.index.js.running'),
  runDone: t('schedules.index.js.runDone'),
  confirmDelete: t('schedules.index.js.confirmDelete')
}) %>;

function toggleSchedule(id, el) {
  fetch('/schedules/' + id + '/toggle', { method: 'POST' })
    .then(r => r.json())
    .then(j => {
      if (j.status !== 'success') {
        alert(I18N.fail + (j.error || I18N.error));
        el.checked = !el.checked;
      } else {
        // 다음 실행 시각이 바뀔 수 있으니 새로고침
        location.reload();
      }
    })
    .catch(e => { alert(e); el.checked = !el.checked; });
}

function runNow(id, name) {
  if (!confirm(I18N.confirmRunNow.replace('{name}', name))) return;
  const btn = event.target;
  const orig = btn.textContent;
  btn.disabled = true;
  btn.textContent = I18N.running;
  fetch('/schedules/' + id + '/run-now', { method: 'POST' })
    .then(r => r.json())
    .then(j => {
      if (j.status === 'success') {
        alert(j.message || I18N.runDone);
        location.reload();
      } else {
        alert(I18N.fail + (j.error || I18N.error));
        btn.disabled = false;
        btn.textContent = orig;
      }
    })
    .catch(e => {
      alert(e);
      btn.disabled = false;
      btn.textContent = orig;
    });
}

function deleteSchedule(id) {
  if (!confirm(I18N.confirmDelete)) return;
  fetch('/schedules/' + id + '/delete', { method: 'POST' })
    .then(r => r.json())
    .then(j => {
      if (j.status === 'success') location.reload();
      else alert(I18N.fail + (j.error || I18N.error));
    });
}
</script>

<%- include('../_footer') %>
