<%- include('../_header', { title: isEdit ? t('schedules.form.titleEdit') : t('schedules.form.titleNew'), activeMenu: 'schedules' }) %>
<style>
  .host-tree { border:1px solid #e3e8ef; border-radius:8px; padding:12px 14px; margin-top:10px; background:#fafbfd; max-width:640px; }
  .host-group { margin-bottom:10px; }
  .host-group-head { display:block; padding:4px 0; border-bottom:1px solid #eef1f5; }
  .host-items { display:flex; flex-wrap:wrap; gap:6px 18px; padding:8px 0 0 18px; }
  .host-item { display:inline-flex; align-items:center; gap:6px; min-width:200px; cursor:pointer; }
  .host-item .hn { font-weight:600; }
  .picker-foot { margin-top:8px; padding-top:8px; border-top:1px dashed #d9e0ea; font-size:13px; color:#46505f; }
</style>

<div class="page-header">
  <h1><%= isEdit ? t('schedules.form.h1Edit', { id: schedule.schedule_id }) : t('schedules.form.h1New') %></h1>
  <p class="muted small">
    <%- t('schedules.form.cronIntroHtml') %>
  </p>
  <div class="header-actions">
    <a href="/schedules" class="btn"><%= t('schedules.form.back') %></a>
  </div>
</div>

<form id="schForm" class="form-container">
  <div class="form-section">
    <h3><%= t('schedules.form.basicInfo') %></h3>
    <div class="form-row inline">
      <label><%= t('schedules.form.nameLabel') %></label>
      <input type="text" name="name" required maxlength="80"
             value="<%= isEdit ? schedule.name : '' %>"
             placeholder="<%= t('schedules.form.namePh') %>">
    </div>
    <div class="form-row inline">
      <label><%= t('schedules.form.descLabel') %></label>
      <input type="text" name="description" maxlength="200"
             value="<%= isEdit ? (schedule.description || '') : '' %>"
             placeholder="<%= t('schedules.form.descPh') %>">
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.runInterval') %></h3>
    <div class="form-row inline">
      <label><%= t('schedules.form.cronLabel') %></label>
      <input type="text" id="cronInput" name="cron_expr" required
             value="<%= isEdit ? schedule.cron_expr : '0 2 * * *' %>"
             placeholder="<%= t('schedules.form.cronPh') %>">
      <button type="button" class="btn-sm" onclick="testCron()"><%= t('schedules.form.preview') %></button>
    </div>
    <p class="muted small" id="cronPreview">
      <%- t('schedules.form.cronFormatHtml') %>
    </p>
    <div class="form-row inline">
      <label><%= t('schedules.form.quickSelect') %></label>
      <select onchange="if(this.value) { document.getElementById('cronInput').value = this.value; testCron(); }">
        <option value=""><%= t('schedules.form.quickPatterns') %></option>
        <option value="0 2 * * *"><%= t('schedules.form.opt.daily2Night') %></option>
        <option value="0 */6 * * *"><%= t('schedules.form.opt.every6h') %></option>
        <option value="0 * * * *"><%= t('schedules.form.opt.hourly') %></option>
        <option value="*/15 * * * *"><%= t('schedules.form.opt.every15m') %></option>
        <option value="0 3 * * 0"><%= t('schedules.form.opt.sun3') %></option>
        <option value="0 3 1 * *"><%= t('schedules.form.opt.monthly1') %></option>
        <option value="manual"><%= t('schedules.form.opt.manualOnly') %></option>
      </select>
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.targetServers') %></h3>
    <%
      // 편집 시 기존 선택 id 정규화
      var selIds = [];
      if (isEdit && schedule.server_ids) {
        selIds = (Array.isArray(schedule.server_ids) ? schedule.server_ids : String(schedule.server_ids).split(',')).map(function(x){ return String(x).trim(); }).filter(Boolean);
      }
      var isList = isEdit && schedule.server_scope === 'list';
      // OS별 그룹화
      var osGroups = {};
      (servers || []).forEach(function(s){ var k = (s.os_type || t('schedules.form.osOther')); (osGroups[k] = osGroups[k] || []).push(s); });
    %>
    <div class="radio-group">
      <label>
        <input type="radio" name="server_scope" value="all" <%= isList ? '' : 'checked' %>>
        <strong><%= t('schedules.form.allServers') %></strong>
        <span class="muted small"><%= t('schedules.form.allServersSub', { n: (servers||[]).length }) %></span>
      </label>
      <label>
        <input type="radio" name="server_scope" value="list" <%= isList ? 'checked' : '' %>>
        <strong><%= t('schedules.form.listSelect') %></strong>
        <span class="muted small"><%= t('schedules.form.listSelectSub') %></span>
      </label>
    </div>

    <div id="hostPicker" class="host-tree" style="display:<%= isList ? '' : 'none' %>;">
      <% Object.keys(osGroups).forEach(function(osk){ var grp = osGroups[osk]; %>
        <div class="host-group">
          <label class="host-group-head">
            <input type="checkbox" class="os-all" data-os="<%= osk %>"> <strong><%= String(osk).toUpperCase() %></strong>
            <span class="muted small"><%= t('schedules.form.unitServersParen', { n: grp.length }) %></span>
          </label>
          <div class="host-items">
            <% grp.forEach(function(s){ %>
              <label class="host-item">
                <input type="checkbox" class="host-chk" value="<%= s.server_id %>" data-os="<%= osk %>"
                       <%= selIds.includes(String(s.server_id)) ? 'checked' : '' %>>
                <span class="hn"><%= s.hostname %></span>
                <span class="muted small"><%= s.ip_address %></span>
              </label>
            <% }); %>
          </div>
        </div>
      <% }); %>
      <div class="picker-foot"><%- t('schedules.form.selCountHtml') %></div>
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.notifySection') %></h3>
    <div class="form-row inline">
      <label>
        <input type="checkbox" name="notify_on_vuln" value="on"
               <%= isEdit && schedule.notify_on_vuln ? 'checked' : '' %>>
        <%= t('schedules.form.notifyOnVuln') %>
      </label>
    </div>
    <div class="form-row inline">
      <label>
        <input type="checkbox" name="notify_on_failure" value="on"
               <%= isEdit && schedule.notify_on_failure ? 'checked' : '' %>>
        <%= t('schedules.form.notifyOnFailure') %>
      </label>
    </div>
    <p class="muted small">
      <%- t('schedules.form.channelHtml') %>
    </p>
  </div>

  <div class="form-section">
    <h3><%= t('schedules.form.statusSection') %></h3>
    <div class="form-row inline">
      <label>
        <input type="checkbox" name="enabled" value="on"
               <%= (!isEdit || schedule.enabled) ? 'checked' : '' %>>
        <%= t('schedules.form.enabledLabel') %>
      </label>
    </div>
  </div>

  <% if (isEdit) { %>
    <div class="form-section">
      <h3><%= t('schedules.form.refInfo') %></h3>
      <table class="data-table" style="max-width:500px;">
        <tr><th><%= t('schedules.form.created') %></th><td class="mono small"><%= schedule.created_at || '-' %> (<%= schedule.created_by || '-' %>)</td></tr>
        <tr><th><%= t('schedules.form.lastRun') %></th><td class="mono small"><%= schedule.last_run_at || '-' %></td></tr>
        <tr><th><%= t('schedules.form.lastStatus') %></th><td><%= td(schedule.last_status) || '-' %></td></tr>
        <tr><th><%= t('schedules.form.nextRunCalc') %></th><td class="mono small"><%= schedule.next_run_at || '-' %></td></tr>
      </table>
    </div>
  <% } %>

  <div class="form-actions">
    <button type="submit" class="btn primary"><%= isEdit ? t('common.btn.save') : t('schedules.form.register') %></button>
    <a href="/schedules" class="btn"><%= t('common.btn.cancel') %></a>
  </div>
</form>

<script>
var I18N = <%- JSON.stringify({
  enterExpr: t('schedules.form.js.enterExpr'),
  manualExec: t('schedules.form.js.manualExec'),
  manualDetail: t('schedules.form.js.manualDetail'),
  nextRunsPrefix: t('schedules.form.js.nextRunsPrefix'),
  selectAtLeastOne: t('schedules.form.js.selectAtLeastOne'),
  saved: isEdit ? t('schedules.form.js.savedEdit') : t('schedules.form.js.savedNew'),
  fail: t('schedules.form.js.failPrefix'),
  error: t('schedules.form.js.error')
}) %>;

// 대상 서버 — 전체/개별 토글 + OS 전체선택 + 카운트
const hostPicker = document.getElementById('hostPicker');
function updateSelCount() {
  const n = document.querySelectorAll('.host-chk:checked').length;
  const el = document.getElementById('selCount'); if (el) el.textContent = n;
}
document.querySelectorAll('input[name="server_scope"]').forEach(r => {
  r.addEventListener('change', e => {
    if (hostPicker) hostPicker.style.display = e.target.value === 'list' ? '' : 'none';
  });
});
document.querySelectorAll('.os-all').forEach(cb => {
  cb.addEventListener('change', e => {
    const os = e.target.dataset.os;
    document.querySelectorAll('.host-chk[data-os="' + os + '"]').forEach(h => { h.checked = e.target.checked; });
    updateSelCount();
  });
});
document.querySelectorAll('.host-chk').forEach(cb => cb.addEventListener('change', updateSelCount));
updateSelCount();

async function testCron() {
  const expr = document.getElementById('cronInput').value.trim();
  const out = document.getElementById('cronPreview');
  if (!expr) { out.textContent = I18N.enterExpr; return; }
  if (expr === 'manual') {
    out.innerHTML = '<strong>' + I18N.manualExec + '</strong>' + I18N.manualDetail;
    return;
  }
  try {
    const res = await fetch('/schedules/preview-cron?expr=' + encodeURIComponent(expr));
    const j = await res.json();
    if (j.status === 'success') {
      out.innerHTML = '<strong>' + j.humanized + '</strong>' + I18N.nextRunsPrefix +
        j.next_runs.map(t => '<code>' + t + '</code>').join(', ');
    } else {
      out.innerHTML = '<span style="color:#c0392b;">⚠ ' + j.error + '</span>';
    }
  } catch (e) {
    out.innerHTML = '<span style="color:#c0392b;">⚠ ' + e.message + '</span>';
  }
}

document.getElementById('schForm').onsubmit = async (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const data = {};
  for (const [k, v] of fd.entries()) data[k] = v;
  // checkbox unchecked 처리
  data.notify_on_vuln    = fd.has('notify_on_vuln');
  data.notify_on_failure = fd.has('notify_on_failure');
  data.enabled           = fd.has('enabled');
  // 대상 서버
  if (data.server_scope === 'list') {
    const ids = [...document.querySelectorAll('.host-chk:checked')].map(c => c.value);
    if (!ids.length) { alert(I18N.selectAtLeastOne); return; }
    data.server_ids = ids;
    data.target_count = ids.length;
    data.server_group = null;
  } else {
    data.server_ids = null;
    data.server_group = null;
    data.target_count = <%= (servers||[]).length %>;
  }

  const url = '<%= isEdit ? "/schedules/" + schedule.schedule_id + "/update" : "/schedules/save" %>';
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.saved);
    location.href = '/schedules';
  } else {
    alert(I18N.fail + (j.error || I18N.error));
  }
};
</script>

<%- include('../_footer') %>
