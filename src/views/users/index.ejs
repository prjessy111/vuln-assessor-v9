<%- include('../_header', { title: t('users.title'), activeMenu: 'users' }) %>

<div class="page-header">
  <h1><%= t('users.title') %></h1>
  <p class="muted small">
    <%- t('users.index.desc') %>
  </p>
  <div class="header-actions">
    <a href="/users/new" class="btn primary"><%= t('users.index.addUser') %></a>
  </div>
</div>

<div class="kpi-grid kpi-4col">
  <div class="kpi-card kpi-total">
    <div class="kpi-label"><%= t('users.index.kpi.total') %></div>
    <div class="kpi-num"><%= users.length %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('users.index.kpi.active') %></div>
    <div class="kpi-num"><%= users.filter(u => u.enabled).length %></div>
  </div>
  <div class="kpi-card" style="border-top-color: #8e44ad;">
    <div class="kpi-label"><%= t('users.index.kpi.admin') %></div>
    <div class="kpi-num" style="color: #8e44ad;"><%= users.filter(u => u.role === 'admin').length %></div>
  </div>
  <div class="kpi-card" style="border-top-color: #95a5a6;">
    <div class="kpi-label"><%= t('users.index.kpi.inactive') %></div>
    <div class="kpi-num" style="color: #95a5a6;"><%= users.filter(u => !u.enabled).length %></div>
  </div>
</div>

<% var pendingUsers = users.filter(u => u.pending && !u.enabled); %>
<% if (pendingUsers.length) { %>
<div class="section-box" style="border-left:4px solid #e67e22;">
  <h3>⏳ <%= t('users.index.pending.title') %> (<%= pendingUsers.length %>)</h3>
  <p class="muted small"><%= t('users.index.pending.desc') %></p>
  <table class="data-table">
    <thead>
      <tr>
        <th><%= t('users.index.th.username') %></th>
        <th><%= t('users.index.th.name') %></th>
        <th><%= t('users.index.th.email') %></th>
        <th><%= t('users.index.th.createdAt') %></th>
        <th><%= t('users.index.pending.grantRole') %></th>
        <th><%= t('users.index.th.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% pendingUsers.forEach(u => { %>
        <tr>
          <td class="mono"><strong><%= u.username %></strong></td>
          <td><%= u.name %></td>
          <td class="small"><%= u.email || '-' %></td>
          <td class="small mono"><%= u.created_at %></td>
          <td>
            <select id="role-<%= u.user_id %>">
              <option value="viewer">👁 <%= t('users.role.viewer') %></option>
              <option value="operator">🔧 <%= t('users.role.operator') %></option>
              <option value="admin">👑 <%= t('users.role.admin') %></option>
            </select>
          </td>
          <td>
            <button class="btn-sm primary" onclick="approveUser(<%= u.user_id %>, '<%= u.username %>')"><%= t('users.index.pending.approve') %></button>
            <button class="btn-sm" onclick="rejectUser(<%= u.user_id %>, '<%= u.username %>')" style="background:#c0392b;color:#fff;"><%= t('users.index.pending.reject') %></button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

<div class="section-box">
  <h3><%= t('users.index.listTitle') %></h3>
  <table class="data-table">
    <thead>
      <tr>
        <th>ID</th>
        <th><%= t('users.index.th.username') %></th>
        <th><%= t('users.index.th.name') %></th>
        <th><%= t('users.index.th.email') %></th>
        <th><%= t('users.index.th.role') %></th>
        <th><%= t('users.index.th.enabled') %></th>
        <th><%= t('users.index.th.lastLogin') %></th>
        <th><%= t('users.index.th.createdAt') %></th>
        <th><%= t('users.index.th.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% users.filter(u => !(u.pending && !u.enabled)).forEach(u => { %>
        <tr class="<%= !u.enabled ? 'row-disabled' : '' %>">
          <td class="mono">#<%= u.user_id %></td>
          <td class="mono"><strong><%= u.username %></strong>
            <% if (u.must_change_password) { %>
              <div class="muted small" style="color:#e67e22;"><%= t('users.index.mustChangePw') %></div>
            <% } %>
          </td>
          <td><%= u.name %></td>
          <td class="small"><%= u.email || '-' %></td>
          <td>
            <% if (u.role === 'admin') { %>
              <span class="role-badge role-admin">👑 <%= t('users.role.admin') %></span>
            <% } else if (u.role === 'operator') { %>
              <span class="role-badge role-operator">🔧 <%= t('users.role.operator') %></span>
            <% } else { %>
              <span class="role-badge role-viewer">👁 <%= t('users.role.viewer') %></span>
            <% } %>
          </td>
          <td>
            <% if (u.enabled) { %>
              <span class="status-cell st-safe"><%= t('users.index.active') %></span>
            <% } else { %>
              <span class="status-cell st-na"><%= t('users.index.inactive') %></span>
            <% } %>
          </td>
          <td class="small mono"><%= u.last_login_at || t('users.index.none') %></td>
          <td class="small mono"><%= u.created_at %></td>
          <td>
            <a href="/users/<%= u.user_id %>/edit" class="btn-sm"><%= t('users.index.editBtn') %></a>
            <% if (u.user_id != currentUser.user_id) { %>
              <button class="btn-sm" onclick="deleteUser(<%= u.user_id %>, '<%= u.username %>')" style="background:#c0392b;color:#fff;"><%= t('common.btn.delete') %></button>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="info-box">
  <h4><%= t('users.index.roleGuide.title') %></h4>
  <ul>
    <li><strong>👑 <%= t('users.role.adminFull') %></strong>: <%= t('users.index.roleGuide.admin') %></li>
    <li><strong>🔧 <%= t('users.role.operatorFull') %></strong>: <%= t('users.index.roleGuide.operator') %></li>
    <li><strong>👁 <%= t('users.role.viewerFull') %></strong>: <%= t('users.index.roleGuide.viewer') %></li>
  </ul>
</div>

<script>
const I18N = <%- JSON.stringify({
  deleteConfirm: t('users.index.js.deleteConfirm'),
  deleted: t('users.index.js.deleted'),
  failPrefix: t('users.index.js.failPrefix'),
  errWord: t('users.index.js.errWord'),
  approveConfirm: t('users.index.js.approveConfirm'),
  approved: t('users.index.js.approved'),
  rejectConfirm: t('users.index.js.rejectConfirm'),
  rejected: t('users.index.js.rejected')
}) %>;
async function deleteUser(id, username) {
  if (!confirm(I18N.deleteConfirm.split('{username}').join(username))) return;
  const res = await fetch('/users/' + id + '/delete', { method: 'POST' });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.deleted);
    location.reload();
  } else {
    alert(I18N.failPrefix + (j.error || I18N.errWord));
  }
}
async function approveUser(id, username) {
  const role = document.getElementById('role-' + id).value;
  if (!confirm(I18N.approveConfirm.split('{username}').join(username).split('{role}').join(role))) return;
  const res = await fetch('/users/' + id + '/approve', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'role=' + encodeURIComponent(role)
  });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.approved);
    location.reload();
  } else {
    alert(I18N.failPrefix + (j.error || I18N.errWord));
  }
}
async function rejectUser(id, username) {
  if (!confirm(I18N.rejectConfirm.split('{username}').join(username))) return;
  const res = await fetch('/users/' + id + '/delete', { method: 'POST' });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.rejected);
    location.reload();
  } else {
    alert(I18N.failPrefix + (j.error || I18N.errWord));
  }
}
</script>

<%- include('../_footer') %>
