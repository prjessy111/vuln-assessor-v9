<%- include('../_header', { title: isEdit ? t('users.form.titleEdit') : t('users.form.titleNew'), activeMenu: 'users' }) %>

<div class="page-header">
  <h1><%= isEdit ? t('users.form.headEdit', { id: user.user_id }) : t('users.form.titleNew') %></h1>
</div>

<form id="userForm" class="form-container">
  <div class="form-section">
    <h3><%= t('users.form.basicInfo') %></h3>
    <div class="form-row inline">
      <label><%= t('users.form.username') %> *</label>
      <input type="text" name="username" required pattern="[a-zA-Z0-9_]{3,30}"
             value="<%= isEdit ? user.username : '' %>"
             <%= isEdit ? 'readonly' : '' %>
             placeholder="<%= t('users.form.usernamePh') %>">
      <% if (isEdit) { %>
        <span class="muted small"><%= t('users.form.usernameFixed') %></span>
      <% } %>
    </div>
    <div class="form-row inline">
      <label><%= t('users.form.name') %> *</label>
      <input type="text" name="name" required maxlength="50"
             value="<%= isEdit ? user.name : '' %>"
             placeholder="<%= t('users.form.namePh') %>">
    </div>
    <div class="form-row inline">
      <label><%= t('users.form.email') %></label>
      <input type="email" name="email" maxlength="100"
             value="<%= isEdit ? (user.email || '') : '' %>"
             placeholder="example@lsware.com">
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('users.form.pwSection') %></h3>
    <% if (isEdit) { %>
      <p class="muted small">
        <%= t('users.form.pwKeepHint') %>
      </p>
    <% } %>
    <div class="form-row inline">
      <label><%= isEdit ? t('users.form.newPassword') : t('users.form.password') + ' *' %></label>
      <input type="password" name="password"
             <%= isEdit ? '' : 'required' %>
             minlength="8"
             placeholder="<%= t('users.form.min8') %>">
    </div>
    <div class="form-row inline">
      <label><%= t('users.form.pwConfirm') %> <%= isEdit ? '' : '*' %></label>
      <input type="password" name="password_confirm"
             <%= isEdit ? '' : 'required' %>
             placeholder="<%= t('users.form.retype') %>">
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('users.form.roleSection') %></h3>
    <div class="radio-group">
      <label>
        <input type="radio" name="role" value="admin"
               <%= isEdit && user.role === 'admin' ? 'checked' : '' %>>
        <strong>👑 <%= t('users.form.roleAdmin') %></strong>
        <span class="muted small"><%= t('users.form.roleAdminDesc') %></span>
      </label>
      <label>
        <input type="radio" name="role" value="operator"
               <%= !isEdit || user.role === 'operator' ? 'checked' : '' %>>
        <strong>🔧 <%= t('users.form.roleOperator') %></strong>
        <span class="muted small"><%= t('users.form.roleOperatorDesc') %></span>
      </label>
      <label>
        <input type="radio" name="role" value="viewer"
               <%= isEdit && user.role === 'viewer' ? 'checked' : '' %>>
        <strong>👁 <%= t('users.form.roleViewer') %></strong>
        <span class="muted small"><%= t('users.form.roleViewerDesc') %></span>
      </label>
    </div>
  </div>

  <% if (isEdit) { %>
    <div class="form-section">
      <h3><%= t('users.form.statusSection') %></h3>
      <div class="form-row inline">
        <label><%= t('users.form.enabled') %></label>
        <input type="checkbox" name="enabled" value="1" <%= user.enabled ? 'checked' : '' %>>
        <span class="muted small"><%= t('users.form.disabledHint') %></span>
      </div>
    </div>
  <% } %>

  <div class="form-actions">
    <button type="submit" class="btn primary"><%= isEdit ? t('common.btn.save') : t('users.form.addUser') %></button>
    <a href="/users" class="btn"><%= t('common.btn.cancel') %></a>
  </div>
</form>

<script>
const I18N = <%- JSON.stringify({
  pwMismatch: t('users.form.js.pwMismatch'),
  done: isEdit ? t('users.form.js.updated') : t('users.form.js.added'),
  failPrefix: t('users.form.js.failPrefix'),
  errWord: t('users.form.js.errWord')
}) %>;
document.getElementById('userForm').onsubmit = async (e) => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));

  if (data.password && data.password !== data.password_confirm) {
    alert(I18N.pwMismatch);
    return;
  }
  delete data.password_confirm;

  const url = '<%= isEdit ? "/users/" + user.user_id + "/update" : "/users/save" %>';
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.done);
    location.href = '/users';
  } else {
    alert(I18N.failPrefix + (j.error || I18N.errWord));
  }
};
</script>

<%- include('../_footer') %>
