<%- include('../_header', { title: t('users.password.title'), activeMenu: '' }) %>

<div class="page-header">
  <h1><%= t('users.password.title') %></h1>
  <% if (typeof mustChange !== 'undefined' && mustChange) { %>
    <div class="alert alert-warning">
      <strong><%= t('users.password.mustChangeTitle') %></strong><br>
      <%= t('users.password.mustChangeDesc') %>
    </div>
  <% } %>
</div>

<form id="pwForm" class="form-container">
  <div class="form-section">
    <h3><%= t('users.password.title') %></h3>
    <div class="form-row inline">
      <label><%= t('users.password.current') %> *</label>
      <input type="password" name="current_password" required>
    </div>
    <div class="form-row inline">
      <label><%= t('users.password.new') %> *</label>
      <input type="password" name="new_password" required minlength="8"
             placeholder="<%= t('users.password.newPh') %>">
    </div>
    <div class="form-row inline">
      <label><%= t('users.password.newConfirm') %> *</label>
      <input type="password" name="new_password_confirm" required>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn primary"><%= t('users.password.change') %></button>
    <% if (typeof mustChange === 'undefined' || !mustChange) { %>
      <a href="/" class="btn"><%= t('common.btn.cancel') %></a>
    <% } %>
  </div>
</form>

<script>
const I18N = <%- JSON.stringify({
  mismatch: t('users.password.js.mismatch'),
  sameAsCurrent: t('users.password.js.sameAsCurrent'),
  changed: t('users.password.js.changed'),
  failPrefix: t('users.password.js.failPrefix'),
  errWord: t('users.password.js.errWord')
}) %>;
document.getElementById('pwForm').onsubmit = async (e) => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));

  if (data.new_password !== data.new_password_confirm) {
    alert(I18N.mismatch);
    return;
  }
  if (data.new_password === data.current_password) {
    alert(I18N.sameAsCurrent);
    return;
  }

  const res = await fetch('/users/me/password', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  const j = await res.json();
  if (j.status === 'success') {
    alert(I18N.changed);
    location.href = '/';
  } else {
    alert(I18N.failPrefix + (j.error || I18N.errWord));
  }
};
</script>

<%- include('../_footer') %>
