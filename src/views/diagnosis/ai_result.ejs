  <table class="data-table" style="max-width:700px;">
    <tr><th style="width:160px;"><%= t('diagnosis.aiResult.meta.server') %></th>
        <td><%= diag.hostname %> (#<%= diag.server_id %>) — <%= diag.asset_no || '-' %></td></tr>
    <tr><th><%= t('diagnosis.aiResult.meta.assessedAt') %></th><td class="mono"><%= diag.executed_at %> (<%= t('diagnosis.aiResult.meta.elapsed', { v: (function(ms){ms=Number(ms)||0; var s=Math.round(ms/1000); return s<60 ? t('diagnosis.aiResult.meta.sec', { n: s }) : t('diagnosis.aiResult.meta.minSec', { m: Math.floor(s/60), s: s%60 });})(diag.elapsed_ms) }) %>)</td></tr>
    <tr><th><%= t('diagnosis.aiResult.meta.executor') %></th><td><%= diag.executed_by %> / <%= diag.triggered_by %></td></tr>
    <tr><th><%= t('diagnosis.aiResult.meta.llm') %></th><td><code><%= diag.llm_provider %></code> / <code><%= diag.llm_model || '-' %></code></td></tr>
    <tr><th><%= t('diagnosis.aiResult.meta.source') %></th><td><code><%= diag.source_type || 'secums' %></code></td></tr>
    <% if (diag.secums_file || diag.script_file) { %>
      <tr><th><%= t('diagnosis.aiResult.meta.files') %></th>
          <td>
            <% if (diag.secums_file) { %><div>SecuMS: <code><%= diag.secums_file %></code></div><% } %>
            <% if (diag.script_file) { %><div>Script: <code><%= diag.script_file %></code></div><% } %>
          </td></tr>
    <% } %>
    <% if (diag.secums_wait_count) { %>
      <tr><th><%= t('diagnosis.aiResult.meta.waitInfer') %></th>
          <td><strong style="color:#1976d2;"><%= t('common.unit.count', { n: diag.secums_wait_count }) %></strong>
              <%= t('diagnosis.aiResult.meta.waitInferDesc') %></td></tr>
    <% } %>
  </table>
</div>

<div class="section-box">
  <h3><%= t('diagnosis.aiResult.vcls.title') %></h3>
  <table class="data-table" style="max-width:760px;">
