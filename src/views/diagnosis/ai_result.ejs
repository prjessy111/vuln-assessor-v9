      <tr><th><%= t('diagnosis.aiResult.vcls.thClass') %></th><th><%= t('diagnosis.aiResult.vcls.thCount') %></th><th><%= t('diagnosis.aiResult.vcls.thMeaning') %></th></tr>
    </thead>
    <tbody>
      <tr>
        <td><strong style="color:#27ae60;"><%= t('diagnosis.aiResult.vcls.agree') %></strong></td>
        <td><%= diag.agree_count || 0 %></td>
        <td class="muted small"><%= t('diagnosis.aiResult.vcls.agreeDesc') %></td>
      </tr>
      <tr>
        <td><strong style="color:#c0392b;"><%= t('diagnosis.aiResult.vcls.fail') %></strong></td>
        <td><%= disagreeRealCount %></td>
        <td class="muted small"><%= t('diagnosis.aiResult.vcls.failDesc', { n: validationFailureRate }) %></td>
      </tr>
      <tr>
        <td><strong style="color:#e67e22;"><%= t('diagnosis.aiResult.vcls.review') %></strong></td>
        <td><%= needsReviewCount %></td>
        <td class="muted small"><%= t('diagnosis.aiResult.vcls.reviewDesc') %></td>
      </tr>
      <tr>
        <td><strong style="color:#1976d2;"><%= t('diagnosis.aiResult.vcls.wait') %></strong></td>
        <td><%= diag.secums_wait_count || 0 %></td>
        <td class="muted small"><%= t('diagnosis.aiResult.vcls.waitDesc') %></td>
      </tr>
    </tbody>
  </table>
</div>

<!-- 플랫폼별(OS/DB/WAS) 분포 -->
<% var _pf = (typeof byPlatform !== 'undefined') ? byPlatform : null;
   var _pfActive = _pf ? Object.entries(_pf).filter(function(e){ return e[1].total > 0; }) : []; %>
<% if (_pfActive.length > 0) { %>
<div class="section-box">
  <h3><%= t('diagnosis.aiResult.pf.title') %></h3>
  <table class="data-table" style="max-width:800px;">
    <thead>
      <tr><th><%= t('diagnosis.aiResult.pf.thType') %></th><th><%= t('diagnosis.aiResult.pf.thTotal') %></th><th><%= t('diagnosis.aiResult.pf.thVuln') %></th><th><%= t('diagnosis.aiResult.pf.thSafe') %></th><th><%= t('diagnosis.aiResult.pf.thNaInfo') %></th></tr>
    </thead>
    <tbody>
      <% var _pfLabel = { OS: t('diagnosis.aiResult.pf.os'), DB: t('diagnosis.aiResult.pf.db'), WAS: t('diagnosis.aiResult.pf.was') }; %>
