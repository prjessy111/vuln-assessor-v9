  <h3><%= t('diagnosis.aiResult.cat.title') %></h3>
  <table class="data-table" style="max-width:800px;">
    <thead>
      <tr><th><%= t('diagnosis.aiResult.cat.thCategory') %></th><th><%= t('diagnosis.aiResult.cat.thTotal') %></th><th><%= t('diagnosis.aiResult.cat.thVuln') %></th><th><%= t('diagnosis.aiResult.cat.thSafe') %></th><th><%= t('diagnosis.aiResult.cat.thNaInfo') %></th></tr>
