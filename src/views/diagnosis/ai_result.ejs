<%- include('../_header', { title: (diag.diagnose_type === 'llm' ? t('diagnosis.aiResult.titleLlm') : t('diagnosis.aiResult.titleAi')) + ' #' + diag.assessment_id, activeMenu: 'diagnosis' }) %>

<div class="page-header">
  <h1><%= diag.diagnose_type === 'llm' ? t('diagnosis.aiResult.titleLlm') : t('diagnosis.aiResult.titleAi') %> — #<%= diag.assessment_id %></h1>
  <p class="muted small">
    <%= resultScope && resultScope.description ? resultScope.description : t('diagnosis.aiResult.descDefault') %>
    <%= t('diagnosis.aiResult.descCompare') %>
    <%- t('diagnosis.aiResult.descGenerated') %>
  </p>
  <div class="header-actions">
    <a href="/diagnosis" class="btn"><%= t('diagnosis.aiResult.btnBack') %></a>
    <% if (baseAiDiag) { %>
      <a href="/diagnosis/<%= baseAiDiag.assessment_id %>/ai" class="btn primary"><%= t('diagnosis.aiResult.btnAiFull', { id: baseAiDiag.assessment_id }) %></a>
    <% } %>
    <a href="/diagnosis/<%= diag.assessment_id %>/cve" class="btn"><%= t('diagnosis.aiResult.btnCve') %></a>
    <button type="button" id="btnRediagnose" class="btn"
            style="background:#e67e22;color:#fff;"
            data-server="<%= diag.server_id %>"
            data-source="<%= diag.source_type || 'secums' %>"
            data-base="<%= diag.assessment_id %>"
            onclick="rediagnoseReviewNeeded(this)"><%= t('diagnosis.aiResult.btnRediagnose') %></button>
  </div>
</div>

<script>
async function rediagnoseReviewNeeded(btn) {
  if (!confirm(<%- JSON.stringify(t('diagnosis.aiResult.confirmRediagnose')) %>)) return;
  var orig = btn.textContent;
  btn.disabled = true; btn.textContent = <%- JSON.stringify(t('diagnosis.aiResult.rediagRunning')) %>;
  try {
    var resp = await fetch('/diagnosis/llm-run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        server_id: btn.dataset.server,
        source: btn.dataset.source,
        filter: 'review_needed',
        base_assessment_id: btn.dataset.base
      })
    });
    var data = await resp.json();
    if (resp.ok && data.status === 'success' && data.assessment_id) {
      btn.textContent = <%- JSON.stringify(t('diagnosis.aiResult.rediagDone')) %>;
      location.href = '/diagnosis/' + data.assessment_id + '/ai';
    } else {
      alert(<%- JSON.stringify(t('diagnosis.aiResult.rediagFailPrefix')) %> + (data.error || resp.status));
      btn.disabled = false; btn.textContent = orig;
    }
  } catch (e) {
    alert(<%- JSON.stringify(t('diagnosis.aiResult.rediagErrPrefix')) %> + e.message);
    btn.disabled = false; btn.textContent = orig;
  }
}
</script>

<%
  var isLlmDetail = diag.diagnose_type === 'llm';
  var isAiFull = diag.diagnose_type === 'ai';
  var filterText = '';
  if (diag.filter) {
    filterText = typeof diag.filter === 'object' ? JSON.stringify(diag.filter) : String(diag.filter);
  } else {
    filterText = isLlmDetail ? 'all' : '-';
  }
  var disagreeRealCount = typeof diag.disagree_real_count === 'number' ? diag.disagree_real_count : (diag.disagree_count || 0);
  var needsReviewCount = diag.needs_review_count || 0;
  var comparisonCount = typeof diag.comparison_count === 'number' ? diag.comparison_count : ((diag.agree_count || 0) + disagreeRealCount);
  var validationFailureRate = typeof diag.validation_failure_rate === 'number'
    ? diag.validation_failure_rate
    : (comparisonCount ? Math.round(disagreeRealCount / comparisonCount * 100) : 0);
%>

<div class="section-box">
  <h3><%= t('diagnosis.aiResult.scope.title') %></h3>
  <table class="data-table" style="max-width:860px;">
    <tr>
      <th style="width:180px;"><%= t('diagnosis.aiResult.scope.current') %></th>
      <td>
        <strong><%= resultScope ? resultScope.label : (isLlmDetail ? t('diagnosis.aiResult.scope.labelLlm') : t('diagnosis.aiResult.scope.labelAi')) %></strong>
        <span class="muted small">(#<%= diag.assessment_id %>)</span>
      </td>
    </tr>
    <% if (isLlmDetail) { %>
      <tr>
        <th><%= t('diagnosis.aiResult.scope.criteria') %></th>
        <td><%= t('diagnosis.aiResult.scope.criteriaLlm') %></td>
      </tr>
      <tr>
        <th><%= t('diagnosis.aiResult.scope.llmFilter') %></th>
        <td><code><%= filterText %></code></td>
      </tr>
      <tr>
        <th><%= t('diagnosis.aiResult.scope.aiFull') %></th>
        <td>
          <% if (baseAiDiag) { %>
            <a href="/diagnosis/<%= baseAiDiag.assessment_id %>/ai">#<%= baseAiDiag.assessment_id %></a>
            <span class="muted small"><%= t('diagnosis.aiResult.scope.aiFullCounts', { a: baseAiDiag.total_count || 0, b: diag.total_count || 0 }) %></span>
          <% } else { %>
            <span class="muted"><%= t('diagnosis.aiResult.scope.noBase') %></span>
          <% } %>
        </td>
      </tr>
    <% } else { %>
      <tr>
        <th><%= t('diagnosis.aiResult.scope.criteria') %></th>
        <td><%= t('diagnosis.aiResult.scope.criteriaAi') %></td>
      </tr>
      <% if (relatedLlmDiags && relatedLlmDiags.length) { %>
        <tr>
          <th><%= t('diagnosis.aiResult.scope.relatedLlm') %></th>
          <td>
            <% relatedLlmDiags.forEach(function(d, idx) { %>
              <% if (idx > 0) { %><span class="muted"> / </span><% } %>
              <a href="/diagnosis/<%= d.assessment_id %>/ai">#<%= d.assessment_id %></a>
              <span class="muted small"><%= t('diagnosis.aiResult.scope.itemCount', { n: d.total_count || 0 }) %></span>
            <% }) %>
          </td>
        </tr>
      <% } %>
    <% } %>
  </table>
</div>

<!-- 핵심 KPI -->
