<!-- 심각도 분포 (취약 항목만) -->
<% if (diag.vuln_count > 0) { %>
<div class="section-box">
  <h3><%= t('diagnosis.aiResult.sev.title') %></h3>
  <div style="display:flex;gap:1.5rem;">
    <div><span style="color:#c0392b;font-weight:600;"><%= t('diagnosis.aiResult.sev.high', { n: bySeverity.상 || 0 }) %></span></div>
    <div><span style="color:#e67e22;font-weight:600;"><%= t('diagnosis.aiResult.sev.mid', { n: bySeverity.중 || 0 }) %></span></div>
    <div><span style="color:#888;"><%= t('diagnosis.aiResult.sev.low', { n: bySeverity.하 || 0 }) %></span></div>
  </div>
</div>
<% } %>

<!-- 전체 항목 상세 -->
<div class="section-box">
  <h3><%= t('diagnosis.aiResult.detail.title') %></h3>
  <div class="filter-row" style="margin-bottom:1rem;">
    <input type="search" id="resultSearch" placeholder="<%= t('diagnosis.aiResult.detail.searchPh') %>">
    <select id="resultCategory">
      <option value=""><%= t('diagnosis.aiResult.detail.allCategory') %></option>
      <% Object.keys(byCategory).sort().forEach(cat => { %>
        <option value="<%= cat %>"><%= cat %></option>
      <% }) %>
    </select>
    <select id="resultSeverity">
      <option value=""><%= t('diagnosis.aiResult.detail.allSeverity') %></option>
      <option value="상"><%= t('common.sev.high') %></option>
      <option value="중"><%= t('common.sev.mid') %></option>
      <option value="하"><%= t('common.sev.low') %></option>
    </select>
    <button class="btn-sm" onclick="filterRows()"><%= t('diagnosis.aiResult.detail.btnApplyFilter') %></button>
    <button class="btn-sm" onclick="resetResultFilters()"><%= t('diagnosis.aiResult.detail.btnReset') %></button>
  </div>
  <div style="margin-bottom:1rem;">
    <label><input type="radio" name="filter" value="all" checked onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltAll') %></label>
        <label><input type="radio" name="filter" value="vuln" onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltVuln') %></label>
        <label><input type="radio" name="filter" value="safe" onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltSafe') %></label>
        <label><input type="radio" name="filter" value="info" onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltInfo') %></label>
        <label><input type="radio" name="filter" value="na" onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltNa') %></label>
        <label><input type="radio" name="filter" value="disagree_real" onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltDisagree') %></label>
        <label><input type="radio" name="filter" value="needs_review" onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltReview') %></label>
        <label><input type="radio" name="filter" value="secums_wait" onchange="filterRows(this.value)"> <%= t('diagnosis.aiResult.detail.fltWait') %></label>
  </div>
  <table class="data-table" id="resultsTable">
    <thead>
      <tr>
        <th>CHK_ID</th>
        <th><%= t('diagnosis.aiResult.detail.th.title') %></th>
        <th><%= t('diagnosis.aiResult.detail.th.secums') %></th>
        <th><%= t('diagnosis.aiResult.detail.th.aiVerdict') %></th>
        <th><%= t('diagnosis.aiResult.detail.th.agree') %></th>
        <th><%= t('diagnosis.aiResult.detail.th.severity') %></th>
        <th><%= t('diagnosis.aiResult.detail.th.reason') %></th>
        <th><%= t('diagnosis.aiResult.detail.th.action') %></th>
      </tr>
    </thead>
    <tbody>
      <% (diag.results || []).forEach(r => { %>
        <% var verdictClass = r.ai_verdict === '취약' ? 'vuln'
                             : r.ai_verdict === '양호' ? 'safe'
                             : (r.ai_verdict === '정보제공' || r.ai_verdict === '정보') ? 'info' : 'na'; %>
        <% var normalizedAgreement = r.agreement;
           if (normalizedAgreement === 'disagree') {
             var aiClear = r.ai_verdict === '취약' || r.ai_verdict === '양호';
             var secumsClear = r.secums_verdict === 'OK' || r.secums_verdict === 'BAD';
             normalizedAgreement = aiClear && secumsClear ? 'disagree_real' : 'needs_review';
           }
           var agreementClass = normalizedAgreement === 'agree' ? 'agree'
                              : normalizedAgreement === 'secums_wait' ? 'secums_wait'
                              : normalizedAgreement === 'needs_review' ? 'needs_review'
                              : normalizedAgreement === 'disagree_real' ? 'disagree_real'
                              : 'unknown'; %>
        <tr class="result-row verdict-<%= verdictClass %> agree-<%= agreementClass %>"
            data-category="<%= r.ai_category || '' %>"
            data-severity="<%= r.ai_severity || '' %>"
            data-search="<%= [r.chk_id, r.ai_title, r.ai_category, r.ai_verdict, r.ai_severity, r.ai_reason, r.ai_evidence, r.ai_recommend, r.secums_verdict].filter(Boolean).join(' ').toLowerCase() %>">
          <td class="mono small"><%= r.chk_id %></td>
          <td>
            <strong><%= r.ai_title %></strong>
            <% if (r.ai_category) { %>
              <div class="muted small"><%= r.ai_category %></div>
            <% } %>
          </td>
          <td>
            <% if (r.secums_verdict === 'BAD') { %>
              <span style="color:#c0392b;font-weight:600;">🚨 BAD</span>
            <% } else if (r.secums_verdict === 'OK') { %>
              <span style="color:#27ae60;">✓ OK</span>
            <% } else if (r.secums_verdict === 'WAIT') { %>
              <span class="muted">- WAIT</span>
            <% } else { %>
              <span class="muted"><%= r.secums_verdict %></span>
            <% } %>
          </td>
          <td>
            <% if (r.ai_verdict === '취약') { %>
              <span style="color:#c0392b;font-weight:600;"><%= t('diagnosis.aiResult.detail.vVuln') %></span>
            <% } else if (r.ai_verdict === '양호') { %>
              <span style="color:#27ae60;"><%= t('diagnosis.aiResult.detail.vSafe') %></span>
              <% if (r.ai_safe_type) { %>
                <div class="muted small"><%= r.ai_safe_type %></div>
              <% } %>
            <% } else if (r.ai_verdict === '정보제공' || r.ai_verdict === '정보') { %>
              <span class="muted"><%= t('diagnosis.aiResult.detail.vInfo') %></span>
            <% } else { %>
              <span class="muted"><%= t('diagnosis.aiResult.detail.vNa') %></span>
            <% } %>
          </td>
          <td>
            <% if (r.agreement === 'agree') { %>
              <span style="color:#27ae60;">✓</span>
            <% } else if (normalizedAgreement === 'secums_wait') { %>
              <span style="color:#1976d2;" title="<%= t('diagnosis.aiResult.detail.agIncomparableTitle') %>"><%= t('diagnosis.aiResult.detail.agIncomparable') %></span>
            <% } else if (normalizedAgreement === 'needs_review') { %>
              <span style="color:#e67e22;font-weight:600;" title="<%= t('diagnosis.aiResult.detail.agReviewTitle') %>"><%= t('diagnosis.aiResult.detail.agReview') %></span>
            <% } else if (normalizedAgreement === 'disagree_real') { %>
              <span style="color:#c0392b;font-weight:600;" title="<%= t('diagnosis.aiResult.detail.agFailTitle') %>"><%= t('diagnosis.aiResult.detail.agFail') %></span>
            <% } else { %>
              <span class="muted">-</span>
            <% } %>
          </td>
          <td>
            <% if (r.ai_verdict === '취약') { %>
              <span style="color:<%= r.ai_severity === '상' ? '#c0392b' : r.ai_severity === '중' ? '#e67e22' : '#888' %>;font-weight:600;">
                <%= td(r.ai_severity) %>
              </span>
            <% } else { %>
              <span class="muted">-</span>
            <% } %>
          </td>
          <td style="max-width:450px;">
            <div><%= r.ai_reason %></div>
            <% if (r.ai_evidence) { %>
              <div class="muted small mono" style="margin-top:0.3rem;"><%= t('diagnosis.aiResult.detail.evidence') %> <%= r.ai_evidence.substring(0, 200) %></div>
            <% } %>
            <% if (r.ai_recommend) { %>
              <div style="margin-top:0.3rem;padding:0.3rem;background:#fff8e1;border-left:3px solid #f9a825;font-size:0.85em;">
                <strong><%= t('diagnosis.aiResult.detail.recommend') %></strong> <%= r.ai_recommend %>
              </div>
            <% } %>
          </td>
          <td class="small" style="white-space:nowrap;">
            <% if (r.ai_verdict === '취약') {
                 var _rid = (diag.assessment_id || '') + '-' + r.chk_id;
                 var _q = 'result_id=' + encodeURIComponent(_rid) + '&rule_id=' + encodeURIComponent(r.chk_id) + '&server_id=' + encodeURIComponent(diag.server_id || ''); %>
              <a class="btn-sm" href="/exceptions/new?<%= _q %>" title="<%= t('diagnosis.aiResult.detail.btnExceptionTitle') %>" style="background:#e67e22;color:#fff;"><%= t('diagnosis.aiResult.detail.btnException') %></a>
            <% } else { %>
              <span class="muted">-</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
document.querySelectorAll('#resultsTable tbody tr').forEach(function(tr) {
  if (!tr.dataset.search) {
    tr.dataset.search = Array.from(tr.cells).map(function(td) { return td.textContent || ''; }).join(' ').toLowerCase();
  }
});

function currentVerdictFilter(value) {
  if (value) return value;
  const checked = document.querySelector('input[name="filter"]:checked');
  return checked ? checked.value : 'all';
}

function filterRows(filter) {
  filter = currentVerdictFilter(filter);
  const q = (document.getElementById('resultSearch')?.value || '').toLowerCase();
  const category = document.getElementById('resultCategory')?.value || '';
  const severity = document.getElementById('resultSeverity')?.value || '';
  const rows = document.querySelectorAll('#resultsTable tbody tr');
  rows.forEach(tr => {
    let show = false;
    if (filter === 'all') show = true;
    else if (filter === 'vuln')        show = tr.classList.contains('verdict-vuln');
    else if (filter === 'safe')        show = tr.classList.contains('verdict-safe');
    else if (filter === 'info')        show = tr.classList.contains('verdict-info');
    else if (filter === 'na')          show = tr.classList.contains('verdict-na');
    else if (filter === 'disagree_real') show = tr.classList.contains('agree-disagree_real');
    else if (filter === 'needs_review')  show = tr.classList.contains('agree-needs_review');
    else if (filter === 'secums_wait') show = tr.classList.contains('agree-secums_wait');
    if (q && !tr.dataset.search.includes(q)) show = false;
    if (category && tr.dataset.category !== category) show = false;
    if (severity && tr.dataset.severity !== severity) show = false;
    tr.style.display = show ? '' : 'none';
  });
}

function resetResultFilters() {
  document.getElementById('resultSearch').value = '';
  document.getElementById('resultCategory').value = '';
  document.getElementById('resultSeverity').value = '';
  const all = document.querySelector('input[name="filter"][value="all"]');
  if (all) all.checked = true;
  filterRows('all');
}

['resultSearch', 'resultCategory', 'resultSeverity'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener(id === 'resultSearch' ? 'input' : 'change', () => filterRows());
});
</script>

