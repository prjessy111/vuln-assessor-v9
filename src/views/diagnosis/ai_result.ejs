    <div class="kpi-num" style="color:#c0392b;"><%= diag.vuln_count %></div>
    <div class="kpi-sub"><%= t('diagnosis.aiResult.kpi.vulnSub') %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('diagnosis.aiResult.kpi.safe') %></div>
    <div class="kpi-num" style="color:#27ae60;"><%= diag.safe_count %></div>
    <div class="kpi-sub"><%= t('diagnosis.aiResult.kpi.safeSub', { a: diag.safe_absence_count || 0, b: diag.safe_value_count || 0 }) %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label"><%= t('diagnosis.aiResult.kpi.na') %></div>
    <div class="kpi-num" style="color:#888;"><%= diag.na_count %></div>
    <div class="kpi-sub"><%= t('diagnosis.aiResult.kpi.naSub') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label"><%= t('diagnosis.aiResult.kpi.agreeRate') %></div>
    <div class="kpi-num"
         style="color:<%= diag.agreement_rate >= 80 ? '#27ae60' : diag.agreement_rate >= 60 ? '#e67e22' : '#c0392b' %>;">
      <%= diag.agreement_rate %>%
    </div>
    <div class="kpi-sub"><%= t('diagnosis.aiResult.kpi.agreeSub', { a: diag.agree_count || 0, b: disagreeRealCount }) %></div>
  </div>
</div>

<!-- 메타 정보 -->
