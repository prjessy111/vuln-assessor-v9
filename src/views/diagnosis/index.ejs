<%- include('../_header', { title: t('diagnosis.list.title'), activeMenu: 'diagnosis' }) %>

<div class="page-header">
  <h1><%= t('diagnosis.list.title') %></h1>
  <div class="header-actions">
    <button class="btn primary" onclick="runAiDiagnosis(1)" style="background:#6c5ce7;border-color:#6c5ce7;"><%= t('diagnosis.list.btnAiRun') %></button>
    <a href="/diagnosis/upload" class="btn"><%= t('diagnosis.list.btnRawImport') %></a>
    <a href="/scheduler/history" class="btn"><%= t('diagnosis.list.btnAutoHistory') %></a>
    <a href="/schedules" class="btn"><%= t('diagnosis.list.btnSchedules') %></a>
  </div>
</div>

<!-- 진단 KPI -->
<div class="kpi-grid kpi-4col">
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('diagnosis.list.kpi.success7d') %></div>
    <div class="kpi-num"><%= kpi.success7d %></div>
    <div class="kpi-sub"><%= t('diagnosis.list.kpi.success7dSub', { n: kpi.total7d }) %></div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label"><%= t('diagnosis.list.kpi.failed') %></div>
    <div class="kpi-num"><%= kpi.failed7d %></div>
    <div class="kpi-sub"><%= t('diagnosis.list.kpi.failedSub') %></div>
  </div>
  <div class="kpi-card kpi-running">
    <div class="kpi-label"><%= t('diagnosis.list.kpi.running') %></div>
    <div class="kpi-num"><%= kpi.running %></div>
    <div class="kpi-sub"><%= t('diagnosis.list.kpi.runningSub') %></div>
  </div>
  <div class="kpi-card kpi-avg">
    <div class="kpi-label"><%= t('diagnosis.list.kpi.avgElapsed') %></div>
    <div class="kpi-num"><%= fmtMs(kpi.avgElapsedMs) %></div>
    <div class="kpi-sub"><%= t('diagnosis.list.kpi.avgElapsedSub') %></div>
  </div>
</div>

<!-- 진단 이력 -->
<div class="section-box">
  <h3><%= t('diagnosis.list.historyTitle') %></h3>
  <div class="filter-row" style="margin-bottom:12px;">
    <input type="search" id="diagSearch" placeholder="<%= t('diagnosis.list.searchPh') %>">
    <select id="diagStatus">
      <option value=""><%= t('diagnosis.list.allStatus') %></option>
      <option value="success"><%= t('diagnosis.list.optSuccess') %></option>
      <option value="failed"><%= t('diagnosis.list.optFailed') %></option>
      <option value="running"><%= t('diagnosis.list.optRunning') %></option>
    </select>
    <select id="diagType">
      <option value=""><%= t('diagnosis.list.allType') %></option>
      <option value="ai">AI</option>
      <option value="llm">LLM</option>
    </select>
    <select id="diagSource">
      <option value=""><%= t('diagnosis.list.allSource') %></option>
      <option value="secums">SecuMS Raw</option>
      <option value="script">Script</option>
      <option value="both">SecuMS+Script</option>
    </select>
    <input type="date" id="diagFrom">
    <input type="date" id="diagTo">
    <button class="btn-sm" onclick="applyDiagnosisFilter()"><%= t('diagnosis.list.btnApplyFilter') %></button>
    <button class="btn-sm" onclick="resetDiagnosisFilter()"><%= t('diagnosis.list.btnReset') %></button>
  </div>
  <table class="data-table" id="diagnosisTable">
    <thead>
      <tr>
        <th>#</th>
        <th><%= t('diagnosis.list.th.server') %></th>
        <th><%= t('diagnosis.list.th.assetNo') %></th>
        <th><%= t('diagnosis.list.th.ruleset') %></th>
        <th><%= t('diagnosis.list.th.type') %></th>
        <th><%= t('diagnosis.list.th.executedAt') %></th>
        <th><%= t('diagnosis.list.th.elapsed') %></th>
        <th><%= t('diagnosis.list.th.status') %></th>
        <th><%= t('diagnosis.list.th.result') %></th>
        <th><%= t('diagnosis.list.th.failRate') %></th>
        <th><%= t('diagnosis.list.th.executedBy') %></th>
        <th><%= t('diagnosis.list.th.action') %></th>
      </tr>
    </thead>
    <tbody>
      <% diagnoses.forEach(d => { %>
        <tr class="row-<%= d.status %>"
            data-status="<%= d.status || '' %>"
            data-type="<%= d.diagnose_type || '' %>"
            data-source="<%= d.source_type || 'secums' %>"
            data-date="<%= (d.executed_at || '').slice(0, 10) %>"
            data-search="<%= (String(d.assessment_id || '') + ' ' + (d.server_name || '') + ' ' + (d.hostname || '') + ' ' + (d.asset_no || '') + ' ' + (d.executed_by || '')).toLowerCase() %>">
          <td class="mono small"><%= d.assessment_id %></td>
          <td>
            <strong><%= d.server_name %></strong>
            <div class="muted small"><%= d.hostname %></div>
          </td>
          <td class="mono small"><%= d.asset_no || '-' %></td>
          <td class="small"><%= d.ruleset_ver %></td>
          <td class="small">
            <% var _dt = d.diagnose_type;
               var _model = d.llm || d.llm_provider || d.llm_choice || d.model || '';
               var _badge, _color;
               if (_dt === 'llm') { _badge = 'LLM' + (_model ? ' · ' + _model : ''); _color = '#6c5ce7'; }
               else if (_dt === 'ai') { _badge = 'AI (mock)'; _color = '#16a085'; }
               else if (_dt === 'ai_llm') { _badge = 'AI+LLM'; _color = '#2980b9'; }
               else { _badge = _dt || t('diagnosis.list.badgeRuleset'); _color = '#7f8c8d'; } %>
            <span style="background:<%= _color %>;color:#fff;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;"><%= _badge %></span>
          </td>
          <td class="mono small"><%= d.executed_at %></td>
          <td class="small">
            <% if (d.elapsed_ms) { %><%= fmtMs(d.elapsed_ms) %><% } else { %>-<% } %>
          </td>
          <td>
            <% if (d.status === 'success') { %>
              <span class="status-badge st-success"><%= t('diagnosis.list.stSuccess') %></span>
            <% } else if (d.status === 'failed') { %>
              <span class="status-badge st-failed"><%= t('diagnosis.list.stFailed') %></span>
            <% } else if (d.status === 'running') { %>
              <span class="status-badge st-running"><%= t('diagnosis.list.stRunning') %></span>
            <% } %>
          </td>
          <td class="long-text small">
            <% if (d.status === 'success') { %>
              <span class="diag-result">
                <%= t('diagnosis.list.resTotal', { n: d.total_count }) %>
                <span class="b-vuln"><%= t('diagnosis.list.resVuln', { n: d.vuln_count }) %></span> /
                <span class="b-safe"><%= t('diagnosis.list.resSafe', { n: d.safe_count }) %></span> /
                <span class="b-info"><%= t('diagnosis.list.resInfo', { n: d.info_count || 0 }) %></span> /
                <span class="b-na"><%= t('diagnosis.list.resNa', { n: d.na_count }) %></span>
              </span>
            <% } else if (d.status === 'failed') { %>
              <div class="fail-reason">
                <strong><%= t('diagnosis.list.failReason') %></strong> <%= d.error_phase %>
                <div class="fail-detail"><%= d.error_message %></div>
              </div>
            <% } else if (d.status === 'running') { %>
              <div class="progress-bar"><div class="progress-fill" style="width:<%= d.progress %>%"></div></div>
              <span class="muted small"><%= d.progress %>% — <%= d.current_step %></span>
            <% } %>
          </td>
          <td class="small">
            <% if (d.status === 'success' && (d.diagnose_type === 'ai' || d.diagnose_type === 'llm')) { %>
              <% var realFail = typeof d.disagree_real_count === 'number' ? d.disagree_real_count : (d.disagree_count || 0);
                 var needsReview = d.needs_review_count || 0;
                 var compCount = typeof d.comparison_count === 'number' ? d.comparison_count : ((d.agree_count || 0) + realFail);
                 var failRate = typeof d.validation_failure_rate === 'number'
                   ? d.validation_failure_rate
                   : (compCount ? Math.round(realFail / compCount * 100) : 0); %>
              <strong style="color:<%= failRate > 0 ? '#c0392b' : '#27ae60' %>;"><%= failRate %>%</strong>
              <div class="muted small"><%= t('diagnosis.list.valFail', { a: realFail, b: needsReview }) %></div>
            <% } else { %>
              <span class="muted">-</span>
            <% } %>
          </td>
          <td class="small"><%= d.executed_by %></td>
          <td>
            <% if (d.status === 'success') { %>
              <% if (d.diagnose_type === 'ai' || d.diagnose_type === 'llm') { %>
                <a href="/diagnosis/<%= d.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;">🤖 <%= d.diagnose_type === 'llm' ? 'LLM' : 'AI' %> <%= t('diagnosis.list.btnResult') %></a>
                <% if (d.diagnose_type === 'ai' || d.diagnose_type === 'llm') { %>
                  <a href="/reports/<%= d.assessment_id %>/fsi" class="btn-sm"><%= t('diagnosis.list.btnReport1') %></a>
                  <a href="/reports/<%= d.assessment_id %>/samsung" class="btn-sm"><%= t('diagnosis.list.btnReport2') %></a>
                  <a href="/reports/<%= d.assessment_id %>/policy3" class="btn-sm" style="background:#0984e3;color:#fff;"><%= t('diagnosis.list.btnReport3') %></a>
                  <a href="/reports/<%= d.assessment_id %>/remediation" class="btn-sm" style="background:#27ae60;color:#fff;"><%= t('diagnosis.list.btnRemGuide') %></a>
                <% } %>
                <a href="/diagnosis/<%= d.assessment_id %>/cve" class="btn-sm" style="background:#8e44ad;color:#fff;"><%= t('diagnosis.list.btnCve') %></a>
              <% } else { %>
                <span class="muted small"><%= t('diagnosis.list.legacyNote') %></span>
              <% } %>
            <% } else if (d.status === 'failed') { %>
              <a href="/diagnosis/<%= d.assessment_id %>/retry" class="btn-sm"><%= t('diagnosis.list.btnRetry') %></a>
              <a href="/diagnosis/<%= d.assessment_id %>/log" class="btn-sm"><%= t('diagnosis.list.btnLog') %></a>
            <% } else if (d.status === 'running') { %>
              <a href="/diagnosis/<%= d.assessment_id %>/cancel" class="btn-sm danger"><%= t('diagnosis.list.btnCancelRun') %></a>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- 실패 패턴 분석 -->
<div class="section-box">
  <h3><%= t('diagnosis.list.failPatternTitle') %></h3>
  <div class="fail-stats">
    <% failPatterns.forEach(p => { %>
      <div class="fail-pattern-row">
        <div class="fp-label">
          <span class="fp-phase fp-<%= p.phase %>"><%= p.phase_label %></span>
          <%= p.error_pattern %>
        </div>
        <div class="fp-bar">
          <div class="fp-fill" style="width:<%= p.count / failPatterns[0].count * 100 %>%"></div>
        </div>
        <div class="fp-count"><%= t('diagnosis.list.timesUnit', { n: p.count }) %></div>
      </div>
    <% }); %>
  </div>
</div>

<script>
function applyDiagnosisFilter() {
  const q = document.getElementById('diagSearch').value.toLowerCase();
  const status = document.getElementById('diagStatus').value;
  const type = document.getElementById('diagType').value;
  const source = document.getElementById('diagSource').value;
  const from = document.getElementById('diagFrom').value;
  const to = document.getElementById('diagTo').value;

  document.querySelectorAll('#diagnosisTable tbody tr').forEach(tr => {
    let show = true;
    const date = tr.dataset.date || '';
    if (q && !tr.dataset.search.includes(q)) show = false;
    if (status && tr.dataset.status !== status) show = false;
    if (type && tr.dataset.type !== type) show = false;
    if (source && tr.dataset.source !== source) show = false;
    if (from && date && date < from) show = false;
    if (to && date && date > to) show = false;
    tr.style.display = show ? '' : 'none';
  });
}

function resetDiagnosisFilter() {
  ['diagSearch', 'diagStatus', 'diagType', 'diagSource', 'diagFrom', 'diagTo'].forEach(id => {
    document.getElementById(id).value = '';
  });
  document.querySelectorAll('#diagnosisTable tbody tr').forEach(tr => { tr.style.display = ''; });
}

['diagSearch', 'diagStatus', 'diagType', 'diagSource', 'diagFrom', 'diagTo'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener(id === 'diagSearch' ? 'input' : 'change', applyDiagnosisFilter);
});

function runAiDiagnosis(serverId) {
  if (!confirm(<%- JSON.stringify(t('diagnosis.list.confirmAiRun1')) %> + (window.LLM_PROVIDER || 'mock') + <%- JSON.stringify(t('diagnosis.list.confirmAiRun2')) %>)) return;
  const btn = event.target;
  const orig = btn.textContent;
  btn.disabled = true;
  btn.textContent = <%- JSON.stringify(t('diagnosis.list.aiRunning')) %>;
  fetch('/diagnosis/ai-run', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ server_id: serverId }),
  })
    .then(r => r.json())
    .then(j => {
      if (j.status === 'success') {
        alert(j.message);
        location.href = '/diagnosis/' + j.assessment_id + '/ai';
      } else {
        alert(<%- JSON.stringify(t('diagnosis.list.failPrefix')) %> + (j.error || <%- JSON.stringify(t('diagnosis.list.errUnknown')) %>));
        btn.disabled = false;
        btn.textContent = orig;
      }
    })
    .catch(e => {
      alert(<%- JSON.stringify(t('diagnosis.list.errPrefix')) %> + e.message);
      btn.disabled = false;
      btn.textContent = orig;
    });
}
</script>

<%- include('../_footer') %>
