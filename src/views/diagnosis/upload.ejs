<%- include('../_header', { title: t('diagnosis.upload.title'), activeMenu: 'diagnosis' }) %>

<div class="page-header">
  <h1><%= t('diagnosis.upload.heading') %></h1>
  <p class="muted small">
    <%= t('diagnosis.upload.desc') %>
  </p>
  <div class="header-actions">
    <a href="/diagnosis" class="btn"><%= t('diagnosis.upload.btnBack') %></a>
  </div>
</div>

<form id="uploadForm" class="form-container" enctype="multipart/form-data">
  <div class="form-section">
    <h3><%= t('diagnosis.upload.sec1') %></h3>
    <div class="form-row inline">
      <label><%= t('diagnosis.upload.serverLabel') %></label>
      <select name="server_id" required>
        <option value=""><%= t('diagnosis.upload.selectPh') %></option>
        <% (servers || []).forEach(s => { %>
          <option value="<%= s.server_id %>">
            <%= s.name %> (<%= s.hostname %>)<% if (s.service_name) { %> · <%= s.service_name %><% } %>
          </option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="form-section">
    <h3><%= t('diagnosis.upload.sec2') %></h3>
    <div class="form-row inline">
      <label><%= t('diagnosis.upload.secumsDb') %></label>
      <input type="file" name="dbfile" accept=".db,.sqlite,.sqlite3">
    </div>
    <div class="form-row inline">
      <label><%= t('diagnosis.upload.scriptXml') %></label>
      <input type="file" name="scriptfile" accept=".xml">
    </div>
    <p class="muted small">
      <%= t('diagnosis.upload.fileNote') %>
    </p>
  </div>

  <div class="form-section">
    <h3><%= t('diagnosis.upload.sec3') %></h3>
    <div class="form-row inline">
      <label><%= t('diagnosis.upload.sourceLabel') %></label>
      <select name="source">
        <option value="both"><%= t('diagnosis.upload.srcBoth') %></option>
        <option value="script"><%= t('diagnosis.upload.srcScript') %></option>
        <option value="secums"><%= t('diagnosis.upload.srcSecums') %></option>
      </select>
    </div>
    <div class="form-row inline">
      <label><%= t('diagnosis.upload.engineLabel') %></label>
      <select name="engine">
        <option value="ai_llm" selected><%= t('diagnosis.upload.engAiLlm') %></option>
        <option value="ai"><%= t('diagnosis.upload.engAi') %></option>
        <option value="llm"><%= t('diagnosis.upload.engLlm') %></option>
      </select>
    </div>
    <div class="form-row inline">
      <label>
        <input type="checkbox" name="run_immediately" value="on" checked>
        <%= t('diagnosis.upload.runNow') %>
      </label>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn primary" id="submitBtn"><%= t('diagnosis.upload.btnSubmit') %></button>
    <a href="/diagnosis" class="btn"><%= t('common.btn.cancel') %></a>
  </div>
</form>

<div id="result" class="section-box" style="display:none; margin-top:1.5rem;">
  <h3><%= t('diagnosis.upload.resultTitle') %></h3>
  <pre id="resultBody" style="background:#f8f9fa; padding:1rem; border-radius:4px; overflow:auto; max-height:400px;"></pre>
  <div id="resultActions" style="margin-top:1rem;"></div>
</div>

<script>
document.getElementById('uploadForm').onsubmit = async (e) => {
  e.preventDefault();
  const btn = document.getElementById('submitBtn');
  const resultBox = document.getElementById('result');
  const resultBody = document.getElementById('resultBody');
  const resultActions = document.getElementById('resultActions');

  const fd = new FormData(e.target);
  if (!fd.get('dbfile')?.name && !fd.get('scriptfile')?.name) {
    alert(<%- JSON.stringify(t('diagnosis.upload.alertNoFile')) %>);
    return;
  }

  btn.disabled = true;
  btn.textContent = <%- JSON.stringify(t('diagnosis.upload.uploading')) %>;
  resultBox.style.display = 'block';
  resultBody.textContent = <%- JSON.stringify(t('diagnosis.upload.runningMsg')) %>;
  resultActions.innerHTML = '';

  try {
    const res = await fetch('/diagnosis/upload', { method: 'POST', body: fd });
    const j = await res.json();
    resultBody.textContent = JSON.stringify(j, null, 2);

    if (j.status === 'success' && j.assessment_id) {
      resultActions.innerHTML =
        '<a class="btn primary" href="/diagnosis">' + <%- JSON.stringify(t('diagnosis.upload.toList')) %> + '</a> ' +
        '<a class="btn" href="/diagnosis/' + j.assessment_id + '/ai" style="background:#6c5ce7;color:#fff;">' + <%- JSON.stringify(t('diagnosis.upload.viewResult')) %> + '</a> ' +
        '<a class="btn" href="/diagnosis/' + j.assessment_id + '/validate">' + <%- JSON.stringify(t('diagnosis.upload.validate')) %> + '</a>';
    } else if (j.status === 'success') {
      resultActions.innerHTML = '<a class="btn" href="/diagnosis">' + <%- JSON.stringify(t('diagnosis.upload.toList')) %> + '</a>';
    }
  } catch (err) {
    resultBody.textContent = <%- JSON.stringify(t('diagnosis.upload.errPrefix')) %> + err.message;
  } finally {
    btn.disabled = false;
    btn.textContent = <%- JSON.stringify(t('diagnosis.upload.btnSubmit')) %>;
  }
};
</script>

<%- include('../_footer') %>
