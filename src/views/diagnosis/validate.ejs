<%- include('../_header', { title: t('diagnosis.validate.title') + ' #' + assessment_id, activeMenu: 'diagnosis' }) %>

<div class="page-header">
  <h1><%= t('diagnosis.validate.heading') %> #<%= assessment_id %></h1>
  <p class="muted small">
    <%= t('diagnosis.validate.desc') %>
  </p>
  <div class="header-actions">
    <a href="/diagnosis" class="btn"><%= t('diagnosis.validate.btnBack') %></a>
    <a href="/reports/<%= assessment_id %>/fsi" class="btn"><%= t('diagnosis.validate.btnReport1') %></a>
  </div>
</div>

<!-- 점검 범위 비교 -->
<div class="section-box" style="background:#fff8e1;border-left:4px solid #f9a825;">
  <h3><%= t('diagnosis.validate.scopeTitle') %></h3>
  <p>
    <%- t('diagnosis.validate.scopeDesc') %>
  </p>
  <ul style="margin-top:0.5rem;">
    <li><strong><%= t('diagnosis.validate.secumsResult') %></strong>:
      OK <strong style="color:#27ae60;"><%= validation.secumsStats.OK %></strong>,
      BAD <strong style="color:#c0392b;"><%= validation.secumsStats.BAD %></strong>,
      INFO <strong><%= validation.secumsStats.INFO %></strong>,
      <%= t('diagnosis.validate.waitLabel') %> <strong style="color:#888;"><%= validation.secumsStats.WAIT %></strong>
      <%= t('diagnosis.validate.totalOf', { n: validation.secumsStats.total }) %>
    </li>
    <li><strong><%= t('diagnosis.validate.ourResult') %></strong>:
      <%= t('diagnosis.validate.vuln') %> <strong style="color:#c0392b;"><%= validation.ourStats.vuln %></strong>,
      <%= t('diagnosis.validate.safe') %> <strong style="color:#27ae60;"><%= validation.ourStats.safe %></strong>,
      <%= t('diagnosis.validate.na') %> <strong style="color:#888;"><%= validation.ourStats.na %></strong>
      <%= t('diagnosis.validate.totalOf', { n: validation.ourStats.total }) %>
    </li>
  </ul>
</div>

<!-- 평가 방식 신뢰도 -->
<div class="section-box" style="background:#e3f2fd;border-left:4px solid #1976d2;">
  <h3><%= t('diagnosis.validate.evalTitle') %></h3>
  <table class="data-table" style="max-width:700px;">
    <thead>
      <tr><th><%= t('diagnosis.validate.evalTh.method') %></th><th><%= t('diagnosis.validate.evalTh.count') %></th><th><%= t('diagnosis.validate.evalTh.vulnVerdict') %></th><th><%= t('diagnosis.validate.evalTh.reliability') %></th></tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>simple_check</strong> (deterministic)</td>
        <td><%= t('common.unit.count', { n: validation.ourStats.bySimple }) %></td>
        <td><%= t('common.unit.count', { n: validation.ourStats.vulnBySimple }) %></td>
        <td><span style="color:#27ae60;"><%= t('diagnosis.validate.evalSimpleOk') %></span></td>
      </tr>
      <tr style="background:#fff5f5;">
        <td><strong><%= t('diagnosis.validate.evalLlm') %></strong> <%= t('diagnosis.validate.evalLlmMode') %></td>
        <td><%= t('common.unit.count', { n: validation.ourStats.byLlm }) %></td>
        <td><%= t('common.unit.count', { n: validation.ourStats.vulnByLlm }) %></td>
        <td>
          <span style="color:#c0392b;"><%= t('diagnosis.validate.evalLlmWarn') %></span>
        </td>
      </tr>
    </tbody>
  </table>
  <p class="muted small" style="margin-top:0.5rem;">
    <%- t('diagnosis.validate.evalNote') %>
  </p>
</div>

<!-- 매핑 비교 KPI -->
<div class="kpi-grid kpi-4col">
  <div class="kpi-card">
    <div class="kpi-label"><%= t('diagnosis.validate.kpi.mapped') %></div>
    <div class="kpi-num"><%= validation.mapped %></div>
    <div class="kpi-sub"><%= t('diagnosis.validate.kpi.mappedSub') %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('diagnosis.validate.kpi.matched') %></div>
    <div class="kpi-num" style="color:#27ae60;"><%= validation.matched %></div>
    <div class="kpi-sub"><%= t('diagnosis.validate.kpi.matchedSub') %></div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label"><%= t('diagnosis.validate.kpi.mismatched') %></div>
    <div class="kpi-num" style="color:#c0392b;"><%= validation.mismatched %></div>
    <div class="kpi-sub"><%= t('diagnosis.validate.kpi.mismatchedSub') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label"><%= t('diagnosis.validate.kpi.matchRate') %></div>
    <div class="kpi-num"
         style="color:<%= validation.matchRate >= 80 ? '#27ae60' : validation.matchRate >= 60 ? '#e67e22' : '#c0392b' %>;">
      <%= validation.matchRate %>%
    </div>
    <div class="kpi-sub"><%= t('diagnosis.validate.kpi.matchRateSub') %></div>
  </div>
</div>

<!-- 검증된 매핑만의 일치율 (raw DB로 매핑 확인된 8건) -->
<div class="section-box">
  <h3><%= t('diagnosis.validate.verifiedTitle') %></h3>
  <p class="muted small">
    <%= t('diagnosis.validate.verifiedDesc') %>
  </p>
  <div style="display:flex;gap:1.5rem;margin-top:0.5rem;">
    <div>
      <strong><%= t('diagnosis.validate.verifiedRate') %></strong>
      <span style="color:<%= validation.verifiedMatchRate >= 80 ? '#27ae60' : validation.verifiedMatchRate >= 60 ? '#e67e22' : '#c0392b' %>;font-weight:600;font-size:1.2rem;">
        <%= validation.verifiedMatchRate %>%
      </span>
      <span class="muted"><%= t('diagnosis.validate.verifiedCounts', { a: validation.verifiedMatched, b: validation.verifiedMismatched }) %></span>
    </div>
  </div>
</div>

<!-- 매핑된 룰별 상세 비교 -->
<div class="section-box">
  <h3><%= t('diagnosis.validate.ruleTitle') %></h3>
  <table class="data-table">
    <thead>
      <tr>
        <th>KISA</th>
        <th>SecuMS CHK_ID</th>
        <th><%= t('diagnosis.validate.ruleTh.title') %></th>
        <th><%= t('diagnosis.validate.ruleTh.ours') %></th>
        <th>SecuMS</th>
        <th><%= t('diagnosis.validate.ruleTh.consistency') %></th>
        <th><%= t('diagnosis.validate.ruleTh.evalMethod') %></th>
        <th><%= t('diagnosis.validate.ruleTh.mapStatus') %></th>
      </tr>
    </thead>
    <tbody>
      <% validation.mappedRules.forEach(r => { %>
        <% var rowBg = !r.comparable ? '#f5f5f5'
                     : r.match ? 'transparent'
                     : '#fff5f5'; %>
        <tr style="background:<%= rowBg %>;">
          <td class="mono"><strong><%= r.ruleId %></strong></td>
          <td class="mono small"><%= r.secumsIds.join(', ') %></td>
          <td style="max-width:300px;"><%= r.title %></td>
          <td>
            <% if (r.ourSt === 'BAD') { %>
              <span style="color:#c0392b;font-weight:600;"><%= t('diagnosis.validate.rVuln') %></span>
            <% } else if (r.ourSt === 'OK') { %>
              <span style="color:#27ae60;"><%= t('diagnosis.validate.rSafe') %></span>
            <% } else { %>
              <span class="muted">? <%= r.ourSt %></span>
            <% } %>
          </td>
          <td>
            <% if (r.secumsSt === 'BAD') { %>
              <span style="color:#c0392b;font-weight:600;">🚨 BAD</span>
            <% } else if (r.secumsSt === 'OK') { %>
              <span style="color:#27ae60;">✓ OK</span>
            <% } else if (r.secumsSt === 'WAIT') { %>
              <span class="muted"><%= t('diagnosis.validate.rWait') %></span>
            <% } else { %>
              <span class="muted">? <%= r.secumsSt %></span>
            <% } %>
          </td>
          <td>
            <% if (!r.comparable) { %>
              <span class="muted"><%= t('diagnosis.validate.rIncomparable') %></span>
            <% } else if (r.match) { %>
              <span style="color:#27ae60;font-weight:600;"><%= t('diagnosis.validate.rMatch') %></span>
            <% } else { %>
              <span style="color:#c0392b;font-weight:600;"><%= t('diagnosis.validate.rMismatch') %></span>
            <% } %>
          </td>
          <td>
            <% if (r.eval_method === 'simple') { %>
              <span style="color:#27ae60;" title="<%= t('diagnosis.validate.simpleTitle') %>">simple</span>
            <% } else if (r.eval_method === 'llm') { %>
              <span style="color:#c0392b;" title="<%= t('diagnosis.validate.mockLlmTitle') %>">⚠ mock-llm</span>
            <% } else { %>
              <span class="muted"><%= r.eval_method %></span>
            <% } %>
          </td>
          <td>
            <% if (r.verified) { %>
              <span style="color:#27ae60;" title="<%= t('diagnosis.validate.verifiedTip') %>"><%= t('diagnosis.validate.verified') %></span>
            <% } else { %>
              <span class="muted" title="<%= t('diagnosis.validate.assumedTip') %>"><%= t('diagnosis.validate.assumed') %></span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- SecuMS의 점검 안 한 항목 (WAIT) -->
<% var waitItems = validation.secumsNotCovered.filter(s => s.result === 'WAIT'); %>
<% if (waitItems.length) { %>
  <div class="section-box">
    <h3><%= t('diagnosis.validate.waitTitle', { n: waitItems.length }) %></h3>
    <p class="muted small">
      <%= t('diagnosis.validate.waitDesc') %>
    </p>
    <div class="mono small" style="background:#f5f5f5;padding:0.5rem;border-radius:4px;">
      <%= waitItems.map(s => s.chkId).join(', ') %>
    </div>
  </div>
<% } %>

<!-- SecuMS의 KISA 30 범위 밖 BAD 항목 -->
<% var unmappedBad = validation.secumsNotCovered.filter(s => s.result === 'BAD'); %>
<% if (unmappedBad.length) { %>
  <div class="section-box" style="background:#fff5f5;border-left:4px solid #c0392b;">
    <h3><%= t('diagnosis.validate.unmappedTitle', { n: unmappedBad.length }) %></h3>
    <p class="muted small">
      <%= t('diagnosis.validate.unmappedDesc') %>
    </p>
    <table class="data-table">
      <thead>
        <tr><th>SecuMS CHK_ID</th><th><%= t('diagnosis.validate.thResult') %></th></tr>
      </thead>
      <tbody>
        <% unmappedBad.forEach(s => { %>
          <tr>
            <td class="mono"><%= s.chkId %></td>
            <td><span style="color:#c0392b;font-weight:600;">🚨 <%= s.result %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../_footer') %>
