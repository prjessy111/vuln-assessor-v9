<%- include('../_header', { title: t('exceptions.index.title'), activeMenu: 'exceptions' }) %>

<div class="page-header">
  <h1><%= t('exceptions.index.title') %></h1>
  <p class="muted small">
    <%= t('exceptions.index.desc') %>
  </p>
  <div class="header-actions">
    <a href="/exceptions/new" class="btn primary"><%= t('exceptions.index.btnNew') %></a>
  </div>
</div>

<!-- KPI -->
<div class="kpi-grid kpi-5col">
  <div class="kpi-card">
    <div class="kpi-label"><%= t('exceptions.index.kpi.total') %></div>
    <div class="kpi-num"><%= kpi.total %></div>
    <div class="kpi-sub"><%= t('exceptions.index.kpi.totalSub') %></div>
  </div>
  <div class="kpi-card kpi-success">
    <div class="kpi-label"><%= t('exceptions.index.kpi.active') %></div>
    <div class="kpi-num" style="color:#27ae60;"><%= kpi.active %></div>
    <div class="kpi-sub"><%= t('exceptions.index.kpi.activeSub') %></div>
  </div>
  <div class="kpi-card kpi-running">
    <div class="kpi-label"><%= t('exceptions.index.kpi.pending') %></div>
    <div class="kpi-num" style="color:#e67e22;"><%= kpi.pending %></div>
    <div class="kpi-sub"><%= t('exceptions.index.kpi.pendingSub') %></div>
  </div>
  <div class="kpi-card" style="border-top-color:#e67e22;">
    <div class="kpi-label"><%= t('exceptions.index.kpi.expiring') %></div>
    <div class="kpi-num" style="color:#e67e22;"><%= kpi.expiring %></div>
    <div class="kpi-sub"><%= t('exceptions.index.kpi.expiringSub') %></div>
  </div>
  <div class="kpi-card kpi-fail">
    <div class="kpi-label"><%= t('exceptions.index.kpi.expired') %></div>
    <div class="kpi-num" style="color:#c0392b;"><%= kpi.expired %></div>
    <div class="kpi-sub"><%= t('exceptions.index.kpi.expiredSub') %></div>
  </div>
</div>

<!-- 필터 -->
<div class="section-box">
  <div class="filter-bar">
    <input type="text" id="searchInput" placeholder="<%= t('exceptions.index.searchPh') %>" class="filter-input">
    <select id="statusFilter" class="filter-select">
      <option value=""><%= t('exceptions.index.filter.allStatus') %></option>
      <option value="승인"><%= t('exceptions.index.filter.approved') %></option>
      <option value="대기"><%= t('exceptions.index.filter.pending') %></option>
      <option value="반려"><%= t('exceptions.index.filter.rejected') %></option>
    </select>
    <select id="expiryFilter" class="filter-select">
      <option value=""><%= t('exceptions.index.filter.allPeriod') %></option>
      <option value="active"><%= t('exceptions.index.filter.valid') %></option>
      <option value="expiring"><%= t('exceptions.index.filter.expiring') %></option>
      <option value="expired"><%= t('exceptions.index.filter.expired') %></option>
    </select>
  </div>
</div>

<!-- 예외 목록 -->
<div class="section-box">
  <h3><%= t('exceptions.index.listTitle', { n: exceptions.length }) %></h3>
  <% if (!exceptions.length) { %>
    <p class="muted"><%= t('exceptions.index.empty') %> <a href="/exceptions/new"><%= t('exceptions.index.emptyLink') %></a>.</p>
  <% } else { %>
    <table class="data-table" id="exceptionsTable">
      <thead>
        <tr>
          <th><%= t('exceptions.index.th.id') %></th>
          <th><%= t('exceptions.index.th.ruleHost') %></th>
          <th><%= t('exceptions.index.th.reason') %></th>
          <th><%= t('exceptions.index.th.period') %></th>
          <th><%= t('exceptions.index.th.daysLeft') %></th>
          <th><%= t('exceptions.index.th.status') %></th>
          <th><%= t('exceptions.index.th.requestedBy') %></th>
          <th><%= t('exceptions.index.th.approvedBy') %></th>
          <th><%= t('exceptions.index.th.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% exceptions.forEach(e => { %>
          <tr data-status="<%= e.approval_status %>"
              data-expiry="<%= e.is_expired ? 'expired' : (e.days_left !== null && e.days_left <= 30 ? 'expiring' : 'active') %>"
              data-search="<%= ((e.rule_id || '') + ' ' + (e.hostname || '') + ' ' + (e.reason || '') + ' ' + (e.requested_by || '') + ' ' + (e.approved_by || '')).toLowerCase() %>">
            <td>#<%= e.exception_id %></td>
            <td>
              <strong><%= e.rule_id || '-' %></strong>
              <% if (e.hostname) { %>
                <div class="small muted"><%= e.hostname %></div>
              <% } %>
            </td>
            <td class="small" style="max-width:280px;">
              <%= (e.reason || '').substring(0, 120) %><% if ((e.reason || '').length > 120) { %>...<% } %>
            </td>
            <td class="small">
              <% if (e.effective_from && e.effective_until) { %>
                <%= e.effective_from %><br><%= e.effective_until %>
              <% } else if (e.effective_until) { %>
                ~ <%= e.effective_until %>
              <% } else { %>
                <span class="muted"><%= t('exceptions.index.notSet') %></span>
              <% } %>
            </td>
            <td>
              <% if (e.is_expired) { %>
                <span style="color:#c0392b;font-weight:600;"><%= t('exceptions.index.expired') %></span>
              <% } else if (e.days_left === null) { %>
                <span class="muted">-</span>
              <% } else if (e.days_left <= 30) { %>
                <span style="color:#e67e22;font-weight:600;"><%= t('exceptions.index.days', { n: e.days_left }) %></span>
              <% } else { %>
                <span><%= t('exceptions.index.days', { n: e.days_left }) %></span>
              <% } %>
            </td>
            <td>
              <% var st = e.approval_status || '대기'; %>
              <% var color = st === '승인' ? '#27ae60' : st === '반려' ? '#c0392b' : '#e67e22'; %>
              <% var stLabel = st === '승인' ? t('exceptions.index.status.approved') : st === '반려' ? t('exceptions.index.status.rejected') : st === '대기' ? t('exceptions.index.status.pending') : st; %>
              <span style="color:<%= color %>;font-weight:600;"><%= stLabel %></span>
            </td>
            <td class="small"><%= e.requested_by || '-' %></td>
            <td class="small"><%= e.approved_by || '-' %></td>
            <td>
              <% if ((e.approval_status || '대기') === '대기') { %>
                <button class="btn-sm" onclick="approve(<%= e.exception_id %>, 'approve')"><%= t('exceptions.index.btnApprove') %></button>
                <button class="btn-sm" onclick="approve(<%= e.exception_id %>, 'reject')"><%= t('exceptions.index.btnReject') %></button>
              <% } else if (e.is_expired || (e.days_left !== null && e.days_left <= 30)) { %>
                <button class="btn-sm" onclick="extend(<%= e.exception_id %>)"><%= t('exceptions.index.btnExtend') %></button>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
var I18N = <%- JSON.stringify({
  approveNote: t('exceptions.index.js.approveNote'),
  rejectReason: t('exceptions.index.js.rejectReason'),
  rejectRequired: t('exceptions.index.js.rejectRequired'),
  newExpiry: t('exceptions.index.js.newExpiry'),
  fail: t('exceptions.index.js.fail'),
  error: t('exceptions.index.js.error')
}) %>;

function approve(id, action) {
  const note = prompt(action === 'approve' ? I18N.approveNote : I18N.rejectReason);
  if (action === 'reject' && !note) {
    alert(I18N.rejectRequired);
    return;
  }
  fetch('/exceptions/' + id + '/approve', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action, note }),
  })
    .then(r => r.json())
    .then(j => {
      if (j.status === 'success') location.reload();
      else alert(I18N.fail + (j.error || I18N.error));
    });
}

function extend(id) {
  const until = prompt(I18N.newExpiry);
  if (!until) return;
  fetch('/exceptions/' + id + '/extend', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ effective_until: until }),
  })
    .then(r => r.json())
    .then(j => {
      if (j.status === 'success') location.reload();
      else alert(I18N.fail + (j.error || I18N.error));
    });
}

// 필터링
function applyFilters() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const st = document.getElementById('statusFilter').value;
  const exp = document.getElementById('expiryFilter').value;
  document.querySelectorAll('#exceptionsTable tbody tr').forEach(tr => {
    const matchQ = !q || (tr.dataset.search || '').toLowerCase().includes(q);
    const matchS = !st || tr.dataset.status === st;
    const matchE = !exp || tr.dataset.expiry === exp;
    tr.style.display = (matchQ && matchS && matchE) ? '' : 'none';
  });
}
['searchInput', 'statusFilter', 'expiryFilter'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener(id === 'searchInput' ? 'input' : 'change', applyFilters);
});
</script>

<%- include('../_footer') %>
