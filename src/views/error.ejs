<%- include('_header', { title: t('error.title'), activeMenu: typeof activeMenu !== 'undefined' ? activeMenu : '' }) %>

<div class="page-header">
  <h1>⚠ <%= t('error.title') %></h1>
</div>

<div class="alert alert-warning">
  <strong><%= typeof message !== 'undefined' ? message : t('error.defaultMessage') %></strong>
  <% if (typeof detail !== 'undefined' && detail) { %>
    <div class="small" style="margin-top: 8px;"><%= detail %></div>
  <% } %>
</div>

<div class="form-actions">
  <a href="/" class="btn primary"><%= t('error.toDashboard') %></a>
  <a href="javascript:history.back()" class="btn"><%= t('error.prevPage') %></a>
</div>

<%- include('_footer') %>
