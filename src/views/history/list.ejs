<%- include('../_header', { title: t('history.listTitle') }) %>

<h1><%= t('history.listTitle') %></h1>

<form method="get" class="form-inline">
  <label><%= t('history.selectServer') %></label>
  <select name="server_id" onchange="this.form.submit()">
    <option value=""><%= t('history.selectPh') %></option>
    <% servers.forEach(s => { %>
      <option value="<%= s.server_id %>"
        <%= selectedServer && selectedServer.server_id === s.server_id ? 'selected' : '' %>>
        <%= s.name %> (<%= s.hostname %>)
      </option>
    <% }); %>
  </select>
</form>

<% if (selectedServer) { %>
  <h3><%= t('history.serverHistory', { name: selectedServer.name, n: assessments.length }) %></h3>
  <form method="get" action="/history/compare" id="compareForm">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t('history.col.select') %></th>
          <th><%= t('history.col.assessId') %></th>
          <th><%= t('history.col.executedAt') %></th>
          <th><%= t('history.col.executedBy') %></th>
          <th><%= t('history.col.ruleset') %></th>
          <th><%= t('history.col.total') %></th><th><%= t('history.col.vuln') %></th><th><%= t('history.col.safe') %></th><th>N/A</th>
          <th><%= t('history.col.elapsedMs') %></th>
          <th><%= t('history.col.action') %></th>
        </tr>
      </thead>
      <tbody>
        <% assessments.forEach(a => { %>
          <tr>
            <td><input type="checkbox" name="ids" value="<%= a.assessment_id %>"></td>
            <td>#<%= a.assessment_id %></td>
            <td><%= a.executed_at %></td>
            <td><%= a.executed_by || '-' %></td>
            <td><%= a.ruleset_ver %></td>
            <td><%= a.total_count %></td>
            <td class="vuln-cell"><%= a.vuln_count %></td>
            <td><%= a.safe_count %></td>
            <td><%= a.na_count %></td>
            <td><%= fmtMs(a.elapsed_ms) %></td>
            <td><a href="/diagnosis/<%= a.assessment_id %>/ai" class="btn-sm primary" style="background:#6c5ce7;"><%= t('common.btn.aiResult') %></a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <button type="button" class="btn primary" onclick="doCompare()"><%= t('history.compareBtn') %></button>
  </form>

  <script>
    function doCompare() {
      const boxes = document.querySelectorAll('input[name="ids"]:checked');
      if (boxes.length !== 2) { alert(<%- JSON.stringify(t('history.selectTwo')) %>); return; }
      const [a, b] = [boxes[0].value, boxes[1].value];
      location.href = `/history/compare?a=${a}&b=${b}`;
    }
  </script>
<% } %>

<%- include('../_footer') %>
