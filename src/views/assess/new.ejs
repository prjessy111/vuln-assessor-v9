<%- include('../_header', { title: t('common.btn.runAssess') }) %>

<h1><%= t('common.btn.runAssess') %></h1>
<p class="muted"><%= t('assess.intro') %></p>

<form method="post" action="/assess/run" enctype="multipart/form-data" class="form-block">

  <div class="form-row">
    <label><%= t('assess.targetServer') %> <span class="req">*</span></label>
    <select name="server_id" required>
      <% servers.forEach(s => { %>
        <option value="<%= s.server_id %>"
          <%= String(selectedId) === String(s.server_id) ? 'selected' : '' %>>
          <%= s.name %> (<%= s.hostname %> / <%= s.os_type %>)
        </option>
      <% }); %>
    </select>
  </div>

  <h3><%= t('assess.methodA') %></h3>
  <% if (rawFiles.length) { %>
    <div class="form-row">
      <table class="data-table">
        <thead><tr><th><%= t('assess.th.select') %></th><th><%= t('assess.th.fileName') %></th><th><%= t('assess.th.size') %></th><th><%= t('assess.th.collectedAt') %></th></tr></thead>
        <tbody>
          <% rawFiles.forEach(f => { %>
            <tr>
              <td><input type="radio" name="raw_file_path" value="<%= f.path %>"
                  <%= prefillRaw === f.path ? 'checked' : '' %>></td>
              <td><code><%= f.name %></code></td>
              <td class="small"><%= Math.round(f.size/1024) %> KB</td>
              <td class="small"><%= f.mtime.toLocaleString('ko-KR') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="muted"><%- t('assess.noRawFiles') %></div>
  <% } %>

  <h3><%= t('assess.methodB') %></h3>
  <div class="form-row">
    <input type="file" name="raw_file" accept=".db,.sqlite,.sqlite3">
    <div class="muted small"><%= t('assess.uploadHint') %></div>
  </div>

  <h3><%= t('assess.options') %></h3>
  <div class="form-row">
    <label><%= t('assess.rulesetVer') %></label>
    <input name="ruleset_ver" value="v1.0">
  </div>
  <div class="form-row">
    <label><%= t('assess.executedBy') %></label>
    <input name="executed_by" placeholder="<%= t('assess.phExecutedBy') %>">
  </div>

  <div class="form-actions">
    <button type="submit" class="btn primary large"><%= t('common.btn.runAssess') %></button>
  </div>
</form>

<%- include('../_footer') %>
