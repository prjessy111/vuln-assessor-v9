<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'ko' %>">
<head>
  <meta charset="UTF-8">
  <title><%= typeof title !== 'undefined' ? title : t('common.appTitle') %></title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<header class="topbar">
  <a href="/" class="brand" style="text-decoration:none;">
    <svg class="adv-logo" viewBox="0 0 40 46" width="26" height="30" aria-hidden="true">
      <defs><linearGradient id="advShield" x1="0" y1="0" x2="40" y2="46" gradientUnits="userSpaceOnUse"><stop stop-color="#38BDF8"/><stop offset="1" stop-color="#3B82F6"/></linearGradient></defs>
      <path d="M20 2 37 9V22c0 11-8 19-17 22C11 41 3 33 3 22V9z" fill="url(#advShield)"/>
      <path d="M12.5 23l5 5 10-11.5" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="brand-name">ADV</span>
    <span class="brand-tag">AI Diagnosis Verify</span>
  </a>
  <%
    // 활성 메뉴 → 그룹 매핑 (부모 하이라이트용)
    var _g = { diagnosis:'diag', collection:'diag', schedules:'diag', agent:'diag',
               reports:'rpt', 'inspection-status':'rpt', 'security-grade':'rpt', 'cve-sync':'rpt',
               vuln:'vuln', remediation:'vuln', exceptions:'vuln', exclusions:'vuln',
               notifications:'ops', audit:'ops', users:'ops' };
    var _ag = _g[activeMenu] || activeMenu;
    var isAdmin = (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin');
  %>
  <nav class="main-nav">
    <a href="/" class="<%= activeMenu === 'dashboard' ? 'active' : '' %>"><%= t('common.nav.dashboard') %></a>

    <div class="nav-group <%= _ag === 'diag' ? 'active' : '' %>">
      <span class="nav-top"><%= t('common.nav.diagGroup') %> ▾</span>
      <div class="nav-drop">
        <a href="/diagnosis" class="<%= activeMenu === 'diagnosis' ? 'active' : '' %>"><%= t('common.nav.diagnosis') %></a>
        <a href="/collection" class="<%= activeMenu === 'collection' ? 'active' : '' %>"><%= t('common.nav.collection') %></a>
        <a href="/schedules" class="<%= activeMenu === 'schedules' ? 'active' : '' %>"><%= t('common.nav.schedules') %></a>
        <a href="/agent" class="<%= activeMenu === 'agent' ? 'active' : '' %>"><%= t('common.nav.agent') %></a>
      </div>
    </div>

    <div class="nav-group <%= _ag === 'rpt' ? 'active' : '' %>">
      <span class="nav-top"><%= t('common.nav.rptGroup') %> ▾</span>
      <div class="nav-drop">
        <a href="/reports" class="<%= activeMenu === 'reports' ? 'active' : '' %>"><%= t('common.nav.reports') %></a>
        <a href="/inspection-status" class="<%= activeMenu === 'inspection-status' ? 'active' : '' %>"><%= t('common.nav.inspectionStatus') %></a>
        <a href="/security-grade" class="<%= activeMenu === 'security-grade' ? 'active' : '' %>"><%= t('common.nav.securityGrade') %></a>
        <a href="/cve-sync" class="<%= activeMenu === 'cve-sync' ? 'active' : '' %>"><%= t('common.nav.cveSync') %></a>
      </div>
    </div>

    <div class="nav-group <%= _ag === 'vuln' ? 'active' : '' %>">
      <span class="nav-top"><%= t('common.nav.vulnGroup') %> ▾</span>
      <div class="nav-drop">
        <a href="/vulnerabilities" class="<%= activeMenu === 'vuln' ? 'active' : '' %>"><%= t('common.nav.vuln') %></a>
        <a href="/remediation" class="<%= activeMenu === 'remediation' ? 'active' : '' %>"><%= t('common.nav.remediation') %></a>
        <a href="/exceptions" class="<%= activeMenu === 'exceptions' ? 'active' : '' %>"><%= t('common.nav.exceptions') %></a>
        <a href="/exclusions" class="<%= activeMenu === 'exclusions' ? 'active' : '' %>"><%= t('common.nav.exclusions') %></a>
      </div>
    </div>

    <a href="/servers" class="<%= activeMenu === 'servers' ? 'active' : '' %>"><%= t('common.nav.servers') %></a>

    <div class="nav-group <%= _ag === 'ops' ? 'active' : '' %>">
      <span class="nav-top"><%= t('common.nav.opsGroup') %> ▾</span>
      <div class="nav-drop">
        <a href="/notifications" class="<%= activeMenu === 'notifications' ? 'active' : '' %>"><%= t('common.nav.notifications') %></a>
        <a href="/audit" class="<%= activeMenu === 'audit' ? 'active' : '' %>"><%= t('common.nav.audit') %></a>
        <% if (isAdmin) { %><a href="/users" class="<%= activeMenu === 'users' ? 'active' : '' %>"><%= t('common.nav.users') %></a><% } %>
      </div>
    </div>
  </nav>
  <div class="user-area">
    <span class="lang-switch"><% (typeof langs !== 'undefined' ? langs : ['ko']).forEach(function (l) { %><a href="?lang=<%= l %>" class="lang-opt <%= lang === l ? 'active' : '' %>"><%= langLabels[l] %></a><% }); %></span>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a href="/users/me/password" class="user-name" title="<%= t('common.nav.changePassword') %>" style="text-decoration:none;color:inherit;">
        <%= currentUser.name %>
        <% if (currentUser.role === 'admin') { %><span class="role-mini">👑</span>
        <% } else if (currentUser.role === 'operator') { %><span class="role-mini">🔧</span>
        <% } else { %><span class="role-mini">👁</span><% } %>
      </a>
      <a href="/logout" class="btn-sm"><%= t('common.nav.logout') %></a>
    <% } %>
  </div>
</header>
<main class="container">
