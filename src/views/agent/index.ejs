<%- include('../_header', { title: t('agent.title'), activeMenu: 'agent' }) %>

<style>
  .agent-flow { display:flex; gap:6px; flex-wrap:wrap; margin:8px 0 18px; font-size:12px; color:#667; }
  .agent-flow span { background:#f1f3f7; border-radius:4px; padding:3px 8px; }
  .agent-flow .gate { background:#fff3cd; color:#8a6d00; font-weight:600; }
  .st-badge { display:inline-block; padding:2px 9px; border-radius:11px; font-size:12px; font-weight:600; }
  .st-draft{background:#eef;color:#446;} .st-script_generated{background:#fff3cd;color:#8a6d00;}
  .st-approved{background:#d9ecff;color:#1456a8;} .st-rejected{background:#fde2e2;color:#a33;}
  .st-collected{background:#e7f4ea;color:#256b3a;} .st-judged{background:#e7f4ea;color:#1c6b2e;}
  .st-needs_review{background:#ffe0b8;color:#9a4d00;} .st-confirmed{background:#d7f5dd;color:#0f7a2e;}
  .risk-safe{color:#1c7a3a;font-weight:600;} .risk-warning{color:#b07400;font-weight:600;} .risk-blocked{color:#b00;font-weight:700;}
  .agent-card { border:1px solid #e3e6ee; border-radius:8px; padding:14px 16px; margin-bottom:12px; background:#fff; }
  .agent-card.gate { border-left:4px solid #f0ad4e; }
  .agent-card.review { border-left:4px solid #e8821a; }
  .agent-card h4 { margin:0 0 4px; }
  .agent-meta { font-size:12px; color:#778; margin-bottom:8px; }
  .agent-code { background:#1e1e2e; color:#d4d4e8; padding:10px; border-radius:6px; font-family:ui-monospace,Consolas,monospace; font-size:12px; white-space:pre-wrap; max-height:240px; overflow:auto; }
  .agent-actions { margin-top:10px; display:flex; gap:8px; flex-wrap:wrap; align-items:flex-start; }
  .agent-actions form { display:inline-flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .agent-banner { padding:9px 14px; border-radius:6px; margin-bottom:14px; }
  .agent-banner.ok { background:#e7f4ea; color:#1c6b2e; }
  .agent-banner.err { background:#fde2e2; color:#a33; }
  .safety-hit { font-size:11px; color:#a33; margin:2px 0; }
  .verdict-양호{color:#1c7a3a;font-weight:700;} .verdict-취약{color:#c0392b;font-weight:700;} .verdict-점검불가{color:#888;font-weight:600;}
  textarea.agent-ta { width:100%; min-height:90px; font-family:ui-monospace,monospace; font-size:12px; }
  details.gen summary { cursor:pointer; color:#446; font-size:12px; }
</style>

<div class="page-header">
  <h1><%= t('agent.title') %></h1>
  <p class="muted"><%- t('agent.intro') %></p>
</div>

<div class="agent-flow">
  <span><%= t('agent.flow.s1') %></span>→
  <span><%= t('agent.flow.s2') %></span>→
  <span class="gate"><%= t('agent.flow.g1') %></span>→
  <span><%= t('agent.flow.s3') %></span>→
  <span><%= t('agent.flow.s4') %></span>→
  <span class="gate"><%= t('agent.flow.g2') %></span>→
  <span><%= t('agent.flow.s5') %></span>
</div>

<% if (msg) { %><div class="agent-banner ok"><%= msg %></div><% } %>
<% if (err) { %><div class="agent-banner err">⚠ <%= err %></div><% } %>

<div class="agent-banner" style="background:#eef3fb; color:#33506e;">
  <%- t('agent.banner.llm', { state: externalAllowed ? t('agent.banner.extAllowed') : t('agent.banner.extBlocked') }) %>
</div>

<% if (!backendConfigured.lsap) { %>
  <div class="agent-banner err"><%- t('agent.banner.noLsap') %></div>
<% } %>

<!-- KPI -->
<div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:18px;">
  <div class="kpi-card"><div class="kpi-label"><%= t('agent.kpi.total') %></div><div class="kpi-num"><%= summary.total %></div></div>
  <div class="kpi-card kpi-warning"><div class="kpi-label"><%= t('agent.kpi.pendingApproval') %></div><div class="kpi-num"><%= summary.pending_approval %></div></div>
  <div class="kpi-card kpi-fail"><div class="kpi-label"><%= t('agent.kpi.needsReview') %></div><div class="kpi-num"><%= summary.needs_review %></div></div>
  <div class="kpi-card kpi-success"><div class="kpi-label"><%= t('agent.kpi.confirmed') %></div><div class="kpi-num"><%= summary.confirmed %></div></div>
</div>

<!-- 3-1: 신규 항목 편입 -->
<div class="section-box">
  <h3><%= t('agent.newItem.title') %></h3>
  <p class="muted small"><%= t('agent.newItem.desc') %></p>
  <form method="post" action="/agent/items">
    <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:8px; margin-bottom:8px;">
      <input type="text" name="title" placeholder="<%= t('agent.newItem.phTitle') %>">
      <select name="os_target">
        <option value="linux">Linux</option>
        <option value="windows">Windows</option>
        <option value="all"><%= t('agent.newItem.osAll') %></option>
      </select>
      <select name="severity">
        <option value="상"><%= t('agent.newItem.sevHigh') %></option>
        <option value="중" selected><%= t('agent.newItem.sevMid') %></option>
        <option value="하"><%= t('agent.newItem.sevLow') %></option>
      </select>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr 2fr; gap:8px; margin-bottom:8px;">
      <select name="source">
        <option value="custom"><%= t('agent.newItem.srcCustom') %></option>
        <option value="cve"><%= t('agent.newItem.srcCve') %></option>
        <option value="guide"><%= t('agent.newItem.srcGuide') %></option>
      </select>
      <input type="text" name="source_ref" placeholder="<%= t('agent.newItem.phSourceRef') %>">
      <input type="text" name="category" placeholder="<%= t('agent.newItem.phCategory') %>">
    </div>
    <textarea class="agent-ta" name="description" placeholder="<%= t('agent.newItem.phDescription') %>" required></textarea>
    <div style="margin-top:8px;"><button type="submit" class="btn primary"><%= t('agent.newItem.btnSubmit') %></button></div>
  </form>
</div>

<!-- 항목 목록 -->
<div class="section-box">
  <h3><%= t('agent.list.title', { n: items.length }) %></h3>
  <% if (!items.length) { %>
    <p class="muted"><%= t('agent.list.empty') %></p>
  <% } %>

  <% items.forEach(function(it){ var tdv = function(v){ return v === '점검불가' ? t('agent.verdict.na') : td(v); }; %>
    <div class="agent-card <%= it.status==='script_generated' ? 'gate' : (it.status==='needs_review' ? 'review' : '') %>" id="<%= it.item_id %>">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px;">
        <div style="flex:1;">
          <h4><%= it.title %> <span class="st-badge st-<%= it.status %>"><%= it.status %></span></h4>
          <div class="agent-meta">
            <span class="mono"><%= it.item_id %></span> ·
            <%= it.os_target %> · <%= t('agent.card.metaSeverity') %> <%= td(it.severity) %> · <%= t('agent.card.metaSource') %> <%= it.source %><%= it.source_ref ? ' ('+it.source_ref+')' : '' %> ·
            <%= it.category %> · <%= t('agent.card.metaCreated') %> <%= it.created_by %> <%= it.created_at %>
          </div>
          <div style="font-size:13px; color:#445; white-space:pre-wrap; margin-bottom:6px;"><%= it.description %></div>
        </div>
        <form method="post" action="/agent/items/<%= it.item_id %>/delete" onsubmit="return confirm('<%= t('agent.card.confirmDelete') %>');">
          <button class="btn-sm" type="submit"><%= t('common.btn.delete') %></button>
        </form>
      </div>

      <!-- 스크립트 영역 -->
      <% if (it.script) { %>
        <div style="margin-top:8px;">
          <div class="agent-meta">
            <%= t('agent.card.scriptLabel') %> (<%= it.script.lang %>) · <%= t('agent.card.genLabel') %> <%= it.script.generated_by %><%= it.script.model ? ' / '+it.script.model : '' %> ·
            <%= t('agent.card.safetyLabel') %> <span class="risk-<%= it.script.safety.risk %>"><%= it.script.safety.risk %></span>
          </div>
          <% if (it.script.explanation) { %><div class="muted small" style="margin-bottom:4px;"><%= it.script.explanation %></div><% } %>
          <div class="agent-code"><%= it.script.code %></div>
          <% if (it.script.safety.hits && it.script.safety.hits.length) { %>
            <div style="margin-top:6px;">
              <% it.script.safety.hits.forEach(function(h){ %>
                <div class="safety-hit">[<%= h.level %>] L<%= h.line %>: <%= h.why %> — <code><%= h.snippet %></code></div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- 판정 영역 -->
      <% if (it.judgment) { %>
        <div style="margin-top:8px; padding:8px 10px; background:#f7f8fb; border-radius:6px;">
          <div class="agent-meta"><%= t('agent.card.judgmentLabel') %> · <%= it.judgment.backend %><%= it.judgment.model ? ' / '+it.judgment.model : '' %> · <%= it.judgment.judged_at %></div>
          <div><%= t('agent.card.verdictLabel') %> <span class="verdict-<%= it.judgment.verdict %>"><%= tdv(it.judgment.verdict) %></span>
            · <%= t('agent.card.confidenceLabel') %> <%= (it.judgment.confidence ?? 0).toFixed(2) %>
            <% if (it.judgment.needs_review) { %><span class="st-badge st-needs_review"><%= t('agent.card.needsReviewLabel', { reason: it.judgment.review_reason }) %></span><% } %>
          </div>
          <div class="small" style="margin-top:4px;"><strong><%= t('agent.card.reasonLabel') %></strong> <%= it.judgment.reason %></div>
          <% if (it.judgment.evidence) { %><div class="small"><strong><%= t('agent.card.evidenceLabel') %></strong> <span class="mono"><%= it.judgment.evidence %></span></div><% } %>
          <% if (it.judgment.recommend) { %><div class="small"><strong><%= t('agent.card.recommendLabel') %></strong> <%= it.judgment.recommend %></div><% } %>
        </div>
      <% } %>

      <!-- 교차검증 + 3소스 합의 (§4-4 하이브리드) -->
      <% if (it.agreement) { %>
        <div style="margin-top:8px; padding:8px 10px; background:#eef3fb; border-radius:6px;">
          <div class="agent-meta"><%= t('agent.card.agreementLabel') %>
            <strong style="color:<%= it.agreement.status==='agree' ? '#1c7a3a' : (it.agreement.status==='mismatch' ? '#c0392b' : '#888') %>"><%= it.agreement.status %></strong>
            <%= t('agent.card.decisive', { n: it.agreement.decisive_count }) %>
          </div>
          <div class="small">
            <%= t('agent.card.srcPrimary', { backend: it.judgment ? it.judgment.backend : '-' }) %> <span class="verdict-<%= it.agreement.sources.primary %>"><%= it.agreement.sources.primary ? tdv(it.agreement.sources.primary) : '—' %></span> ·
            <%= t('agent.card.srcCross', { backend: it.cross ? it.cross.backend : '-' }) %> <span class="verdict-<%= it.agreement.sources.cross %>"><%= it.agreement.sources.cross ? tdv(it.agreement.sources.cross) : '—' %></span> ·
            <%= t('agent.card.srcSecums') %> <span class="verdict-<%= it.agreement.sources.secums %>"><%= it.agreement.sources.secums ? tdv(it.agreement.sources.secums) : '—' %></span>
          </div>
          <% if (it.cross && it.cross.reason) { %><div class="small" style="margin-top:3px;"><strong><%= t('agent.card.crossReasonLabel') %></strong> <%= it.cross.reason %></div><% } %>
        </div>
      <% } %>

      <!-- 확정 영역 -->
      <% if (it.review) { %>
        <div class="small" style="margin-top:6px; color:#0f7a2e;"><%= t('agent.card.reviewLabel') %> <span class="verdict-<%= it.review.verdict %>"><%= tdv(it.review.verdict) %></span> (<%= it.review.decision %>) by <%= it.review.by %> <%= it.review.at %><%= it.review.note ? ' — '+it.review.note : '' %>
          · <a href="/agent/items/<%= it.item_id %>/export-rule"><%= t('agent.card.exportRule') %></a>
        </div>
      <% } %>

      <!-- 상태별 액션 -->
      <div class="agent-actions">
        <% if (it.status === 'draft' || it.status === 'rejected') { %>
          <form method="post" action="/agent/items/<%= it.item_id %>/generate">
            <% if (backendConfigured.lsap || backendConfigured.claude) { %>
              <select name="backend">
                <% if (backendConfigured.lsap) { %><option value="lsap"><%= t('agent.actions.lsapInternal') %></option><% } %>
                <% if (backendConfigured.claude) { %><option value="claude">Claude</option><% } %>
              </select>
            <% } %>
            <button class="btn-sm primary" type="submit"><%= t('agent.actions.btnGenerate') %></button>
          </form>
        <% } %>

        <% if (it.status === 'script_generated') { %>
          <form method="post" action="/agent/items/<%= it.item_id %>/review-script">
            <input type="hidden" name="decision" value="approve">
            <input type="text" name="note" placeholder="<%= t('agent.actions.phApproveNote') %>">
            <button class="btn-sm primary" type="submit" <%= it.script && it.script.safety.risk==='blocked' ? 'disabled title="' + t('agent.actions.blockedNoApprove') + '"' : '' %>><%= t('agent.actions.btnApprove') %></button>
          </form>
          <form method="post" action="/agent/items/<%= it.item_id %>/review-script">
            <input type="hidden" name="decision" value="reject">
            <button class="btn-sm" type="submit"><%= t('agent.actions.btnReject') %></button>
          </form>
          <form method="post" action="/agent/items/<%= it.item_id %>/generate">
            <button class="btn-sm" type="submit"><%= t('agent.actions.btnRegenerate') %></button>
          </form>
        <% } %>

        <% if (it.status === 'approved' || it.status === 'collected' || it.status === 'judged' || it.status === 'needs_review') { %>
          <details class="gen" style="width:100%;">
            <summary><%= t('agent.actions.runOnTargetTitle') %></summary>
            <form method="post" action="/agent/items/<%= it.item_id %>/run-on-target" style="display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-top:6px;"
                  onsubmit="return confirm('<%= t('agent.actions.confirmRun') %>');">
              <select name="server_id" required>
                <option value=""><%= t('agent.actions.selectServer') %></option>
                <% (servers||[]).filter(function(s){ var win=String(s.os_type||'').toLowerCase().includes('win'); return it.os_target==='all' || (it.os_target==='windows' ? win : !win); }).forEach(function(s){ %>
                  <option value="<%= s.server_id %>"><%= s.hostname %> (<%= s.ip_address %>, <%= s.os_type %>)</option>
                <% }); %>
              </select>
              <label class="small"><input type="checkbox" name="auto_judge" value="on" checked> <%= t('agent.actions.autoJudge') %></label>
              <button class="btn-sm primary" type="submit"><%= t('agent.actions.btnRunCollect') %></button>
            </form>
            <div class="muted small" style="margin-top:3px;"><%= t('agent.actions.credNote') %></div>
          </details>
          <details class="gen" style="width:100%;">
            <summary><%= t('agent.actions.ingestTitle') %></summary>
            <form method="post" action="/agent/items/<%= it.item_id %>/ingest" style="display:block; margin-top:6px;">
              <textarea class="agent-ta" name="output" placeholder="<%= t('agent.actions.phRawOutput') %>"><%= it.raw ? it.raw.output : '' %></textarea>
              <input type="hidden" name="source" value="manual">
              <button class="btn-sm primary" type="submit" style="margin-top:6px;"><%= t('agent.actions.btnIngest') %></button>
            </form>
          </details>
        <% } %>

        <% if (it.status === 'collected' || it.status === 'judged' || it.status === 'needs_review') { %>
          <form method="post" action="/agent/items/<%= it.item_id %>/judge">
            <input type="text" name="secums_verdict" placeholder="<%= t('agent.actions.phSecums') %>">
            <button class="btn-sm primary" type="submit"><%= t('agent.actions.btnJudge') %><%= it.judgment ? t('agent.actions.rerunSuffix') : '' %></button>
          </form>
        <% } %>

        <% if ((it.status === 'collected' || it.status === 'judged' || it.status === 'needs_review') && it.judgment) { %>
          <form method="post" action="/agent/items/<%= it.item_id %>/cross-verify">
            <button class="btn-sm" type="submit" <%= backendConfigured.lsap ? '' : 'disabled title="' + t('agent.actions.lsapMissing') + '"' %>><%= t('agent.actions.btnCrossVerify') %></button>
          </form>
          <% if (externalAllowed && backendConfigured.claude) { %>
            <form method="post" action="/agent/items/<%= it.item_id %>/cross-verify" onsubmit="return confirm('<%= t('agent.actions.confirmExternal') %>');">
              <input type="hidden" name="backend" value="claude">
              <button class="btn-sm" type="submit" title="<%= t('agent.actions.externalSend') %>"><%= t('agent.actions.btnCrossVerifyClaude') %></button>
            </form>
          <% } %>
        <% } %>

        <% if (it.judgment && (it.status === 'judged' || it.status === 'needs_review' || it.status === 'confirmed')) { %>
          <form method="post" action="/agent/items/<%= it.item_id %>/notify-hermes">
            <button class="btn-sm" type="submit" <%= hermesConfigured ? '' : 'disabled title="' + t('agent.actions.hermesMissing') + '"' %>><%= t('agent.actions.btnHermes') %></button>
          </form>
        <% } %>

        <% if (it.status === 'judged' || it.status === 'needs_review') { %>
          <form method="post" action="/agent/items/<%= it.item_id %>/confirm">
            <input type="hidden" name="decision" value="confirm">
            <button class="btn-sm primary" type="submit"><%= t('agent.actions.btnConfirm') %></button>
          </form>
          <form method="post" action="/agent/items/<%= it.item_id %>/confirm">
            <input type="hidden" name="decision" value="override">
            <select name="verdict">
              <option value="양호"><%= td('양호') %></option>
              <option value="취약"><%= td('취약') %></option>
              <option value="점검불가"><%= t('agent.verdict.na') %></option>
            </select>
            <button class="btn-sm" type="submit"><%= t('agent.actions.btnOverride') %></button>
          </form>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../_footer') %>
