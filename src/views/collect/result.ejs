<%- include('../_header', { title: t('collect.result.title') }) %>

<h1><%= t('collect.result.heading') %></h1>

<%
  const okCount = results.filter(r => r.ok).length;
  const failCount = results.length - okCount;
%>
<div class="summary-cards">
  <div class="summary-card total"><div><%= t('collect.result.total') %></div><div class="num"><%= results.length %></div></div>
  <div class="summary-card safe"><div><%= t('collect.result.success') %></div><div class="num"><%= okCount %></div></div>
  <div class="summary-card vuln"><div><%= t('collect.result.fail') %></div><div class="num"><%= failCount %></div></div>
</div>

<table class="data-table">
  <thead>
    <tr>
      <th><%= t('collect.idx.thServer') %></th><th><%= t('collect.idx.thHost') %></th><th><%= t('collect.result.thResult') %></th><th><%= t('collect.result.thFileReason') %></th><th><%= t('collect.idx.thSize') %></th><th><%= t('collect.result.thAction') %></th>
    </tr>
  </thead>
  <tbody>
    <% results.forEach(r => { %>
      <tr class="status-<%= r.ok ? 'safe' : 'vuln' %>">
        <td>#<%= r.server_id %></td>
        <td><code><%= r.hostname %></code></td>
        <td>
          <% if (r.ok) { %><span class="badge b-safe"><%= t('collect.result.success') %></span>
          <% } else { %><span class="badge b-vuln"><%= t('collect.result.fail') %></span><% } %>
        </td>
        <td class="small">
          <% if (r.ok) { %>
            <code><%= r.raw_file_path %></code><br>
            <span class="muted">SHA-256: <%= r.raw_file_hash.slice(0,32) %>...</span>
          <% } else { %>
            <span style="color:#c0392b"><%= r.error %></span>
          <% } %>
        </td>
        <td class="small"><%= r.file_size ? Math.round(r.file_size/1024)+' KB' : '-' %></td>
        <td>
          <% if (r.ok) { %>
            <a href="/assess/new?server_id=<%= r.server_id %>&prefill_raw=<%= encodeURIComponent(r.raw_file_path) %>" class="btn-sm primary"><%= t('common.btn.runAssess') %></a>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<div class="form-actions" style="margin-top:20px;">
  <a href="/collect" class="btn"><%= t('collect.hist.backToCollect') %></a>
  <a href="/collect/history" class="btn"><%= t('collect.hist.viewAll') %></a>
</div>

<%- include('../_footer') %>
