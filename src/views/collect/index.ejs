<%- include('../_header', { title: t('collect.idx.title') }) %>

<h1><%= t('collect.idx.heading') %></h1>
<p class="muted"><%= t('collect.idx.desc') %></p>

<% if (!servers.length) { %>
  <div class="empty"><%= t('collect.idx.noServers1') %> <a href="/servers"><%= t('common.nav.servers') %></a><%= t('collect.idx.noServers2') %></div>
<% } else { %>
<form method="post" action="/collect/run" class="form-block">
  <table class="data-table">
    <thead>
      <tr>
        <th><input type="checkbox" id="check_all" onchange="toggleAll(this)"></th>
        <th><%= t('collect.idx.thName') %></th><th><%= t('collect.idx.thHost') %></th><th>OS</th><th><%= t('collect.idx.thSshUser') %></th>
        <th><%= t('collect.idx.thRawPath') %></th><th><%= t('collect.idx.thLastCollected') %></th>
      </tr>
    </thead>
    <tbody>
      <% servers.forEach(s => { %>
        <tr>
          <td><input type="checkbox" name="server_ids" value="<%= s.server_id %>" class="row_check"></td>
          <td><%= s.name %></td>
          <td><code><%= s.hostname %>:<%= s.ssh_port||22 %></code></td>
          <td><span class="os-badge"><%= s.os_type.toUpperCase() %></span></td>
          <td><%= s.ssh_user %> <span class="muted small">(<%= s.ssh_auth_type %>)</span></td>
          <td><code class="small"><%= s.remote_raw_path %></code></td>
          <td class="small"><%= s.last_collected_at || '-' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="form-row">
    <label><%= t('collect.idx.executor') %></label>
    <input name="executed_by" placeholder="<%= t('collect.idx.executorPh') %>">
  </div>

  <div class="form-actions">
    <button type="submit" class="btn primary large"><%= t('collect.idx.startCollect') %></button>
    <a href="/collect/history" class="btn"><%= t('collect.idx.viewHistory') %></a>
  </div>
</form>

<script>
function toggleAll(box) {
  document.querySelectorAll('.row_check').forEach(c => c.checked = box.checked);
}
</script>
<% } %>

<h2><%= t('collect.idx.recentHeading') %></h2>
<table class="data-table">
  <thead>
    <tr><th><%= t('collect.idx.thStart') %></th><th><%= t('collect.idx.thServer') %></th><th><%= t('collect.idx.thStatus') %></th><th><%= t('collect.idx.thFile') %></th><th><%= t('collect.idx.thSize') %></th><th><%= t('collect.idx.executor') %></th></tr>
  </thead>
  <tbody>
    <% recent.forEach(c => { %>
      <tr class="status-<%= c.status==='성공'?'safe':c.status==='실패'?'vuln':'' %>">
        <td class="small"><%= c.started_at %></td>
        <td><%= c.server_name %> <span class="muted small">(<%= c.hostname %>)</span></td>
        <td><span class="badge b-<%= c.status==='성공'?'safe':c.status==='실패'?'vuln':'na' %>"><%= td(c.status) %></span></td>
        <td class="small"><code><%= c.raw_file_path || '-' %></code></td>
        <td class="small"><%= c.file_size ? Math.round(c.file_size/1024)+' KB' : '-' %></td>
        <td class="small"><%= c.triggered_by || '-' %></td>
      </tr>
    <% }); %>
    <% if (!recent.length) { %>
      <tr><td colspan="6" class="empty"><%= t('collect.idx.empty') %></td></tr>
    <% } %>
  </tbody>
</table>

<%- include('../_footer') %>
