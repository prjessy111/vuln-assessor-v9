<%- include('../_header', { title: t('collect.hist.title') }) %>

<h1><%= t('collect.hist.heading') %></h1>

<% if (selectedServer) { %>
  <h3><%= t('collect.hist.serverHistory', { name: selectedServer.name, host: selectedServer.hostname }) %></h3>
  <a href="/collect/history" class="btn-sm"><%= t('collect.hist.viewAll') %></a>
<% } %>

<table class="data-table">
  <thead>
    <tr>
      <th><%= t('collect.hist.thStart') %></th><th><%= t('collect.hist.thEnd') %></th><th><%= t('collect.idx.thServer') %></th><th><%= t('collect.idx.thStatus') %></th>
      <th><%= t('collect.hist.thPathReason') %></th><th><%= t('collect.idx.thSize') %></th><th><%= t('collect.hist.thHash') %></th><th><%= t('collect.idx.executor') %></th>
    </tr>
  </thead>
  <tbody>
    <% recent.forEach(c => { %>
      <tr class="status-<%= c.status==='성공'?'safe':c.status==='실패'?'vuln':'' %>">
        <td class="small"><%= c.started_at %></td>
        <td class="small"><%= c.finished_at || '-' %></td>
        <td>
          <% if (c.server_name) { %>
            <%= c.server_name %> <span class="muted small">(<%= c.hostname %>)</span>
          <% } else { %>
            <%= selectedServer ? selectedServer.name : `#${c.server_id}` %>
          <% } %>
        </td>
        <td><span class="badge b-<%= c.status==='성공'?'safe':c.status==='실패'?'vuln':'na' %>"><%= td(c.status) %></span></td>
        <td class="small">
          <% if (c.status==='성공') { %>
            <code><%= c.raw_file_path %></code>
          <% } else if (c.error_message) { %>
            <span style="color:#c0392b"><%= c.error_message %></span>
          <% } %>
        </td>
        <td class="small"><%= c.file_size ? Math.round(c.file_size/1024)+' KB' : '-' %></td>
        <td class="small"><code><%= c.raw_file_hash ? c.raw_file_hash.slice(0,12)+'...' : '-' %></code></td>
        <td class="small"><%= c.triggered_by || '-' %></td>
      </tr>
    <% }); %>
    <% if (!recent.length) { %>
      <tr><td colspan="8" class="empty"><%= t('collect.idx.empty') %></td></tr>
    <% } %>
  </tbody>
</table>

<a href="/collect" class="btn"><%= t('collect.hist.backToCollect') %></a>

<%- include('../_footer') %>
